 #include <input.hpp>
 
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <vector>
+
 CREATE_SERVICE(PCS_CONTROLS)
 
 using namespace storm;
 
+namespace
+{
+constexpr unsigned int controlTraceLimit = 512;
+
+bool controlTraceEnabled()
+{
+    static const bool enabled = [] {
+        const char *value = std::getenv("STORM_CONTROL_TRACE");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+int controlTraceSDLScancode(uint32_t systemCode)
+{
+    if (systemCode >= 'A' && systemCode <= 'Z')
+        return SDL_SCANCODE_A + static_cast<int>(systemCode - 'A');
+    return -1;
+}
+
+void traceControlTransition(int32_t controlCode, const USER_CONTROL &control, const CONTROL_STATE &state)
+{
+    if (!controlTraceEnabled())
+        return;
+
+    static std::vector<int32_t> previousStates;
+    static unsigned int emitted = 0;
+    if (controlCode < 0 || emitted >= controlTraceLimit)
+        return;
+    if (previousStates.size() <= static_cast<size_t>(controlCode))
+        previousStates.resize(static_cast<size_t>(controlCode) + 1, std::numeric_limits<int32_t>::min());
+    if (previousStates[controlCode] == state.state)
+        return;
+    previousStates[controlCode] = state.state;
+    if (state.state == CST_INACTIVE)
+        return;
+
+    ++emitted;
+    std::fprintf(stderr, "CONTROL_TRACE action=%s system_code=%u sdl_scancode=%d state=%d value=%d frame_transition=%u\n",
+                 control.name != nullptr ? control.name : "", control.system_code,
+                 controlTraceSDLScancode(control.system_code), state.state, state.lValue, emitted);
+}
+} // namespace
+
 PCS_CONTROLS::PCS_CONTROLS()
 {
     m_bLockAll = false;
@@ -431,6 +481,7 @@ bool PCS_CONTROLS::GetControlState(int32_t control_code, CONTROL_STATE &_state_s
     if (_state_struct.state != CST_INACTIVE)
         if (!(system_code == CE_MOUSE_X_AXIS || system_code == CE_MOUSE_Y_AXIS))
             nLastControlTime = 0;
+    traceControlTransition(control_code, pUserControls[control_code], _state_struct);
     return true;
 }
 
