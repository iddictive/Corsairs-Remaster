+bool DECK_CAMERA::CanWalkTo(const CVECTOR &from, const CVECTOR &to)
+{
+    const CVECTOR delta = to - from;
+    if (delta.x * delta.x + delta.z * delta.z < 0.0000001f)
+        return true;
+    const float floor = std::max(from.y, to.y);
+    const CVECTOR bottom = pathNode->glob_mtx * CVECTOR(from.x, floor + .32f, from.z);
+    const CVECTOR top = pathNode->glob_mtx * CVECTOR(from.x, floor + 1.42f, from.z);
+    const CVECTOR shift = pathNode->glob_mtx * CVECTOR(to.x, floor, to.z)
+                        - pathNode->glob_mtx * CVECTOR(from.x, floor, from.z);
+    deck_collision::Sweep sweep{bottom, top, shift, .28f};
+    deckSweep = &sweep;
+    const CVECTOR center = (bottom + top + shift) * .5f;
+    const float radius = .28f + .5f * (sqrtf(~(top - bottom)) + sqrtf(~shift));
+    pModel->Clip(nullptr, 0, center, radius, DeckCollisionPolygon);
+    deckSweep = nullptr;
+    return !sweep.blocked;
 }
 
