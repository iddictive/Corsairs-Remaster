+void WdmObjects::DrawDynamicPrimitive(D3DPRIMITIVETYPE primitiveType, uint32_t fvf, uint32_t primitiveCount,
+                                      const void *vertices, uint32_t stride, const char *technique)
+{
+    const uint32_t vertexCount = primitiveType == D3DPT_TRIANGLELIST ? primitiveCount * 3 :
+                                 primitiveType == D3DPT_LINELIST ? primitiveCount * 2 : primitiveCount + 2;
+    const size_t bytes = size_t(vertexCount) * stride;
+    auto buffer = std::find_if(dynamicVertexBuffers.begin(), dynamicVertexBuffers.end(),
+                               [fvf, stride](const DynamicVertexBuffer &item) {
+                                   return item.fvf == fvf && item.stride == stride;
+                               });
+    if (buffer == dynamicVertexBuffers.end())
+    {
+        dynamicVertexBuffers.push_back({fvf, stride, 0, -1});
+        buffer = dynamicVertexBuffers.end() - 1;
+    }
+    if (buffer->capacity < bytes)
+    {
+        if (buffer->id >= 0)
+            rs->ReleaseVertexBuffer(buffer->id);
+        buffer->id = rs->CreateVertexBuffer(fvf, bytes, D3DUSAGE_WRITEONLY | D3DUSAGE_DYNAMIC);
+        buffer->capacity = buffer->id >= 0 ? bytes : 0;
+    }
+    if (buffer->id < 0)
+        return;
+    auto *destination = rs->LockVertexBuffer(buffer->id, D3DLOCK_DISCARD);
+    if (!destination)
+        return;
+    std::memcpy(destination, vertices, bytes);
+    rs->UnLockVertexBuffer(buffer->id);
+    rs->DrawPrimitive(primitiveType, buffer->id, stride, 0, primitiveCount, technique);
+}
