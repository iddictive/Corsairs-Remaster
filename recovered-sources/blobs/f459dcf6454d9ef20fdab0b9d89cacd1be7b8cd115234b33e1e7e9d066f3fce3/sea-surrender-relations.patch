+void AIHelper::UpdateSurrenderCache() const
+{
+    if (dwRelationSize == 0)
+        return;
+    aSurrenderCaptor.resize(dwRelationSize);
+    aCommanderIndex.resize(dwRelationSize);
+    bAnySurrendered = false;
+    for (uint32_t i = 0; i < dwRelationSize; ++i)
+    {
+        aCommanderIndex[i] = aMainCharacters[i] ? static_cast<uint32_t>(GetIndex(aMainCharacters[i])) : INVALID_ARRAY_INDEX;
+        aSurrenderCaptor[i] = aCharacters[i] ? aCharacters[i]->GetAttributeAsDword("SeaSurrender", INVALID_ARRAY_INDEX) : INVALID_ARRAY_INDEX;
+        if (aSurrenderCaptor[i] != INVALID_ARRAY_INDEX)
+            bAnySurrendered = true;
+    }
+}
+
+// SeaSurrender is the captor commander's character index. Apply it per ship,
+// not to the commander's cached fleet relation: wingmen can surrender separately.
+uint32_t AIHelper::GetEffectiveRelation(uint32_t x, uint32_t y) const
+{
+    if (x != y)
+    {
+        static auto s_lastTick = std::chrono::steady_clock::time_point{};
+        const auto now = std::chrono::steady_clock::now();
+        if (aSurrenderCaptor.size() != dwRelationSize ||
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - s_lastTick).count() >= 16)
+        {
+            UpdateSurrenderCache();
+            s_lastTick = now;
+        }
+        if (bAnySurrendered)
+        {
+            const auto surrenderedTo = [this](uint32_t shipIdx, uint32_t cmdrIdx) {
+                return aSurrenderCaptor[shipIdx] != INVALID_ARRAY_INDEX &&
+                       aSurrenderCaptor[shipIdx] == aCommanderIndex[cmdrIdx];
+            };
+            if (surrenderedTo(x, y) || surrenderedTo(y, x))
+                return RELATION_NEUTRAL;
+        }
+    }
+    return *GetRelation(x, y);
+}
