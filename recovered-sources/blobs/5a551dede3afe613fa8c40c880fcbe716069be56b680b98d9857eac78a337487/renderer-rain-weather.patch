diff --git a/src/libs/weather/src/weather_sprite_buffer.h b/src/libs/weather/src/weather_sprite_buffer.h
new file mode 100644
index 0000000..9b0bbd2
--- /dev/null
+++ b/src/libs/weather/src/weather_sprite_buffer.h
@@ -0,0 +1,101 @@
+#pragma once
+
+#include "dx9render.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+// Weather-owned replacement for DX9RENDER::DrawRects.  The weather consumers
+// submit an explicit dynamic vertex buffer, so the renderer backend never has
+// to expand RS_RECT immediate geometry or route it through Draw*UP.
+class WeatherSpriteBuffer
+{
+    struct Vertex
+    {
+        CVECTOR pos;
+        uint32_t color;
+        float u, v;
+    };
+
+    static constexpr uint32_t kCapacity = 512;
+    static constexpr uint32_t kFvf = D3DFVF_XYZ | D3DFVF_DIFFUSE | D3DFVF_TEX1;
+    int32_t vertexBuffer_ = -1;
+
+  public:
+    bool Ensure(VDX9RENDER &renderer)
+    {
+        if (vertexBuffer_ >= 0)
+            return true;
+        vertexBuffer_ = renderer.CreateVertexBuffer(kFvf, kCapacity * 6 * sizeof(Vertex),
+                                                     D3DUSAGE_DYNAMIC | D3DUSAGE_WRITEONLY);
+        return vertexBuffer_ >= 0;
+    }
+
+    void Release(VDX9RENDER &renderer)
+    {
+        if (vertexBuffer_ >= 0)
+            renderer.ReleaseVertexBuffer(vertexBuffer_);
+        vertexBuffer_ = -1;
+    }
+
+    void Draw(VDX9RENDER &renderer, const RS_RECT *rects, uint32_t count, const char *technique,
+              uint32_t subTexturesX = 1, uint32_t subTexturesY = 1, float scaleX = 1.f, float scaleY = 1.f)
+    {
+        if (!rects || count == 0 || !Ensure(renderer))
+            return;
+
+        CMatrix view, oldWorld, identity;
+        renderer.GetTransform(D3DTS_VIEW, view);
+        renderer.GetTransform(D3DTS_WORLD, oldWorld);
+        identity.SetIdentity();
+        scaleY *= renderer.GetHeightDeformator();
+        renderer.SetTransform(D3DTS_VIEW, identity);
+        renderer.SetTransform(D3DTS_WORLD, identity);
+
+        const uint32_t sx = std::max(1u, subTexturesX);
+        const uint32_t sy = std::max(1u, subTexturesY);
+        const float du = 1.f / static_cast<float>(sx);
+        const float dv = 1.f / static_cast<float>(sy);
+        for (uint32_t base = 0; base < count; base += kCapacity)
+        {
+            const uint32_t batch = std::min(kCapacity, count - base);
+            auto *vertices = static_cast<Vertex *>(renderer.LockVertexBuffer(vertexBuffer_, D3DLOCK_DISCARD));
+            if (!vertices)
+                break;
+            for (uint32_t i = 0; i < batch; ++i)
+            {
+                const RS_RECT &rect = rects[base + i];
+                Vertex *out = vertices + i * 6;
+                const CVECTOR pos = view * rect.vPos;
+                const float sizeX = rect.fSize * scaleX;
+                const float sizeY = rect.fSize * scaleY;
+                const float sn = sinf(rect.fAngle);
+                const float cs = cosf(rect.fAngle);
+                const float u1 = static_cast<float>(rect.dwSubTexture % sx) * du;
+                const float v1 = static_cast<float>((rect.dwSubTexture / sx) % sy) * dv;
+                const float u2 = u1 + du;
+                const float v2 = v1 + dv;
+                const CVECTOR p0 = pos + CVECTOR(sizeX * (-cs - sn), sizeY * (sn - cs), 0.f);
+                const CVECTOR p1 = pos + CVECTOR(sizeX * (-cs + sn), sizeY * (sn + cs), 0.f);
+                const CVECTOR p2 = pos + CVECTOR(sizeX * (cs + sn), sizeY * (-sn + cs), 0.f);
+                const CVECTOR p3 = pos + CVECTOR(sizeX * (cs - sn), sizeY * (-sn - cs), 0.f);
+                out[0] = {p0, rect.dwColor, u1, v2};
+                out[1] = {p1, rect.dwColor, u1, v1};
+                out[2] = {p2, rect.dwColor, u2, v1};
+                out[3] = out[0];
+                out[4] = out[2];
+                out[5] = {p3, rect.dwColor, u2, v2};
+            }
+            renderer.UnLockVertexBuffer(vertexBuffer_);
+            if (renderer.TechniqueExecuteStart(technique))
+            {
+                do
+                    renderer.DrawPrimitive(D3DPT_TRIANGLELIST, vertexBuffer_, sizeof(Vertex), 0, batch * 2);
+                while (renderer.TechniqueExecuteNext());
+            }
+        }
+        renderer.SetTransform(D3DTS_VIEW, view);
+        renderer.SetTransform(D3DTS_WORLD, oldWorld);
+    }
+};
