diff --git a/src/gameplay/PROGRAM/characters/characters_login.c b/src/gameplay/PROGRAM/characters/characters_login.c
new file mode 100644
index 0000000000000000000000000000000000000000..e27cbaed2cedea6c7467cd6eaee76ebb20dd9249
--- /dev/null
+++ b/src/gameplay/PROGRAM/characters/characters_login.c
@@ -0,0 +1,206 @@
+
+void LoginCharactersInLocation(ref loc)
+{
+	if (Port_PreparingContext())
+	{
+		LocAi_Init(loc);
+		for (int residentIndex = 0; residentIndex < TOTAL_CHARACTERS; residentIndex++)
+		{
+			ref resident = &Characters[residentIndex];
+			if (!CheckAttribute(resident, "location") || resident.location != loc.id) continue;
+			if (LocResidentSkipsCharacter(resident)) continue;
+			if (IsEntity(resident)) continue;
+			DelBakSkillAttr(resident);
+			ClearCharacterExpRate(resident);
+			LoginCharacter(resident, loc.id);
+		}
+		LocAi_PostInit(loc);
+		return;
+	}
+    // boal 01.02.2004 -->
+	SetTimeScale(1.0);
+    TimeScaleCounter = 0;
+    DelPerkFromActiveList("TimeSpeed");
+	// boal 01.02.2004 <--
+	LocAi_Init(loc);
+	string locID = loc.id;
+	for(int i = 0; i < MAX_CHARACTERS; i++)
+	{
+        DelBakSkillAttr(&Characters[i]); // boal оптимизация скилов
+        ClearCharacterExpRate(&Characters[i]);
+		LoginCharacter(&Characters[i], locID);
+	}
+	if(actLoadFlag)
+	{
+		for(i = 0; i < MAX_CHARS_IN_LOC; i++)
+		{
+            DelBakSkillAttr(&Characters[LOC_FANTOM_CHARACTERS + i]); // boal оптимизация скилов
+            ClearCharacterExpRate(&Characters[LOC_FANTOM_CHARACTERS + i]);
+			LoginCharacter(&Characters[LOC_FANTOM_CHARACTERS + i], locID);
+		}
+	}
+	
+	// boal пленники в трюм  и фантомы на палубе
+	for(i = FANTOM_CHARACTERS; i < TOTAL_CHARACTERS; i++)
+	{
+        DelBakSkillAttr(&Characters[i]); // boal оптимизация скилов
+        ClearCharacterExpRate(&Characters[i]);
+        LoginCharacter(&Characters[i], locID);
+	}
+	LocAi_PostInit(loc);
+	// boal dead can be searched 14.12.2003 -->
+	Dead_Char_num = 0; // трупов нет
+	// boal dead can be searched 14.12.2003 <--
+}
+
+bool LocResidentSkipsCharacter(aref chr)
+{
+	if (!Port_PreparingContext()) return false;
+	if (sti(chr.index) == GetMainCharacterIndex()) return true;
+	if (IsOfficer(chr) || CheckAttribute(chr, "location.follower")) return true;
+	return false;
+}
+
+void LoginCharacter(aref chr, string locID)
+{
+	if (LocResidentSkipsCharacter(chr)) return;
+	if (Port_IsResident() && IsEntity(chr)) return;
+	if(LAi_CharacterLogin(chr, locID))
+	{
+		if (Port_IsResident()) DeleteAttribute(chr, "PortContext");
+		bool isNoCreated = true;
+		if(CreateCharacter(chr))
+		{
+			isNoCreated = false;
+			if(TeleportCharacterToLocator(chr, chr.location.group, chr.location.locator)==0)
+			{
+				if((CheckAttribute(chr, "index") != false) && (GetMainCharacterIndex() == sti(chr.index)))
+				{
+					Trace("Main character <" + chr.id + "> error teleportation by location: " + chr.location + "  on locator: " + chr.location.group + "::" + chr.location.locator);
+				}
+				else
+				{
+					isNoCreated = true;
+					DeleteCharacter(chr);
+					Trace("Delete character <" + chr.id + "> , error teleportation by location: " + chr.location + " on locator: " + chr.location.group + "::" + chr.location.locator);
+				}
+			}
+		}
+		else Trace("Can't create character: " + chr.id);
+		
+		if(isNoCreated) LAi_CharacterLogoff(chr);
+	}
+}
+
+void LogoffCharacter(aref chr)
+{
+	if(IsEntity(chr))
+	{
+        DelBakSkillAttr(chr); // fix
+		LAi_CharacterLogoff(chr);
+		CharacterExitFromLocation(chr);
+	}
+}
+
+
+bool ChangeCharacterAddress(ref character, string location_id, string locator)
+{
+	return ChangeCharacterAddressGroup(character, location_id, "goto", locator);
+}
+
+string GetCharacterShipLocation(ref rCharacter)
+{
+	if (CheckAttribute(rCharacter,"location.from_sea")) return rCharacter.location.from_sea;
+	Trace("Character '" + rCharacter.id + "' location.from_sea is absent");
+	return "None";
+}
+
+bool SetCharacterShipLocation(ref character, string location_id)
+{
+	if (location_id == "")  // для пусто свой подход, это не баг, это нужно занулить
+	{
+		character.location.from_sea = location_id;	
+		return true;
+	}
+	
+	int lindex = FindLocation(location_id);
+	if (lindex < 0)
+	{
+		Trace("Incorrect location id 'SetCharacterShipLocation' (location " + location_id + " not found");
+		return false;
+	}
+	character.location.from_sea = location_id;
+	return true;
+}
+
+bool ChangeCharacterShipGroup(ref rCharacter, string group_id)
+{
+	rCharacter.Ship.AI.GroupName = group_id;
+	if (IsEntity(&AISea))
+	{
+		SendMessage(&AISea,"las",AI_MESSAGE_SHIP_CHANGE_GROUP,&rCharacter,group_id);
+	}
+	return true;
+}
+
+bool SetCharacterIslandLocation(ref character, string location_id, string group, string locator, string group_id, string task, string target_group_id)
+{
+	bool bRet = ChangeCharacterAddressGroup(character, location_id, group, locator);
+	if (!bRet) return false;
+	character.Ship.AI.GroupName = group_id;
+	character.Ship.AI.Task = task;
+	character.Ship.AI.Task.Group = target_group_id;
+	return true;
+}
+
+bool ChangeCharacterAddressGroup(ref character, string location_id, string group, string locator)
+{
+	//Trace("Change character address id = " + character.id + "; location = " + location_id + "; group = " + group + "; locator = " + locator);
+	int lindex = FindLocation(location_id);
+	if(lindex < 0)
+	{
+		//Переходим в морскую часть
+		LogoffCharacter(character);
+		lindex = FindIsland(location_id);
+		if(lindex < 0)
+		{
+			Trace("Incorrect location id 'ChangeCharacterAddressGroup' (location " + location_id + " not found");
+			return false;
+		}
+		character.location = location_id;
+		character.location.group = group;
+		character.location.locator = locator;
+		return true;
+	}
+	//Если перемещаемся внутри одной локации, то просто телепортимся
+	if (!CheckAttribute(character, "location"))
+	{
+	    trace ("character " + character.id + " have no location field");
+		character.location = "none";
+	}
+	else
+	{
+		if (location_id == character.location && IsEntity(character)) //boal fix 26/06/05
+		{
+			TeleportCharacterToLocator(character, group, locator);
+			character.location = location_id;
+			character.location.group = group;
+			character.location.locator = locator;
+			return true;
+		}
+	}
+	//Если загруженны, то выйдем из локации
+	LogoffCharacter(character);
+	//Перемещаемся в другую локацию
+	string oldLocation = character.location;
+	character.location = location_id;
+	character.location.group = group;
+	character.location.locator = locator;
+	//Если локация загруженна, то логинемся
+	if(IsEntity(&Locations[lindex]))
+	{
+		LoginCharacter(character, Locations[lindex].id);
+		LAi_PostLoginInit(character);
+	}
+	return true;
+}
diff --git a/src/gameplay/PROGRAM/sea_ai/PortArtillery.c b/src/gameplay/PROGRAM/sea_ai/PortArtillery.c
new file mode 100644
index 0000000000000000000000000000000000000000..7cf36a04a438ab8577980218d673acc4433264ca
--- /dev/null
+++ b/src/gameplay/PROGRAM/sea_ai/PortArtillery.c
@@ -0,0 +1,77 @@
+// Native collision chooses one real town character. LAi owns HP and the corpse.
+// Result: 0 rejected, 1 admitted wound, 2 canonical death. Native presentation
+// may use this result; it must never create a second damage/death owner.
+int Ball_PortCharacterHit()
+{
+	int victimIndex = GetEventData();
+	int shooterIndex = GetEventData();
+	int goodsIndex = GetEventData();
+	float x = GetEventData();
+	float y = GetEventData();
+	float z = GetEventData();
+	float impulseX = GetEventData();
+	float impulseY = GetEventData();
+	float impulseZ = GetEventData();
+	float falloff = GetEventData();
+	if (!Port_IsResident()) return 0;
+	if (victimIndex < 0 || victimIndex >= TOTAL_CHARACTERS) return 0;
+	if (shooterIndex < 0 || shooterIndex >= TOTAL_CHARACTERS) return 0;
+	if (goodsIndex != GOOD_BALLS && goodsIndex != GOOD_GRAPES && goodsIndex != GOOD_KNIPPELS && goodsIndex != GOOD_BOMBS) return 0;
+	if (falloff <= 0.0 || falloff > 1.0) return 0;
+	ref victim = GetCharacter(victimIndex);
+	ref shooter = GetCharacter(shooterIndex);
+	if (!IsEntity(victim) || LAi_IsDead(victim)) return 0;
+	if (!CheckAttribute(victim, "location") || victim.location != "SanJuan_town") return 0;
+	if (CharacterCombat_ProtectionReason(victim) != "") return 0;
+	float damage = (stf(Goods[goodsIndex].DamageHull) * 10.0 + stf(Goods[goodsIndex].DamageCrew) * 100.0) * falloff;
+	int points = MakeInt(damage + 0.5);
+	if (points < 1) return 0;
+	int victimLocation = FindLocation(victim.location);
+	if (victimLocation < 0 || !IsEntity(&Locations[victimLocation])) return 0;
+	int previousLocation = FindLoadedLocation();
+	// Blood, death callbacks, respawn and crime all consume loadedLocation.
+	// Borrow only this script reference; native active context owns the camera.
+	makeref(loadedLocation, Locations[victimLocation]);
+	int admitted = Port_ApplyArtilleryDamage(shooter, victim, shooterIndex, points);
+	// A synchronous quest may retire/reload a context. Do not revive its old
+	// reference or override a newly activated location after the callback.
+	if (previousLocation >= 0 && IsEntity(&Locations[previousLocation]) && FindLoadedLocation() == previousLocation)
+		makeref(loadedLocation, Locations[previousLocation]);
+	return admitted;
+}
+
+int Port_ApplyArtilleryDamage(ref shooter, ref victim, int shooterIndex, int points)
+{
+	bool playerOwned = shooterIndex == GetMainCharacterIndex() || IsOfficer(shooter) || IsCompanion(shooter);
+	if (playerOwned) Crime_MarkPlayerIntentAtLocation(victim, "artillery", victim.location);
+	// Land groups contain Character entities. A sea-bound player is a ship.
+	if (Port_IsLandHero() && shooterIndex == GetMainCharacterIndex()) LAi_group_Attack(shooter, victim);
+	Port_ArtilleryFortAlarm(shooterIndex, victim);
+	LAi_ApplyCharacterDamage(victim, points);
+	if (LAi_GetCharacterHP(victim) <= 0.0) victim.Killer.Index = shooterIndex;
+	LAi_CheckKillCharacter(victim);
+	if (LAi_IsDead(victim))
+	{
+		Statistic_KillChar(shooter, victim, "_g");
+		LAi_SetResultOfDeath(shooter, victim, CheckAttribute(victim, "equip.blade"));
+		return 2;
+	}
+	return 1;
+}
+
+void Port_ArtilleryFortAlarm(int shooterIndex, ref victim)
+{
+	if (!CheckAttribute(victim, "nation")) return;
+	bool changed = false;
+	for (int i = 0; i < MAX_FORTS; i++)
+	{
+		if (!CheckAttribute(&Forts[i], "fortcmdridx")) continue;
+		int fortIndex = sti(Forts[i].fortcmdridx);
+		if (fortIndex < 0 || fortIndex >= TOTAL_CHARACTERS || fortIndex == shooterIndex) continue;
+		ref fort = GetCharacter(fortIndex);
+		if (!CheckAttribute(fort, "nation") || sti(fort.nation) != sti(victim.nation)) continue;
+		SetCharacterRelationBoth(shooterIndex, fortIndex, RELATION_ENEMY);
+		changed = true;
+	}
+	if (changed) UpdateRelations();
+}
diff --git a/src/gameplay/PROGRAM/sea_ai/PortRegion.c b/src/gameplay/PROGRAM/sea_ai/PortRegion.c
new file mode 100644
index 0000000000000000000000000000000000000000..1022db415953bdfd9c6fa5b1f8f240752fbf06d9
--- /dev/null
+++ b/src/gameplay/PROGRAM/sea_ai/PortRegion.c
@@ -0,0 +1,502 @@
+#include "sea_ai\PortSave.c"
+#include "SEA_AI\PortTravelRig.c"
+
+object PortRoles, PortBoat, PortRetiredHero;
+bool PortPreparing = false;
+bool PortRetiring = false;
+bool PortAddressOnly = false;
+int PortPrepareCursor = 0;
+
+bool Port_IsResident()
+{
+    if (PortRetiring || !IsEntity(&PortRoles) || !IsEntity(&AISea)) return false;
+    return CheckAttribute(pchar, "PortTravel.resident") && sti(pchar.PortTravel.resident) == 1;
+}
+
+bool Port_IsLandHero()
+{
+    return Port_IsResident() && CheckAttribute(pchar, "PortTravel.mode") && pchar.PortTravel.mode == "land";
+}
+
+bool Port_HeroAwayFromShip()
+{
+    return Port_IsResident() && CheckAttribute(pchar, "PortTravel.mode") &&
+        (pchar.PortTravel.mode == "land" || pchar.PortTravel.mode == "boat");
+}
+
+bool Port_PreparingContext()
+{
+    return PortPreparing || locResidentPreparing;
+}
+
+bool Port_IsSupportedLocation(string id)
+{
+    int index = FindLocation(id);
+    if (index < 0) return false;
+    ref loc = &Locations[index];
+    if (id == "SanJuan_town") return true;
+    if (!CheckAttribute(loc, "type")) return false;
+    if (loc.type != "tavern" && loc.type != "house" && loc.type != "shop" && loc.type != "shipyard" &&
+        loc.type != "residence" && loc.type != "church" && loc.type != "jail") return false;
+    if (CheckAttribute(loc, "PortContext.region") && loc.PortContext.region == "PuertoRico") return true;
+    if (CheckAttribute(loc, "townsack") && loc.townsack == "SanJuan") return true;
+    return findsubstr(id, "SanJuan_", 0) == 0;
+}
+
+bool Port_PrepareContext(int index)
+{
+    if (index < 0) return false;
+    ref loc = &Locations[index];
+    if (IsEntity(loc) && CheckAttribute(loc, "PortContext.prepared")) return true;
+    PortSave_ApplyPreparedContext(loc);
+    // Preparation runs after OnLoad has released its flag. Keep the saved
+    // population's deaths and encounter state while rebuilding its entities.
+    bool previousLoadFlag = actLoadFlag;
+    if (CheckAttribute(loc, "PortSave.population")) actLoadFlag = true;
+    bool result;
+    if (loc.id == "SanJuan_town")
+    {
+        loc.PortResident = "PuertoRico";
+        result = LocPrepareResident(loc, stf(PortRoles.town.x), stf(PortRoles.town.y),
+                                   stf(PortRoles.town.z), stf(PortRoles.town.yaw));
+    }
+    else result = LocPrepareResident(loc, 0.0, 0.0, 0.0, 0.0);
+    actLoadFlag = previousLoadFlag;
+    if (!result) return false;
+    DeleteAttribute(loc, "PortSave.population");
+    loc.PortContext.region = "PuertoRico";
+    SendMessage(loc, "l", MSG_LOCATION_TLPCHRPOSITIONS);
+    return true;
+}
+
+bool Port_PrepareRegion()
+{
+    if (!IsEntity(&AISea) || !CheckAttribute(&AISea, "Island") || AISea.Island != "PuertoRico") return false;
+    if (!IsEntity(&PortRoles))
+    {
+        PortRoles.config = "RESOURCE\INI\sea_towns\puerto_rico.ini";
+        if (!CreateEntity(&PortRoles, "PortEntityRoles")) return false;
+        pchar.PortTravel.version = 1;
+        pchar.PortTravel.region = "PuertoRico";
+        pchar.PortTravel.resident = 1;
+        if (!CheckAttribute(pchar, "PortTravel.mode")) pchar.PortTravel.mode = "ship";
+        aref rig;
+        makearef(rig, pchar.PortTravel.rig);
+        PortTravel_InitRig(rig);
+        Sea_ClearTownPopulation();
+    }
+    if (!Port_PrepareContext(FindLocation("SanJuan_town"))) return false;
+    if (!Port_IsLandHero())
+    {
+        loadedLocation = &Locations[FindLocation("SanJuan_town")];
+        SendMessage(loadedLocation, "lsl", MSG_LOCATION_EX_MSG, "SetActiveContext", true);
+    }
+    LayerFreeze(EXECUTE, false);
+    LayerFreeze(REALIZE, false);
+    return true;
+}
+
+void Port_SetSeaCamera(bool enabled)
+{
+    if (enabled)
+    {
+        LayerAddObject(SEA_EXECUTE, &SeaShipCamera, iShipPriorityExecute + 5);
+        LayerAddObject(SEA_EXECUTE, &SeaFreeCamera, 1);
+        LayerAddObject(SEA_EXECUTE, &SeaDeckCamera, iShipPriorityExecute + 5);
+        LayerAddObject(SEA_REALIZE, &SeaDeckCamera, 65531);
+    }
+    else
+    {
+        LayerDelObject(SEA_EXECUTE, &SeaShipCamera);
+        LayerDelObject(SEA_EXECUTE, &SeaFreeCamera);
+        LayerDelObject(SEA_EXECUTE, &SeaDeckCamera);
+        LayerDelObject(SEA_REALIZE, &SeaDeckCamera);
+    }
+    bCanSwitchCameras = enabled;
+}
+
+bool Port_BindShip()
+{
+    if (!Port_IsLandHero()) return true;
+    // Log off while the canonical object still addresses its Character entity.
+    LAi_CharacterLogoff(pchar);
+    if (!SendMessage(&PortRoles, "lee", 0, &pchar, &PortRetiredHero)) return false;
+    DeleteClass(&PortRetiredHero);
+    pchar.location = "PuertoRico";
+    pchar.location.group = "reload";
+    pchar.location.locator = "reload_1";
+    pchar.location.from_sea = "SanJuan_town";
+    return true;
+}
+
+bool Port_AbortLandHero(ref previousHero, ref previousAddress, int previousLocation)
+{
+    if (CheckAttribute(pchar, "chr_ai.login") && sti(pchar.chr_ai.login)) LAi_CharacterLogoff(pchar);
+    if (!SendMessage(&PortRoles, "lee", 2, &pchar, previousHero)) return false;
+    DeleteClass(previousHero);
+    DeleteAttribute(pchar, "location");
+    aref address;
+    makearef(address, pchar.location);
+    CopyAttributes(address, previousAddress);
+    if (previousLocation >= 0 && IsEntity(&Locations[previousLocation]))
+    {
+        loadedLocation = &Locations[previousLocation];
+        SendMessage(loadedLocation, "lsl", MSG_LOCATION_EX_MSG, "SetActiveContext", true);
+    }
+    return false;
+}
+
+bool Port_CreateLandHero(int index, string group, string locator, bool usePosition)
+{
+    if (!Port_PrepareContext(index)) return false;
+    ref loc = &Locations[index];
+    if (!CheckAttribute(loc, "locators." + group + "." + locator)) return false;
+    object previousHero, previousAddress;
+    aref address;
+    makearef(address, pchar.location);
+    CopyAttributes(&previousAddress, address);
+    int previousLocation = FindLoadedLocation();
+    if (!SendMessage(&PortRoles, "lee", 1, &pchar, &previousHero)) return false;
+    if (!SendMessage(loc, "lsl", MSG_LOCATION_EX_MSG, "SetActiveContext", true)) return false;
+    loadedLocation = loc;
+    pchar.location = loc.id;
+    pchar.location.group = group;
+    pchar.location.locator = locator;
+    pchar.location.from_sea = "SanJuan_town";
+    if (!CreateCharacter(pchar)) return Port_AbortLandHero(&previousHero, &previousAddress, previousLocation);
+    if (!LAi_CharacterLogin(pchar, loc.id)) return Port_AbortLandHero(&previousHero, &previousAddress, previousLocation);
+    if (!TeleportCharacterToLocator(pchar, group, locator)) return Port_AbortLandHero(&previousHero, &previousAddress, previousLocation);
+    if (usePosition)
+    {
+        if (!TeleportCharacterToPosAy(pchar, stf(pchar.PortTravel.heroX), stf(pchar.PortTravel.heroY), stf(pchar.PortTravel.heroZ), stf(pchar.PortTravel.heroYaw)))
+            return Port_AbortLandHero(&previousHero, &previousAddress, previousLocation);
+    }
+    LAi_PostLoginInit(pchar);
+    pchar.PortTravel.mode = "land";
+    bSeaActive = false;
+    Port_SetSeaCamera(false);
+    DeleteBattleInterface();
+    InitBattleLandInterface();
+    if (!LocActivateResident(loc)) return false;
+    LayerFreeze(EXECUTE, false);
+    LayerFreeze(REALIZE, false);
+    LayerFreeze(SEA_EXECUTE, false);
+    LayerFreeze(SEA_REALIZE, false);
+    return true;
+}
+
+bool Port_EnsureBoat()
+{
+    if (IsEntity(&PortBoat)) return true;
+    if (!CreateEntity(&PortBoat, "PORT_ROWBOAT")) return false;
+    aref descriptor;
+    makearef(descriptor, pchar.PortTravel);
+    pchar.PortTravel.enabled = 1;
+    return SendMessage(&PortBoat, "laa", 0, pchar, descriptor);
+}
+
+bool Port_SelectPier(float x, float z)
+{
+    ref town = &Locations[FindLocation("SanJuan_town")];
+    if (!CheckAttribute(town, "locators.reload.reload1_back")) return false;
+    string selected = "reload1_back";
+    if (CheckAttribute(town, "locators.reload.reload2_back"))
+    {
+        float a = GetDistance2D(x, z, stf(town.locators.reload.reload1_back.x), stf(town.locators.reload.reload1_back.z));
+        float b = GetDistance2D(x, z, stf(town.locators.reload.reload2_back.x), stf(town.locators.reload.reload2_back.z));
+        if (b < a) selected = "reload2_back";
+    }
+    aref pier;
+    makearef(pier, town.locators.reload.(selected));
+    pchar.PortTravel.pier = selected;
+    pchar.PortTravel.targetX = pier.x;
+    pchar.PortTravel.targetY = pier.y;
+    pchar.PortTravel.targetZ = pier.z;
+    pchar.PortTravel.targetYaw = pier.ay;
+    return true;
+}
+
+bool Port_EnterBoat()
+{
+    if (!Port_IsResident() || DialogRun || sti(InterfaceStates.Launched) != 0) return false;
+    if (!Port_EnsureBoat()) return false;
+    bool land = Port_IsLandHero();
+    if (land)
+    {
+        if (!SendMessage(&PortRoles, "le", 3, &pchar)) return false;
+        if (pchar.location != "SanJuan_town") return false;
+        float x, y, z, ay;
+        if (!GetCharacterPos(pchar, &x, &y, &z)) return false;
+        if (!Port_SelectPier(x, z)) return false;
+        if (GetDistance2D(x, z, stf(pchar.PortTravel.targetX), stf(pchar.PortTravel.targetZ)) > 3.0) return false;
+        GetCharacterAy(pchar, &ay);
+        pchar.PortTravel.sourceX = x;
+        pchar.PortTravel.sourceY = y;
+        pchar.PortTravel.sourceZ = z;
+        pchar.PortTravel.sourceYaw = ay;
+        if (!CheckAttribute(pchar, "PortTravel.x"))
+        {
+            float dx = x - stf(PortRoles.town.x);
+            float dz = z - stf(PortRoles.town.z);
+            float length = sqrt(dx*dx + dz*dz);
+            if (length < 0.1) return false;
+            pchar.PortTravel.x = x + dx * 2.2 / length;
+            pchar.PortTravel.y = y;
+            pchar.PortTravel.z = z + dz * 2.2 / length;
+            pchar.PortTravel.yaw = ay;
+        }
+        if (!SendMessage(&PortBoat, "li", 1, 0)) return false;
+        LocSuspendResident(loadedLocation);
+        if (!Port_BindShip()) { SendMessage(&PortBoat, "l", 3); return false; }
+    }
+    else
+    {
+        if (SeaCameras.Camera != "SeaDeckCamera") return false;
+        if (!SendMessage(&PortBoat, "li", 1, &SeaDeckCamera)) return false;
+    }
+    pchar.PortTravel.mode = "boat";
+    bSeaActive = true;
+    Port_SetSeaCamera(false);
+    BI_ShowInterface(false);
+    procUpdateControlKeyGroup();
+    return true;
+}
+
+void Port_TryLeaveBoat()
+{
+    if (!IsEntity(&PortBoat) || !CheckAttribute(pchar, "PortTravel.state") || sti(pchar.PortTravel.state) != 2) return;
+    // Native admission independently validates range, relative speed and solids.
+    if (stf(pchar.Ship.HP) > 0.0 && SendMessage(&PortBoat, "li", 2, &SeaDeckCamera)) return;
+    if (!Port_SelectPier(stf(pchar.PortTravel.x), stf(pchar.PortTravel.z))) return;
+    SendMessage(&PortBoat, "li", 2, 0);
+}
+
+void Port_CompleteHandoff()
+{
+    if (!CheckAttribute(pchar, "PortTravel.heroOwned") || sti(pchar.PortTravel.heroOwned) == 0) return;
+    if (sti(pchar.PortTravel.handoffDeck) != 0)
+    {
+        pchar.PortTravel.mode = "deck";
+        bSeaActive = true;
+        SeaCameras.Camera = "SeaDeckCamera";
+        SendMessage(&SeaCameras, "lia", AI_CAMERAS_SET_CAMERA, &SeaDeckCamera, pchar);
+        Port_SetSeaCamera(true);
+        InitBattleInterface();
+        StartBattleInterface();
+        RefreshBattleInterface();
+    }
+    else
+    {
+        if (!Port_CreateLandHero(FindLocation("SanJuan_town"), "reload", pchar.PortTravel.pier, true)) return;
+    }
+    SendMessage(&PortBoat, "l", 4);
+    procUpdateControlKeyGroup();
+}
+
+bool Port_ChangeLandLocation(string id, string group, string locator)
+{
+    if (!Port_IsLandHero() || !Port_IsSupportedLocation(id)) return false;
+    int destination = FindLocation(id);
+    if (!Port_PrepareContext(destination)) return false;
+    ref previous = loadedLocation;
+    object previousAddress;
+    aref address;
+    makearef(address, pchar.location);
+    CopyAttributes(&previousAddress, address);
+    if (!SendMessage(&PortRoles, "lee", 1, &pchar, &PortRetiredHero)) return false;
+    LocSuspendResident(previous);
+    LAi_CharacterLogoff(pchar);
+    SendMessage(previous, "lsl", MSG_LOCATION_EX_MSG, "SetContextVisible", false);
+    if (!Port_CreateLandHero(destination, group, locator, false))
+    {
+        if (CheckAttribute(pchar, "chr_ai.login") && sti(pchar.chr_ai.login)) LAi_CharacterLogoff(pchar);
+        if (SendMessage(&PortRoles, "lee", 2, &pchar, &PortRetiredHero))
+        {
+            DeleteClass(&PortRetiredHero);
+            makearef(address, pchar.location);
+            CopyAttributes(address, &previousAddress);
+            LAi_CharacterLogin(pchar, previous.id);
+            LAi_PostLoginInit(pchar);
+            LocActivateResident(previous);
+        }
+        return false;
+    }
+    DeleteClass(&PortRetiredHero);
+    return true;
+}
+
+bool Port_ReloadLandLocation(int destination, aref data)
+{
+    // Reuse stock common-house backlinks, authored destination options and
+    // daily encounter setup before activating the already prepared context.
+    object previousAddress;
+    aref address;
+    makearef(address, pchar.location);
+    CopyAttributes(&previousAddress, address);
+    PortAddressOnly = true;
+    int configured = ReloadToLocation(destination, data);
+    PortAddressOnly = false;
+    string group = pchar.location.group;
+    string locator = pchar.location.locator;
+    makearef(address, pchar.location);
+    CopyAttributes(address, &previousAddress);
+    if (!configured) return false;
+    return Port_ChangeLandLocation(Locations[destination].id, group, locator);
+}
+
+void Port_LeaveForOrdinaryLocation()
+{
+    object address;
+    aref current;
+    makearef(current, pchar.location);
+    CopyAttributes(&address, current);
+    Port_RetireRegion();
+    if (IsEntity(&AISea)) DeleteSeaEnvironment();
+    makearef(current, pchar.location);
+    CopyAttributes(current, &address);
+}
+
+bool Port_RestoreAfterSea()
+{
+    if (!Port_IsResident() || !CheckAttribute(pchar, "PortTravel.restore.pending")) return false;
+    string mode = pchar.PortTravel.mode;
+    bool result = true;
+    if (mode == "land")
+    {
+        string id = pchar.PortTravel.restore.location;
+        if (!Port_IsSupportedLocation(id)) id = "SanJuan_town";
+        string group = "reload";
+        string locator = "reload1_back";
+        if (CheckAttribute(pchar, "PortTravel.restore.location.group")) group = pchar.PortTravel.restore.location.group;
+        if (CheckAttribute(pchar, "PortTravel.restore.location.locator")) locator = pchar.PortTravel.restore.location.locator;
+        result = Port_CreateLandHero(FindLocation(id), group, locator, false);
+        if (result && CheckAttribute(pchar, "PortTravel.restore.hero"))
+        {
+            aref from, to;
+            makearef(from, pchar.PortTravel.restore.hero);
+            makearef(to, pchar.saveposition);
+            CopyAttributes(to, from);
+            SendMessage(loadedLocation, "l", MSG_LOCATION_TLPCHRPOSITIONS);
+        }
+    }
+    else if (mode == "boat")
+    {
+        result = Port_EnsureBoat();
+        if (result)
+        {
+            if (CheckAttribute(pchar, "PortTravel.transferDeck") && sti(pchar.PortTravel.transferDeck))
+                result = SendMessage(&PortBoat, "li", 5, &SeaDeckCamera);
+            else result = SendMessage(&PortBoat, "li", 5, 0);
+        }
+        if (result)
+        {
+            bSeaActive = true;
+            Port_SetSeaCamera(false);
+            BI_ShowInterface(false);
+        }
+    }
+    else
+    {
+        pchar.PortTravel.mode = mode;
+        Port_SetSeaCamera(true);
+        if (mode == "deck")
+        {
+            SeaCameras.Camera = "SeaDeckCamera";
+            SendMessage(&SeaCameras, "lia", AI_CAMERAS_SET_CAMERA, &SeaDeckCamera, pchar);
+        }
+        if (CheckAttribute(pchar, "PortTravel.state") && sti(pchar.PortTravel.state) == 4 && Port_EnsureBoat())
+        {
+            if (CheckAttribute(pchar, "PortTravel.handoffDeck") && sti(pchar.PortTravel.handoffDeck))
+                SendMessage(&PortBoat, "li", 5, &SeaDeckCamera);
+            else SendMessage(&PortBoat, "li", 5, 0);
+        }
+    }
+    if (!result)
+    {
+        Trace("Port restore: travel presentation unavailable, retaining naval state and recovering to pier");
+        SendMessage(&PortRoles, "lee", 0, &pchar, &PortRetiredHero);
+        DeleteClass(&PortRetiredHero);
+        result = Port_CreateLandHero(FindLocation("SanJuan_town"), "reload", "reload1_back", false);
+    }
+    if (result)
+    {
+        DeleteAttribute(pchar, "PortTravel.restore");
+        procUpdateControlKeyGroup();
+    }
+    return result;
+}
+
+void Port_RetireRegion()
+{
+    if (!IsEntity(&PortRoles)) return;
+    if (Port_IsLandHero())
+    {
+        LocSuspendResident(loadedLocation);
+        Port_BindShip();
+    }
+    PortRetiring = true;
+    DeleteClass(&PortBoat);
+    for (int i = 0; i < nLocationsNum; i++)
+    {
+        if (!CheckAttribute(&Locations[i], "PortContext.region")) continue;
+        if (Locations[i].PortContext.region != "PuertoRico") continue;
+        LocRetireResident(&Locations[i]);
+        DeleteAttribute(&Locations[i], "PortSave.population");
+    }
+    if (LAi_IsInitedAI) LocAi_Release();
+    DeleteClass(&PortRoles);
+    DeleteAttribute(pchar, "PortTravel");
+    PortPrepareCursor = 0;
+    PortRetiring = false;
+}
+
+#event_handler("frame", "Port_Frame");
+void Port_Frame()
+{
+    if (PortPreparing || PortRetiring || bSeaReloadStarted || !bSeaLoaded || !IsEntity(&AISea)) return;
+    if (!CheckAttribute(&AISea, "Island") || AISea.Island != "PuertoRico") return;
+    if (!Port_IsResident())
+    {
+        if (!Port_PrepareRegion()) return;
+    }
+    if (CheckAttribute(pchar, "PortTravel.restore.pending"))
+    {
+        Port_RestoreAfterSea();
+        return;
+    }
+    if (IsEntity(&PortBoat) && CheckAttribute(pchar, "PortTravel.state") && sti(pchar.PortTravel.state) == 4)
+        Port_CompleteHandoff();
+    if (DialogRun || sti(InterfaceStates.Launched) != 0) return;
+    // Prepare original service destinations before the player uses their doors.
+    for (int i = PortPrepareCursor; i < nLocationsNum; i++)
+    {
+        PortPrepareCursor = i + 1;
+        if (!Port_IsSupportedLocation(Locations[i].id) || IsEntity(&Locations[i])) continue;
+        Port_PrepareContext(i);
+        break;
+    }
+}
+
+#event_handler("Control Activation", "Port_Control");
+void Port_Control()
+{
+    string control = GetEventData();
+    if (control != "PortTravelAction" || !Port_IsResident()) return;
+    if (DialogRun || sti(InterfaceStates.Launched) != 0) return;
+    if (pchar.PortTravel.mode == "boat") Port_TryLeaveBoat();
+    else Port_EnterBoat();
+}
+
+void Port_RegisterControls()
+{
+    if (!CheckAttribute(&objControlsState, "keygroups.PrimaryLand.PortTravelAction"))
+    {
+        CI_CreateAndSetControls("PrimaryLand", "PortTravelAction", CI_GetKeyCode("KEY_E"), 0, true);
+    }
+    MapControlToGroup("PortTravelAction", "Sailing1Pers");
+    MapControlToGroup("PortTravelAction", "PortRowboat");
+    MapControlToGroup("ChrForward", "PortRowboat");
+    MapControlToGroup("ChrBackward", "PortRowboat");
+    MapControlToGroup("ChrStrafeLeft", "PortRowboat");
+    MapControlToGroup("ChrStrafeRight", "PortRowboat");
+}
diff --git a/src/gameplay/PROGRAM/sea_ai/PortSave.c b/src/gameplay/PROGRAM/sea_ai/PortSave.c
new file mode 100644
index 0000000000000000000000000000000000000000..9ff49926bcb4d6a4167dcc14ee32694c07f8fa35
--- /dev/null
+++ b/src/gameplay/PROGRAM/sea_ai/PortSave.c
@@ -0,0 +1,167 @@
+// Port state extends ordinary attributes; the existing naval binary is unchanged.
+bool portSaveLegacyQueued = false;
+
+void PortSave_CopyHeroAddress(bool legacy)
+{
+    DeleteAttribute(pchar, "PortTravel.restore");
+    pchar.PortTravel.restore.pending = 1;
+    pchar.PortTravel.restore.legacy = legacy;
+    pchar.PortTravel.restore.localCoordinates = legacy;
+    aref source, destination;
+    makearef(source, pchar.location);
+    makearef(destination, pchar.PortTravel.restore.location);
+    CopyAttributes(destination, source);
+    if (CheckAttribute(pchar, "saveposition"))
+    {
+        makearef(source, pchar.saveposition);
+        makearef(destination, pchar.PortTravel.restore.hero);
+        CopyAttributes(destination, source);
+    }
+}
+
+void Port_BeforeSave()
+{
+    if (!Port_IsResident()) return;
+    pchar.PortTravel.version = 1;
+    pchar.PortTravel.region = "PuertoRico";
+    for (int i = 0; i < nLocationsNum; i++)
+    {
+        ref loc = &Locations[i];
+        if (!IsEntity(loc) || !CheckAttribute(loc, "PortContext.prepared")) continue;
+        if (!CheckAttribute(loc, "PortContext.region") || loc.PortContext.region != "PuertoRico") continue;
+        SendMessage(loc, "l", MSG_LOCATION_SETCHRPOSITIONS);
+        loc.PortSave.population = 1;
+        PostEvent("SeaDogs_ClearSaveData", 400, "a", loc);
+    }
+    LAi_SaveInfo();
+}
+
+// Called before ordinary scene dispatch. A land-only legacy save must never
+// enter native SEALOAD: it does not contain the CSaveLoad stream.
+bool Port_LoadSaved()
+{
+    portSaveLegacyQueued = false;
+    if (!CheckAttribute(pchar, "PortTravel.resident") || !sti(pchar.PortTravel.resident))
+    {
+        if (seadogs_saveFrom == "location" && Port_IsSupportedLocation(pchar.location))
+            portSaveLegacyQueued = true;
+        return false;
+    }
+    if (!CheckAttribute(pchar, "PortTravel.region") || pchar.PortTravel.region != "PuertoRico") return false;
+    PortSave_CopyHeroAddress(false);
+    if (CheckAttribute(pchar, "PortTravel.version") && sti(pchar.PortTravel.version) == 1 &&
+        seadogs_saveFrom == "sea" && CheckAttribute(&oSeaSave, "save") && strlen(oSeaSave.save) > 8)
+    {
+        Sea_Load();
+        return true;
+    }
+    // Keep inventory, quests, health and Ship attributes; recover to a visible,
+    // ordinary pier rather than fabricating a missing fleet or invisible hero.
+    pchar.PortTravel.error = "saved_naval_state_unavailable";
+    pchar.PortTravel.resident = 0;
+    pchar.PortTravel.mode = "land";
+    DeleteAttribute(pchar, "PortTravel.restore");
+    Trace("Port restore: naval state unavailable; recovered to San Juan pier");
+    LoadMainCharacterInFirstLocation("SanJuan_town", "reload1_back", "SanJuan_town");
+    return true;
+}
+
+void Port_AfterLoad()
+{
+    if (!portSaveLegacyQueued) return;
+    portSaveLegacyQueued = false;
+    SetEventHandler("PortSave_MigrateLegacy", "PortSave_MigrateLegacy", 0);
+    PostEvent("PortSave_MigrateLegacy", 1);
+}
+
+void PortSave_MigrateLegacy()
+{
+    DelEventHandler("PortSave_MigrateLegacy", "PortSave_MigrateLegacy");
+    if (IsEntity(&AISea) || !Port_IsSupportedLocation(pchar.location)) return;
+    int current = FindLoadedLocation();
+    int town = FindLocation("SanJuan_town");
+    int island = FindIsland("PuertoRico");
+    if (current < 0 || town < 0 || island < 0) return;
+    if (!CheckAttribute(pchar, "Ship.Type") || GetCharacterShipType(pchar) == SHIP_NOTUSED)
+    {
+        pchar.PortTravel.error = "legacy_ship_unavailable";
+        Trace("Port migration: no existing player ship; retained ordinary land scene");
+        return;
+    }
+    // Resolve the authored coast exit before retiring anything.
+    aref exits, exit;
+    makearef(exits, Locations[town].reload);
+    bool found = false;
+    for (int i = 0; i < GetAttributesNum(exits); i++)
+    {
+        exit = GetAttributeN(exits, i);
+        if (exit.go != "PuertoRico") continue;
+        string emerge = FindEmergeLocator(&Islands[island], exit.emerge);
+        if (emerge == "" || !CheckAttribute(&Islands[island], "reload." + emerge + ".ships.l0.x")) continue;
+        found = true;
+        break;
+    }
+    if (!found)
+    {
+        pchar.PortTravel.error = "legacy_berth_unavailable";
+        Trace("Port migration: authored berth unavailable; retained ordinary land scene");
+        return;
+    }
+    ref loc = &Locations[current];
+    SendMessage(loc, "l", MSG_LOCATION_SETCHRPOSITIONS);
+    LAi_SaveInfo();
+    PortSave_CopyHeroAddress(true);
+    loc.PortSave.population = 1;
+    pchar.PortTravel.version = 1;
+    pchar.PortTravel.region = "PuertoRico";
+    pchar.PortTravel.mode = "land";
+    // Ordinary UnloadLocation clears canonical location fantoms. Retire only
+    // entities and the old land environment, retaining their saved attributes.
+    LocSuspendResident(loc);
+    LocRetireResident(loc);
+    DeleteCoastFoamEnvironment();
+    DeleteParticles();
+    DeleteAnimals();
+    DeleteSea();
+    DeleteWeather();
+    DeleteShipEnvironment();
+    Ship_Walk_Delete();
+    for (i = 0; i < locNumShips; i++) DeleteClass(&locShips[i]);
+    locNumShips = 0;
+    pchar.PortTravel.resident = 1;
+    ReloadToSea(island, exit);
+}
+
+void PortSave_TransformPosition(aref position)
+{
+    float x = stf(position.x);
+    float z = stf(position.z);
+    float yaw = stf(PortRoles.town.yaw);
+    position.x = stf(PortRoles.town.x) + x * cos(yaw) + z * sin(yaw);
+    position.y = stf(PortRoles.town.y) + stf(position.y);
+    position.z = stf(PortRoles.town.z) + z * cos(yaw) - x * sin(yaw);
+    position.ay = stf(position.ay) + yaw;
+}
+
+// Called after PortRoles has read canonical layout, before native actor login.
+void PortSave_ApplyPreparedContext(ref loc)
+{
+    if (CheckAttribute(loc, "PortSave.population")) loc.PortContext.population = 1;
+    if (loc.id != "SanJuan_town" || !CheckAttribute(pchar, "PortTravel.restore.localCoordinates") ||
+        !sti(pchar.PortTravel.restore.localCoordinates)) return;
+    for (int i = 0; i < TOTAL_CHARACTERS; i++)
+    {
+        ref chr = &Characters[i];
+        if (!CheckAttribute(chr, "location") || chr.location != loc.id || !CheckAttribute(chr, "saveposition")) continue;
+        aref position;
+        makearef(position, chr.saveposition);
+        PortSave_TransformPosition(position);
+    }
+    if (CheckAttribute(pchar, "PortTravel.restore.hero") && pchar.PortTravel.restore.location == loc.id)
+    {
+        aref hero;
+        makearef(hero, pchar.PortTravel.restore.hero);
+        PortSave_TransformPosition(hero);
+    }
+    pchar.PortTravel.restore.localCoordinates = 0;
+}
