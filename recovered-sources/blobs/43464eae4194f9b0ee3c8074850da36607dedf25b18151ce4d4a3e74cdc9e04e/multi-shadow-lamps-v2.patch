+
+unsigned Lights::GetShadowLights(const CVECTOR& pos, MetalShadowLight* out, unsigned capacity)
+{
+    struct Candidate { float distanceSquared; uint64_t id; D3DLIGHT9 light; };
+    std::vector<Candidate> candidates;
+    for (int32_t index=0; index<numLights; ++index) {
+        const auto& source=lights[index]; const auto& type=types[source.type];
+        if(type.dxLight.Type!=D3DLIGHT_POINT || type.dxLight.Range<=.1f)continue;
+        if(source.color.r<=0 && source.color.g<=0 && source.color.b<=0)continue;
+        const float dx=pos.x-source.pos.x,dy=pos.y-source.pos.y,dz=pos.z-source.pos.z;
+        const float distanceSquared=dx*dx+dy*dy+dz*dz;
+        if(distanceSquared>=type.dxLight.Range*type.dxLight.Range)continue;
+        auto light=type.dxLight; light.Position=source.pos; light.Diffuse=source.color;
+        candidates.push_back({distanceSquared,uint64_t(index)+1,light});
+    }
+    std::sort(candidates.begin(),candidates.end(),[](const Candidate& a,const Candidate& b){
+        return a.distanceSquared==b.distanceSquared ? a.id<b.id : a.distanceSquared<b.distanceSquared;
+    });
+    const auto candidateFor=[&](uint64_t id)->const Candidate*{
+        const auto it=std::find_if(candidates.begin(),candidates.end(),[&](const Candidate& candidate){return candidate.id==id;});
+        return it==candidates.end()?nullptr:&*it;
+    };
+    std::vector<uint64_t> desired;
+    for(unsigned index=0; index<candidates.size() && index<2u; ++index)desired.push_back(candidates[index].id);
+    const auto selected=[&](uint64_t id){return std::find(desired.begin(),desired.end(),id)!=desired.end();};
+    for(const auto id:desired)
+        if(std::find_if(metalShadowSelections.begin(),metalShadowSelections.end(),[&](const MetalShadowSelection& selection){return selection.id==id;})==metalShadowSelections.end())
+            metalShadowSelections.push_back({id,0});
+    // This envelope affects only point-shadow occlusion. The authored point-light
+    // catalog remains unmodified, so color, intensity, attenuation and range do not fade.
+    constexpr float fadeSeconds=.25f;
+    const float elapsed=metalShadowElapsed;
+    metalShadowElapsed=0;
+    const float step=std::clamp(elapsed/fadeSeconds,0.f,1.f);
+    for(auto& selection:metalShadowSelections){
+        if(!candidateFor(selection.id)){selection.weight=0;continue;}
+        selection.weight=std::clamp(selection.weight+(selected(selection.id)?step:-step),0.f,1.f);
+    }
+    metalShadowSelections.erase(std::remove_if(metalShadowSelections.begin(),metalShadowSelections.end(),[](const MetalShadowSelection& selection){return selection.weight<=0;}),metalShadowSelections.end());
+    std::sort(metalShadowSelections.begin(),metalShadowSelections.end(),[&](const MetalShadowSelection& a,const MetalShadowSelection& b){
+        const bool aSelected=selected(a.id),bSelected=selected(b.id);
+        if(aSelected!=bSelected)return aSelected;
+        return a.weight==b.weight ? a.id<b.id : a.weight>b.weight;
+    });
+    if(metalShadowSelections.size()>4u)metalShadowSelections.resize(4u);
+    std::sort(metalShadowSelections.begin(),metalShadowSelections.end(),[](const MetalShadowSelection& a,const MetalShadowSelection& b){return a.id<b.id;});
+    unsigned count=0;
+    for(const auto& selection:metalShadowSelections){
+        if(count>=std::min(capacity,4u))break;
+        if(const auto* candidate=candidateFor(selection.id))out[count++]={selection.id,candidate->light,selection.weight};
+    }
+    return count;
+}
