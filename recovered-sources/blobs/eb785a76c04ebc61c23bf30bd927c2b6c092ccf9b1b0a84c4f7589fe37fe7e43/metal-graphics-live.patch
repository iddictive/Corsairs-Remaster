+
+int32_t DX9RENDER::ApplyMetalGraphics(uint32_t flagsMask, uint32_t shadowQuality, int32_t fullscreen,
+                                           int32_t renderWidth, int32_t renderHeight, int32_t requestedDesktopMode)
+{
+    constexpr uint32_t knownFlags = (1u << 7u) - 1u;
+    std::fprintf(stderr, "[StormMetal graphics] apply request flags=%u quality=%u fullscreen=%d size=%dx%d desktop=%d\n",
+                 flagsMask, shadowQuality, fullscreen, renderWidth, renderHeight, requestedDesktopMode);
+    if ((flagsMask & ~knownFlags) != 0 || shadowQuality > 2 || (fullscreen != 0 && fullscreen != 1) ||
+        (requestedDesktopMode != 0 && requestedDesktopMode != 1) || renderWidth < 320 || renderHeight < 200 ||
+        (requestedDesktopMode != 0 && fullscreen == 0) || renderWidth > 16384 || renderHeight > 16384 || !d3d9)
+    {
+        std::fprintf(stderr, "[StormMetal graphics] reject=invalid-payload\n");
+        return 0;
+    }
+
+#ifndef __APPLE__
+    return 0;
+#else
+    auto *window = core.GetWindow();
+    if (!window || !StormMetalCanApplyGraphicsSettings(d3d9, flagsMask, shadowQuality))
+    {
+        std::fprintf(stderr, "[StormMetal graphics] reject=unsafe-phase window=%d\n", window ? 1 : 0);
+        return 0;
+    }
+
+    const bool nextWindowed = fullscreen == 0;
+    const bool nextDesktopMode = requestedDesktopMode != 0;
+    auto requestedSize = storm::WindowSize{renderWidth, renderHeight};
+    if (nextDesktopMode && !nextWindowed)
+    {
+        const auto desktop = window->GetDesktopSize();
+        if (desktop.width > 0 && desktop.height > 0)
+            requestedSize = desktop;
+    }
+    if (requestedSize.width < 320 || requestedSize.height < 200)
+    {
+        std::fprintf(stderr, "[StormMetal graphics] reject=invalid-desktop size=%dx%d\n", requestedSize.width,
+                     requestedSize.height);
+        return 0;
+    }
+
+    if (!StormMetalApplyGraphicsSettings(d3d9, flagsMask, shadowQuality))
+    {
+        std::fprintf(stderr, "[StormMetal graphics] reject=backend-apply\n");
+        return 0;
+    }
+
+    if (bWindow == nextWindowed && screen_size.x == requestedSize.width && screen_size.y == requestedSize.height)
+    {
+        desktopMode = nextDesktopMode;
+        std::fprintf(stderr, "[StormMetal graphics] apply success size=%dx%d desktop=%d\n", screen_size.x,
+                     screen_size.y, desktopMode ? 1 : 0);
+        return 1;
+    }
+
+    std::fprintf(stderr,
+                 "[StormMetal graphics] apply saved-for-restart current=%dx%d/%d requested=%dx%d/%d desktop=%d\n",
+                 screen_size.x, screen_size.y, bWindow ? 0 : 1, requestedSize.width, requestedSize.height,
+                 nextWindowed ? 0 : 1, nextDesktopMode ? 1 : 0);
+    return 2;
 #endif
