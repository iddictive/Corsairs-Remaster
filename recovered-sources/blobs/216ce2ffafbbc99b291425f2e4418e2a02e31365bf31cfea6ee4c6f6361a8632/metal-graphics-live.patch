+bool DX9RENDER::ApplyMetalGraphics(uint32_t flagsMask, uint32_t shadowQuality, int32_t fullscreen,
+                                        int32_t renderWidth, int32_t renderHeight, int32_t requestedDesktopMode)
+{
+    constexpr uint32_t knownFlags = (1u << 7u) - 1u;
+    if ((flagsMask & ~knownFlags) != 0 || shadowQuality > 2 || (fullscreen != 0 && fullscreen != 1) ||
+        (requestedDesktopMode != 0 && requestedDesktopMode != 1) || renderWidth < 320 || renderHeight < 200 ||
+        (requestedDesktopMode != 0 && fullscreen == 0) || renderWidth > 16384 || renderHeight > 16384 || bInsideScene || !d3d9)
+        return false;
+
+#ifndef __APPLE__
+    return false;
+#else
+    auto *window = core.GetWindow();
+    if (!window || !StormMetalCanApplyGraphicsSettings(d3d9, flagsMask, shadowQuality))
+        return false;
+
+    const bool nextWindowed = fullscreen == 0;
+    const bool nextDesktopMode = requestedDesktopMode != 0;
+    auto requestedSize = storm::WindowSize{renderWidth, renderHeight};
+    if (nextDesktopMode && !nextWindowed)
+        requestedSize = window->GetDrawableSize();
+    if (requestedSize.width < 320 || requestedSize.height < 200)
+        return false;
+    if (bWindow == nextWindowed && desktopMode == nextDesktopMode && screen_size.x == requestedSize.width &&
+        screen_size.y == requestedSize.height)
+        return StormMetalApplyGraphicsSettings(d3d9, flagsMask, shadowQuality);
+
+    const auto oldWindowed = bWindow;
+    const auto oldDesktopMode = desktopMode;
+    const auto oldWindowSize = window->GetWindowSize();
+    const auto oldScreenSize = screen_size;
+    const auto oldPresent = d3dpp;
+    const auto restoreWindow = [&]() {
+        const bool oldFullscreen = !oldWindowed;
+        if (!window->SetFullscreen(oldFullscreen))
+            return false;
+        return oldFullscreen || window->Resize(oldWindowSize.width, oldWindowSize.height);
+    };
+
+    if (!window->SetFullscreen(!nextWindowed))
+        return false;
+    if (nextWindowed && !window->Resize(renderWidth, renderHeight))
+    {
+        if (!restoreWindow())
+            core.stopFrameProcessing();
+        return false;
+    }
+
+    auto nextSize = storm::WindowSize{renderWidth, renderHeight};
+    if (nextDesktopMode)
+        nextSize = window->GetDrawableSize();
+    if (nextSize.width < 320 || nextSize.height < 200)
+    {
+        if (!restoreWindow())
+            core.stopFrameProcessing();
+        return false;
+    }
+
+    // Metal child resources survive Reset. Only the swap-chain surfaces and
+    // size-dependent postprocess targets belong to this live transaction.
+    // The legacy LostRender path destroys model/UI buffers while this screen
+    // is still active, so it must not own a settings apply.
+    const auto releasePresentation = [&]() {
+        const auto releaseOwned = [](auto *&resource) {
+            if (!resource)
+                return;
+            resource->Release();
+            resource = nullptr;
+        };
+        releaseOwned(pPostProcessSurface);
+        releaseOwned(pSmallPostProcessSurface);
+        releaseOwned(pSmallPostProcessSurface2);
+        releaseOwned(pPostProcessTexture);
+        releaseOwned(pSmallPostProcessTexture);
+        releaseOwned(pSmallPostProcessTexture2);
+        releaseOwned(pOriginalScreenSurface);
+        releaseOwned(pOriginalDepthSurface);
+    };
+    const auto restorePresentation = [&]() {
+        bPostProcessError = false;
+        d3d9->GetRenderTarget(0, &pOriginalScreenSurface);
+        d3d9->GetDepthStencilSurface(&pOriginalDepthSurface);
+        fSmallWidth = 128;
+        fSmallHeight = 128;
+        if (bPostProcessEnabled)
+        {
+            d3d9->CreateTexture(screen_size.x, screen_size.y, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8,
+                                D3DPOOL_DEFAULT, &pPostProcessTexture, nullptr);
+            d3d9->CreateTexture(static_cast<int>(fSmallWidth), static_cast<int>(fSmallHeight), 1,
+                                D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT,
+                                &pSmallPostProcessTexture, nullptr);
+            d3d9->CreateTexture(static_cast<int>(fSmallWidth * 2.0f), static_cast<int>(fSmallHeight * 2.0f), 1,
+                                D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT,
+                                &pSmallPostProcessTexture2, nullptr);
+            if (pPostProcessTexture && pSmallPostProcessTexture && pSmallPostProcessTexture2)
+            {
+                pPostProcessTexture->GetSurfaceLevel(0, &pPostProcessSurface);
+                pSmallPostProcessTexture->GetSurfaceLevel(0, &pSmallPostProcessSurface);
+                pSmallPostProcessTexture2->GetSurfaceLevel(0, &pSmallPostProcessSurface2);
+            }
+            if (!pPostProcessSurface || !pSmallPostProcessSurface || !pSmallPostProcessSurface2)
+            {
+                bPostProcessEnabled = false;
+                bPostProcessError = true;
+            }
+        }
+        ClearPostProcessSurface(pOriginalScreenSurface);
+        if (!bPostProcessError)
+        {
+            ClearPostProcessSurface(pPostProcessSurface);
+            ClearPostProcessSurface(pSmallPostProcessSurface);
+            ClearPostProcessSurface(pSmallPostProcessSurface2);
+        }
+        SetCommonStates();
+    };
+
+    releasePresentation();
+    d3dpp.BackBufferWidth = nextSize.width;
+    d3dpp.BackBufferHeight = nextSize.height;
+    screen_size = {nextSize.width, nextSize.height};
+    if (FAILED(d3d9->Reset(&d3dpp)))
+    {
+        d3dpp = oldPresent;
+        screen_size = oldScreenSize;
+        if (SUCCEEDED(d3d9->Reset(&d3dpp)))
+            restorePresentation();
+        else
+            core.stopFrameProcessing();
+        if (!restoreWindow())
+            core.stopFrameProcessing();
+        return false;
+    }
+    restorePresentation();
+    bWindow = nextWindowed;
+    desktopMode = nextDesktopMode;
+
+    if (StormMetalApplyGraphicsSettings(d3d9, flagsMask, shadowQuality))
+        return true;
+
+    releasePresentation();
+    d3dpp = oldPresent;
+    screen_size = oldScreenSize;
+    bWindow = oldWindowed;
+    desktopMode = oldDesktopMode;
+    if (SUCCEEDED(d3d9->Reset(&d3dpp)))
+        restorePresentation();
+    else
+        core.stopFrameProcessing();
+    if (!restoreWindow())
+        core.stopFrameProcessing();
+    return false;
 #endif
 }
 
