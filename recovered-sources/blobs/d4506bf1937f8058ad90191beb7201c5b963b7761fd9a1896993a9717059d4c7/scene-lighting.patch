 #include "c_vector4.h"
 #include "shared/messages.h"
+#ifdef STORM_METAL_DYNAMIC_LIGHTING_BRIDGE
+#include <cstring>
+extern "C" void StormMetalLandLocation(void*, bool);
+extern "C" bool StormMetalResolveLandLighting(void*);
+// Resolve after outdoor geometry (default/9) and characters (20), before
+// legacy character shadows (900) and blended overlays. Interior model priorities
+// differ (65538 etc.), so those keep their original lighting and shadow pipeline.
+class MetalLandLighting : public Entity {
+public:
+    ATTRIBUTES* locationAttributes = nullptr;
+    VDX9RENDER* renderer = nullptr;
+    bool Init() override { return true; }
+    void ProcessStage(Stage stage, uint32_t) override {
+        if (!renderer) return;
+        if (stage == Stage::execute) {
+            const char* type = locationAttributes ? locationAttributes->GetAttribute("type") : nullptr;
+            const bool outdoor = type && (!std::strcmp(type,"town") || !std::strcmp(type,"jungle") || !std::strcmp(type,"shore"));
+            StormMetalLandLocation(renderer->GetD3DDevice(), outdoor);
+        } else if (stage == Stage::realize) {
+            StormMetalResolveLandLighting(renderer->GetD3DDevice());
+        }
+    }
+};
+CREATE_CLASS(MetalLandLighting)
+#endif
