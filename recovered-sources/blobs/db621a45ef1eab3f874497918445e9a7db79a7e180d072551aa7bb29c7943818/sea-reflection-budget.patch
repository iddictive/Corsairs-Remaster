diff --git a/src/libs/sea/src/sea.h b/src/libs/sea/src/sea.h
--- a/src/libs/sea/src/sea.h
+++ b/src/libs/sea/src/sea.h
@@ -95,6 +95,13 @@ class SEA : public SEA_BASE
 
     bool bSimpleSea;
 
+    // The sun-road cube contains only distant illumination and may be updated
+    // incrementally.  The environment cube contains moving ships and islands;
+    // all of its authored faces must come from one camera frame or the reflected
+    // hull tears sideways while the camera moves.
+    uint32_t sunRoadFace = 0, reflectionFrame = 0;
+    bool sunRoadPrimed = false, reflectionUnderSea = false;
+
     SeaVertex *pVSea;
     uint16_t *pTriangles;
     uint32_t *pIndices;
diff --git a/src/libs/sea/src/sea.cpp b/src/libs/sea/src/sea.cpp
--- a/src/libs/sea/src/sea.cpp
+++ b/src/libs/sea/src/sea.cpp
@@ -1355,12 +1355,21 @@ void SEA::Realize(uint32_t dwDeltaTime)
     if (vCamPos.y < 0.0f)
         bUnderSea = true;
 
-    if (vCamPos.y < WaveXZ(vCamPos.x, vCamPos.z && bStarted))
+    if (bStarted && vCamPos.y < WaveXZ(vCamPos.x, vCamPos.z))
         bUnderSea = true;
 
     if (!bUnderSea)
         bUnderSeaStarted = false;
 
+    ++reflectionFrame;
+    // The negative-Y face is intentionally omitted above water. A waterline
+    // transition changes that face set, so reprime both persistent cube maps.
+    if (reflectionUnderSea != bUnderSea)
+    {
+        reflectionUnderSea = bUnderSea;
+        sunRoadPrimed = false;
+    }
+
     if (bSimpleSea)
     {
         EnvMap_Render2();
@@ -2012,5 +2019,6 @@ void SEA::LostRender()
 void SEA::LostRender()
 {
+    sunRoadPrimed = false;
     rs->Release(pReflection);
     rs->Release(pReflectionSunroad);
     rs->Release(pEnvMap);
diff --git a/src/libs/sea/src/env_map.cpp b/src/libs/sea/src/env_map.cpp
--- a/src/libs/sea/src/env_map.cpp
+++ b/src/libs/sea/src/env_map.cpp
@@ -53,7 +53,9 @@ bool SEA::SunRoad_Render2()
 
     // rs->SetProjection( CMatrix().BuildProjectionMatrix(PI / 2.0f, 256.0f, 256.0f, 1.0f, 4000.0f) );
 
-    auto PlaneHeight = 0.5f;
+    // The planar pass must mirror around the same animated surface sampled by
+    // ships and the visible sea, in the same world-coordinate origin.
+    const auto PlaneHeight = WaveXZ(vCamPos.x, vCamPos.z);
 
     const Vector point(0, PlaneHeight, 0), normal(0, 1, 0);
     auto mPlane = Plane(normal, point);
@@ -129,7 +131,7 @@ bool SEA::EnvMap_Render2()
 
     // rs->SetProjection( CMatrix().BuildProjectionMatrix(PI / 2.0f, 256.0f, 256.0f, 1.0f, 4000.0f) );
 
-    auto PlaneHeight = 0.5f;
+    const auto PlaneHeight = WaveXZ(vCamPos.x, vCamPos.z);
 
     const Vector point(0, PlaneHeight, 0), normal(0, 1, 0);
     auto mPlane = Plane(normal, point);
@@ -216,7 +216,12 @@ bool SEA::SunRoad_Render()
     rs->SetProjection(CMatrix().BuildProjectionMatrix(PI / 2.0f, 256.0f, 256.0f, 1.0f, 4000.0f));
 
     uint32_t Colors[6] = {0xd934c8, 0x2FFF1F, 0x0000FF, 0xFF00, 0xb28e11, 0x0};
-    for (uint32_t i = 0; i < 6; i++)
+    // This target contains only distant sun-road illumination. Prime it once,
+    // then amortize it independently of the coherent dynamic environment cube.
+    const bool refresh = !sunRoadPrimed || (reflectionFrame & 1u) != 0;
+    const uint32_t firstFace = sunRoadPrimed ? sunRoadFace : 0;
+    const uint32_t endFace = !refresh ? firstFace : (sunRoadPrimed ? sunRoadFace + 1 : 6);
+    for (uint32_t i = firstFace; i < endFace; i++)
     {
         if (!bUnderSea && i == D3DCUBEMAP_FACE_NEGATIVE_Y)
             continue;
@@ -260,6 +266,17 @@ bool SEA::SunRoad_Render()
         rs->EndScene();
     }
 
+    if (refresh)
+    {
+        if (!sunRoadPrimed)
+            sunRoadPrimed = true;
+        do
+        {
+            sunRoadFace = (sunRoadFace + 1) % 6;
+        }
+        while (!bUnderSea && sunRoadFace == D3DCUBEMAP_FACE_NEGATIVE_Y);
+    }
+
     rs->PopRenderTarget();
     rs->SetView(mOldView);
     rs->SetProjection(mOldProjection);
