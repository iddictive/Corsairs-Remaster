+
+bool ShipWalk::IsCollisionMan(const ShipMan &man) const
+{
+    return !man.inWater && man.mode != MAN_OFF && man.mode != MAN_JUMP && man.mode != MAN_SWIM &&
+           man.mode != MAN_CLIMB_UP && man.mode != MAN_CLIMB_DOWN;
+}
+
+bool ShipWalk::CanPlaceMan(const ShipMan &man, const CVECTOR &offset) const
+{
+    if (!ship || !shipModel)
+        return true;
+
+    const CVECTOR current = man.pos + man.spos;
+    const CVECTOR candidate = man.pos + offset;
+    auto &matrix = *ship->GetMatrix();
+
+    // Do not let an avoidance correction cross solid ship detail at body height.
+    const float traceLow = shipModel->Trace(matrix * (current + CVECTOR(0.f, .35f, 0.f)),
+                                            matrix * (candidate + CVECTOR(0.f, .35f, 0.f)));
+    const float traceHigh = shipModel->Trace(matrix * (current + CVECTOR(0.f, 1.1f, 0.f)),
+                                             matrix * (candidate + CVECTOR(0.f, 1.1f, 0.f)));
+    if (traceLow < 1.f || traceHigh < 1.f)
+        return false;
+
+    // The offset is cosmetic; accept it only while the same deck supports the feet.
+    const float floor = shipModel->Trace(matrix * (candidate + CVECTOR(0.f, .4f, 0.f)),
+                                         matrix * (candidate - CVECTOR(0.f, .6f, 0.f)));
+    return floor <= 1.f;
+}
+
+bool ShipWalk::TryMoveAside(ShipMan &man, const CVECTOR &delta)
+{
+    return TrySetAside(man, man.spos + delta);
+}
+
+bool ShipWalk::TrySetAside(ShipMan &man, CVECTOR candidate)
+{
+    const float lengthSq = candidate.x * candidate.x + candidate.z * candidate.z;
+    if (lengthSq > MAX_AVOID_OFFSET * MAX_AVOID_OFFSET)
+    {
+        const float scale = MAX_AVOID_OFFSET / sqrtf(lengthSq);
+        candidate.x *= scale;
+        candidate.z *= scale;
+    }
+    if (!CanPlaceMan(man, candidate))
+        return false;
+    man.spos = candidate;
+    return true;
+}
+
+bool ShipWalk::ResolveDeckCharacter(SeaDeckCharacterCollisionQuery &query)
+{
+    query.resolved = query.desired;
+    query.blocked = 0;
+    deckCharacter_.active = 0;
+    if (!query.active || bHide)
+        return true;
+
+    const CVECTOR movement = query.desired - query.from;
+    const float a = movement.x * movement.x + movement.z * movement.z;
+    float accepted = 1.f;
+    for (const auto &man : shipMan)
+    {
+        if (!IsCollisionMan(man))
+            continue;
+        const CVECTOR center = man.pos + man.spos;
+        const float queryLow = std::min(query.from.y, query.desired.y);
+        const float queryHigh = std::max(query.from.y, query.desired.y) + std::max(0.f, query.height);
+        if (center.y > queryHigh || center.y + CREW_HEIGHT < queryLow)
+            continue;
+        if (fabsf(query.from.y - center.y) > MAX_COLLISION_FOOT_DELTA &&
+            fabsf(query.desired.y - center.y) > MAX_COLLISION_FOOT_DELTA)
+            continue;
+
+        const float radius = std::max(0.f, query.radius) + CREW_RADIUS;
+        const float ox = query.from.x - center.x;
+        const float oz = query.from.z - center.z;
+        const float c = ox * ox + oz * oz - radius * radius;
+        if (a < 0.000001f)
+            continue;
+        if (c < 0.f)
+        {
+            // A crewman moved onto the accepted foot position. Keep that position
+            // stable and allow only motion which increases separation.
+            const float endX = query.desired.x - center.x;
+            const float endZ = query.desired.z - center.z;
+            if (endX * endX + endZ * endZ < ox * ox + oz * oz)
+                accepted = 0.f;
+            continue;
+        }
+
+        const float b = 2.f * (ox * movement.x + oz * movement.z);
+        const float discriminant = b * b - 4.f * a * c;
+        if (discriminant < 0.f)
+            continue;
+        const float hit = (-b - sqrtf(discriminant)) / (2.f * a);
+        if (hit >= 0.f && hit <= accepted)
+            accepted = std::max(0.f, hit - .01f / sqrtf(a));
+    }
+
+    if (accepted < 1.f)
+    {
+        query.resolved = query.from + movement * accepted;
+        query.blocked = 1;
+    }
+    deckCharacter_ = query;
+    deckCharacter_.resolved = query.resolved;
+    deckCharacter_.active = 1;
+    return true;
 }
 
