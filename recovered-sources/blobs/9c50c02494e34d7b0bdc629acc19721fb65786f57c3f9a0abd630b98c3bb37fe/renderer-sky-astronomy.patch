+                                          float scaleX, float scaleY);
+
+// The Metal renderer has no fixed-function point-sprite stage, so the star quads
+// travel through the shared billboard bridge.  The twinkling pass below refreshes
+// this CPU mirror of the star color buffer with exactly the alpha it writes.
+static std::vector<RS_RECT> aMetalStarRects;
+#endif
 
 Astronomy::STARS::STARS()
 {
@@ -295,6 +306,9 @@
             fTmpRnd[n] = 0.8f + FRAND(0.2f);
         auto *pVColors = static_cast<uint32_t *>(pRS->LockVertexBuffer(iVertexBufferColors, D3DLOCK_DISCARD));
         auto size = aStars.size();
+#ifdef STORM_METAL_RENDERER_CONSUMERS
+        aMetalStarRects.resize(size);
+#endif
         for (uint32_t i = 0; i < size; i++)
         {
             auto &s = aStars[i];
@@ -304,10 +318,39 @@
 
             uint32_t dwAlpha = ftoi(fAlpha);
             pVColors[i] = (dwAlpha << 24L) | s.dwColor;
+#ifdef STORM_METAL_RENDERER_CONSUMERS
+            auto &r = aMetalStarRects[i];
+            r.vPos = fRadius * s.vPos;
+            r.fSize = fSize;
+            r.fAngle = 0.0f;
+            r.dwColor = (dwAlpha << 24L) | s.dwColor;
+            r.dwSubTexture = 0;
+#endif
         }
         pRS->UnLockVertexBuffer(iVertexBufferColors);
     }
 
+#ifdef STORM_METAL_RENDERER_CONSUMERS
+    // The stars reach the Metal renderer through the live billboard bridge that
+    // already serves rain, planets and the sun/moon glow.  The rects keep the
+    // camera-relative sky position and the twinkling alpha written above, the
+    // WORLD transform carries the camera position and the technique pass keeps the
+    // stars alpha/blend contract, exactly as the legacy point-sprite path applied
+    // them.  That path stays the compatibility owner for the non-Metal build.
+    CMatrix mStarWorld;
+    mStarWorld.BuildPosition(vCamPos.x, vCamPos.y, vCamPos.z);
+    pRS->SetTransform(D3DTS_WORLD, mStarWorld);
+    pRS->TextureSet(0, iTexture);
+    if (!aMetalStarRects.empty() && pRS->TechniqueExecuteStart("stars"))
+        do
+        {
+            StormMetalDrawBillboards(pRS->GetD3DDevice(), aMetalStarRects.data(),
+                                      static_cast<uint32_t>(aMetalStarRects.size()), "stars", 1, 1, 1.0f,
+                                      pRS->GetHeightDeformator());
+        } while (pRS->TechniqueExecuteNext());
+    return;
+#endif
+
     pRS->SetRenderState(D3DRS_POINTSPRITEENABLE, true);
     pRS->SetRenderState(D3DRS_POINTSCALEENABLE, true);
     pRS->SetRenderState(D3DRS_POINTSIZE, F2DW(fSize));
