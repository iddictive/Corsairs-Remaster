+bool GEOM_SERVICE_R::SkipBakedShadowLayer(const GEOS::MATERIAL &mt) const
+{
+#ifdef STORM_METAL_DYNAMIC_LIGHTING_BRIDGE
+    // Most authored receivers combine their base texture with shadow.tga in
+    // slot 1 and must remain drawable with that stage neutralized. A small
+    // standalone receiver class has shadow.tga in slot 0; skip only that class
+    // while the dynamic sun shadow is ready. Real town files do not reliably
+    // label either class through group_name.
+    return (mt.stormMetalBakedShadowMask & 1u) != 0 &&
+        StormMetalOutdoorSunShadowsReady(RenderService->GetD3DDevice());
+#else
+    return false;
+#endif
+}
