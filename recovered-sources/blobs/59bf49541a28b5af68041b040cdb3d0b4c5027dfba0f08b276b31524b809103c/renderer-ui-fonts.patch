diff --git a/src/libs/renderer/src/s_device.cpp b/src/libs/renderer/src/s_device.cpp
--- a/src/libs/renderer/src/s_device.cpp
+++ b/src/libs/renderer/src/s_device.cpp
@@ -682,3 +682,7 @@ DX9RENDER::~DX9RENDER()
 
     S_RELEASE(rectsVBuffer, 8);
+    if (spritesVBuffer >= 0)
+        ReleaseVertexBuffer(spritesVBuffer);
+    if (spritesIBuffer >= 0)
+        ReleaseIndexBuffer(spritesIBuffer);
 
@@ -3544,28 +3548,51 @@ void DX9RENDER::DrawSprites(RS_SPRITE *pRSS, uint32_t dwSpritesNum, const char *c
     if (dwSpritesNum == 0)
         return;
 
-    auto *pIndices = new uint16_t[dwSpritesNum * 6];
+    // Four vertices per sprite keep the caller-authored XYZRHW, diffuse alpha,
+    // and UV contract. Persistent D3D buffers let the Metal device consume the
+    // batch through its native buffer-backed draw path instead of UP expansion.
+    if (dwSpritesNum > 16383)
+    {
+        core.Trace("DrawSprites batch exceeds 16-bit index capacity: %u", dwSpritesNum);
+        return;
+    }
+    if (dwSpritesNum > spritesBufferCapacity)
+    {
+        if (spritesVBuffer >= 0)
+            ReleaseVertexBuffer(spritesVBuffer);
+        if (spritesIBuffer >= 0)
+            ReleaseIndexBuffer(spritesIBuffer);
+        spritesBufferCapacity = 1;
+        while (spritesBufferCapacity < dwSpritesNum)
+            spritesBufferCapacity *= 2;
+        spritesVBuffer = CreateVertexBuffer(RS_SPRITE_VERTEX_FORMAT,
+                                            spritesBufferCapacity * 4 * sizeof(RS_SPRITE),
+                                            D3DUSAGE_DYNAMIC | D3DUSAGE_WRITEONLY);
+        spritesIBuffer = CreateIndexBuffer(spritesBufferCapacity * 6 * sizeof(uint16_t),
+                                           D3DUSAGE_WRITEONLY);
+        if (spritesVBuffer < 0 || spritesIBuffer < 0)
+        {
+            core.Trace("DrawSprites could not allocate native buffers");
+            return;
+        }
+        auto *indices = static_cast<uint16_t *>(LockIndexBuffer(spritesIBuffer));
+        for (i = 0; i < spritesBufferCapacity; i++)
+        {
+            indices[i * 6 + 0] = static_cast<uint16_t>(i * 4 + 0);
+            indices[i * 6 + 1] = static_cast<uint16_t>(i * 4 + 3);
+            indices[i * 6 + 2] = static_cast<uint16_t>(i * 4 + 2);
+            indices[i * 6 + 3] = static_cast<uint16_t>(i * 4 + 0);
+            indices[i * 6 + 4] = static_cast<uint16_t>(i * 4 + 2);
+            indices[i * 6 + 5] = static_cast<uint16_t>(i * 4 + 1);
+        }
+        UnLockIndexBuffer(spritesIBuffer);
+    }
 
-    for (i = 0; i < dwSpritesNum; i++)
-    {
-        pIndices[i * 6 + 0] = static_cast<uint16_t>(i * 4 + 0);
-        pIndices[i * 6 + 1] = static_cast<uint16_t>(i * 4 + 3);
-        pIndices[i * 6 + 2] = static_cast<uint16_t>(i * 4 + 2);
-        pIndices[i * 6 + 3] = static_cast<uint16_t>(i * 4 + 0);
-        pIndices[i * 6 + 4] = static_cast<uint16_t>(i * 4 + 2);
-        pIndices[i * 6 + 5] = static_cast<uint16_t>(i * 4 + 1);
-    }
-
-    SetFVF(RS_SPRITE_VERTEX_FORMAT);
-
-    bool bDraw = true;
-    if (cBlockName && cBlockName[0])
-        bDraw = TechniqueExecuteStart(cBlockName);
-    if (bDraw)
-        do
-        {
-            DrawIndexedPrimitiveUP(D3DPT_TRIANGLELIST, 0, dwSpritesNum * 4, dwSpritesNum * 2, pIndices, D3DFMT_INDEX16,
-                                   pRSS, sizeof(RS_SPRITE));
-        } while (cBlockName && TechniqueExecuteNext());
-    delete[] pIndices;
+    auto *vertices = static_cast<RS_SPRITE *>(LockVertexBuffer(spritesVBuffer, D3DLOCK_DISCARD));
+    if (!vertices)
+        return;
+    memcpy(vertices, pRSS, dwSpritesNum * 4 * sizeof(RS_SPRITE));
+    UnLockVertexBuffer(spritesVBuffer);
+    DrawBuffer(spritesVBuffer, sizeof(RS_SPRITE), spritesIBuffer, 0, dwSpritesNum * 4, 0,
+               dwSpritesNum * 2, cBlockName);
 }

