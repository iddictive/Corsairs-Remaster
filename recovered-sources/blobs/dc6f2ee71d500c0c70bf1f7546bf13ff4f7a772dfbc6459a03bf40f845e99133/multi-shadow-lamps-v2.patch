+bool Lights::GetShadowLightNear(const CVECTOR& pos, unsigned ordinal, uint64_t& id, D3DLIGHT9& light)
+{
+    std::vector<std::pair<float, int32_t>> candidates;
+    for (int32_t index=0; index<numLights; ++index) {
+        const auto& source=lights[index]; const auto& type=types[source.type];
+        if(type.dxLight.Type!=D3DLIGHT_POINT || type.dxLight.Range<=.1f)continue;
+        const float intensity=source.intensity/255.f;
+        const float r=source.color.r*intensity,g=source.color.g*intensity,b=source.color.b*intensity;
+        if(r<=0 && g<=0 && b<=0)continue;
+        const float dx=pos.x-source.pos.x,dy=pos.y-source.pos.y,dz=pos.z-source.pos.z;
+        const float distanceSquared=dx*dx+dy*dy+dz*dz;
+        if(distanceSquared>=type.dxLight.Range*type.dxLight.Range)continue;
+        candidates.emplace_back(distanceSquared,index);
+    }
+    std::sort(candidates.begin(),candidates.end());
+    if(ordinal>=candidates.size()){id=0;return false;}
+    const int32_t index=candidates[ordinal].second; const auto& source=lights[index]; const auto& type=types[source.type];
+    light=type.dxLight; light.Position=source.pos; const float intensity=source.intensity/255.f;
+    light.Diffuse.r=source.color.r*intensity; light.Diffuse.g=source.color.g*intensity; light.Diffuse.b=source.color.b*intensity;
+    id=uint64_t(index)+1; return true;
+}
