+        pStore.Goods.Darts.TradeType = Store_DartsTradeType(pStore);
+        return;
+    }
+    if (!CheckAttribute(pStore, "Colony")) return;
+    if (FindColony(pStore.Colony) < 0) return;
+    Store_InitDarts(pStore);
+}
