+void VANT_BASE::SetNormals(VANTVERTEX *v) const
+{
+    const CVECTOR plane = riggingUnitNormal((v[2].pos - v[0].pos) ^ (v[1].pos - v[0].pos),
+                                           (v[4].pos - v[3].pos) ^ (v[5].pos - v[3].pos));
+    for (int i = 0; i < 7; ++i) v[i].norm = plane;
+    v += 7;
+    for (int i = 0; i < 6; ++i) v[i].norm = CVECTOR(0.f);
+    constexpr int beamFaces[8][3] = {{0,1,2},{3,4,5},{0,3,4},{0,4,1},
+                                   {0,2,3},{3,2,5},{2,4,5},{1,4,2}};
+    const CVECTOR center = (v[0].pos + v[1].pos + v[2].pos + v[3].pos + v[4].pos + v[5].pos) / 6.f;
+    for (const auto &face : beamFaces)
+    {
+        CVECTOR normal = (v[face[1]].pos - v[face[0]].pos) ^ (v[face[2]].pos - v[face[0]].pos);
+        const CVECTOR outward = (v[face[0]].pos + v[face[1]].pos + v[face[2]].pos) / 3.f - center;
+        if ((normal | outward) < 0.f) normal = -normal;
+        for (int index : face) v[index].norm += normal;
+    }
+    for (int i = 0; i < 6; ++i) v[i].norm = riggingUnitNormal(v[i].norm);
+    v += 6;
+    const int downOffset = (VANT_EDGE + 1) * ROPE_QUANT;
+    for (int i = 0; i < ROPE_QUANT; ++i, v += VANT_EDGE + 1)
+    {
+        CVECTOR center(0.f);
+        for (int j = 0; j < VANT_EDGE; ++j) center += v[j].pos;
+        center /= float(VANT_EDGE);
+        for (int j = 0; j < VANT_EDGE; ++j)
+        {
+            const CVECTOR tangent = v[j + downOffset].pos - v[j].pos;
+            const CVECTOR around = v[(j + 1) % VANT_EDGE].pos - v[(j + VANT_EDGE - 1) % VANT_EDGE].pos;
+            CVECTOR normal = riggingUnitNormal(around ^ tangent, v[j].pos - center);
+            if ((normal | (v[j].pos - center)) < 0.f) normal = -normal;
+            v[j].norm = v[j + downOffset].norm = normal;
+        }
+        v[VANT_EDGE].norm = v[0].norm;
+        v[downOffset + VANT_EDGE].norm = v[downOffset].norm;
     }
 }
 
