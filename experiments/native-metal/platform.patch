+WindowSize SDLWindow::GetDrawableSize() const
+{
+    int w = 0;
+    int h = 0;
+#if defined(__APPLE__)
+    SDL_Metal_GetDrawableSize(window_.get(), &w, &h);
+#else
+    SDL_GetWindowSize(window_.get(), &w, &h);
+#endif
+    if (w <= 0 || h <= 0)
+        return GetWindowSize();
+    return {w, h};
+}
+
+WindowSize SDLWindow::GetDesktopSize() const
+{
+    const int display = SDL_GetWindowDisplayIndex(window_.get());
+    SDL_DisplayMode mode{};
+    if (display < 0 || SDL_GetDesktopDisplayMode(display, &mode) != 0 || mode.w <= 0 || mode.h <= 0)
+        return {};
+    return {mode.w, mode.h};
+}
+
 bool SDLWindow::Fullscreen() const
 {
     return fullscreen_;
