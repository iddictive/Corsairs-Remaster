+// Below-horizon gate for the unclipped billboard paths (overflow, flares,
+// sea reflection). The disc and halo rect are geometrically clipped at sea
+// level by DrawRect and need no fade. Ramps across civil twilight so the
+// sunset glow dies continuously instead of popping at the horizon.
+static float SunElevationFade(const CVECTOR &vSunPos)
+{
+    const CVECTOR vDir = !vSunPos;
+    const auto fSine = vDir.y < -1.f ? -1.f : (vDir.y > 1.f ? 1.f : vDir.y);
+    return CLAMP((asinf(fSine) + 0.12f) / 0.14f);
+}
+
