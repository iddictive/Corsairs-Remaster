+#pragma once
+#include <algorithm>
+#include <cmath>
+
+namespace storm::ship::phonk
+{
+constexpr float speedBoost = 20.f;
+constexpr float yawBoost = 2.1f;
+inline float yawSpeed(float stock, float turn)
+{
+    return std::clamp(turn, -1.f, 1.f) * std::clamp(stock * yawBoost, .42f, .70f);
+}
+
+struct Velocity { float x = 0.f, z = 0.f; };
+// Momentum keeps its world heading while the hull turns beneath it. Speed still
+// follows the engine's propulsion/impulses; traction gradually realigns travel.
+// TOUCH snapshots/restores this transient owner with its predicted ship State.
+struct Drift
+{
+    bool initialized = false;
+    float heading = 0.f, lastSideways = 0.f;
+    void reset() { *this = {}; }
+    Velocity speed(bool allowed, float turn, float forward, float sideways,
+                   float yaw, float seconds, bool consume)
+    {
+        if (!allowed || !std::isfinite(turn) || !std::isfinite(forward) ||
+            !std::isfinite(sideways) || !std::isfinite(yaw) || forward <= 0.f)
+        {
+            if (consume) reset();
+            return {};
+        }
+        const float target = yaw + std::atan2(sideways, forward);
+        float next = initialized ? heading : target;
+        // Existing lateral collision impulses turn momentum immediately, before
+        // the softer tyre-like traction. Propulsion speed reductions are likewise
+        // immediate through magnitude, preventing momentum through a stopped hull.
+        if (initialized && sideways != lastSideways)
+        {
+            const float magnitude = std::hypot(forward, lastSideways);
+            const float impulse = sideways - lastSideways;
+            next = std::atan2(std::sin(next) * magnitude + std::cos(yaw) * impulse,
+                              std::cos(next) * magnitude - std::sin(yaw) * impulse);
+        }
+        const float dt = std::isfinite(seconds) ? std::clamp(seconds, 0.f, .1f) : 0.f;
+        const float traction = .6f - .42f * std::clamp(std::abs(turn), 0.f, 1.f);
+        next += std::remainder(target - next, 6.28318530718f) * -std::expm1(-traction * dt);
+        if (consume) { initialized = true; heading = next; lastSideways = sideways; }
+        const float magnitude = std::hypot(forward, sideways);
+        const float slip = next - yaw;
+        return {std::sin(slip) * magnitude - sideways,
+                std::cos(slip) * magnitude - forward};
+    }
+};
+inline float pulse(float seconds)
+{
+    return std::isfinite(seconds) ? .85f + .15f * std::sin(seconds * 7.539822369f) : 0.f;
+}
+} // namespace storm::ship::phonk
