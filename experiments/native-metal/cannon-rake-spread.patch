+float SAIL::Pick(const CVECTOR &src, const CVECTOR &dst, entid_t excludeShip, entid_t &hitShip)
+{
+    float nearest = 2.f;
+    hitShip = 0;
+    if (!bUse) return nearest;
+    for (int i = 0; i < groupQuantity; ++i)
+    {
+        const auto &group = gdata[i];
+        if (group.bDeleted || group.shipEI == excludeShip) continue;
+        if (!manual_aim::segmentBox(src, dst, group.boxCenter - group.boxSize, group.boxCenter + group.boxSize))
+            continue;
+        for (int j = 0; j < group.sailQuantity; ++j)
+        {
+            const float fraction = slist[group.sailIdx[j]]->Trace(src, dst, false);
+            if (std::isfinite(fraction) && fraction >= 0.f && fraction <= 1.f && fraction < nearest)
+            {
+                nearest = fraction;
+                hitShip = group.shipEI;
+            }
+        }
+    }
+    return nearest;
+}
