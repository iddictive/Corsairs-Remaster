+void SHIP::InitializeShipFire()
+{
+    shipFire = {}; fireSails.clear(); fireStepClock = fireCheckpointClock = 0.f;
+    firePendingHull = firePendingCrew = 0.f;
+    fireVisualSeconds=fireClothClock=0.f;fireRunning=false;fireStateDirty=false;firePendingOwner=-1;
+    auto *model = GetModel();
+    // Authored hull locators remain useful audio anchors. The extra samples are
+    // admitted only by the existing hull mesh ray, never by a replacement mesh.
+    for (std::size_t i=0; i<aFirePlaces.size() && shipFire.count<16; ++i) {
+        const auto p=aFirePlaces[i].GetLocalPos();
+        shipFire.add(p.x,p.y,p.z,2.2f);
+    }
+    const float radius=std::clamp(State.vBoxSize.x*.18f,1.4f,3.5f);
+    for (int z=0;z<6 && shipFire.count<28;++z) for (int side=-1;side<=1;side+=2) {
+        const float x=side*State.vBoxSize.x*.31f, fz=State.vBoxSize.z*(float(z)/5.f-.5f)*.78f;
+        const CVECTOR a=model->mtx*CVECTOR(x,State.vBoxSize.y*.55f+2.f,fz);
+        const CVECTOR b=model->mtx*CVECTOR(x,-State.vBoxSize.y*.5f-2.f,fz);
+        const float t=model->Trace(a,b);
+        if (t>=0.f && t<=1.f) {
+            CVECTOR p; model->mtx.MulToInv(a+(b-a)*t,p);
+            const auto nearest=shipFire.nearest(p.x,p.y,p.z);
+            if (nearest<shipFire.count) {
+                const auto &c=shipFire.cells[nearest];
+                const float dx=c.x-p.x,dy=c.y-p.y,dz=c.z-p.z;
+                if (dx*dx+dy*dy+dz*dz<2.f) continue;
+            }
+            shipFire.add(p.x,p.y,p.z,radius);
+        }
+    }
+    // Derive each cloth cell from its actual authored corners, keyed by the
+    // same node/group pair used by saved sail holes and the repair owner.
+    for (uint32_t n=0; auto *node=model->GetNode(n); ++n) {
+        if (!node->geo) continue;
+        GEOS::INFO info; node->geo->GetInfo(info);
+        for (int l=0;l<info.nlabels;++l) {
+            GEOS::LABEL label; node->geo->GetLabel(l,label);
+            if (strncmp(label.name,"sail",4) || label.name[4]<'1' || label.name[4]>'4' ||
+                strlen(label.group_name)<6) continue;
+            const int group=atoi(label.group_name+5);
+            auto link=std::find_if(fireSails.begin(),fireSails.end(),[&](const FireSailLink &s) {
+                return s.node==node->GetName() && s.group==group;
+            });
+            if (link==fireSails.end()) {
+                if (fireSails.size()==16) continue;
+                fireSails.push_back({}); link=fireSails.end()-1;
+                link->node=node->GetName(); link->group=group;
+            }
+            const CVECTOR p(label.m[3][0],label.m[3][1],label.m[3][2]);
+            link->center+=p; ++link->corners;
+            link->radius=std::max(link->radius,sqrtf(~p));
+        }
+    }
+    for (auto &link:fireSails) {
+        link.center*=1.f/std::max(1u,link.corners);
+        auto *node=model->FindNode(link.node.c_str()); CVECTOR p;
+        model->mtx.MulToInv(node->glob_mtx*link.center,p);
+        // Radius is recomputed from the real corners instead of node distance.
+        float r=1.f; GEOS::INFO info; node->geo->GetInfo(info);
+        for (int l=0;l<info.nlabels;++l) {
+            GEOS::LABEL label; node->geo->GetLabel(l,label);
+            if (!strncmp(label.name,"sail",4) && label.name[4]>='1' && label.name[4]<='4' &&
+                strlen(label.group_name)>=6 && atoi(label.group_name+5)==link.group)
+                r=std::max(r,sqrtf(~(CVECTOR(label.m[3][0],label.m[3][1],label.m[3][2])-link.center)));
+        }
+        link.cell=shipFire.add(p.x,p.y,p.z,std::clamp(r*.55f,1.2f,6.f),true);
+    }
+    auto *state=GetACharacter()->FindAClass(GetACharacter(),"Ship.FireState");
+    const bool saved=state && state->GetAttributeAsDword("schema")==1 &&
+        state->GetAttribute("model") && !strcmp(state->GetAttribute("model"),cShipIniName);
+    if (saved) {
+        const auto savedCount=std::min<std::size_t>(storm_ship_fire::MaxPoints,state->GetAttributeAsDword("count"));
+        for (std::size_t i=0;i<savedCount;++i) {
+            char path[40]; snprintf(path,sizeof(path),"cells.p%zu",i);
+            auto *a=state->FindAClass(state,path); if (!a) continue;
+            if (i>=shipFire.count) shipFire.add(a->GetAttributeAsFloat("x"),a->GetAttributeAsFloat("y"),
+                a->GetAttributeAsFloat("z"),a->GetAttributeAsFloat("radius",2.f),a->GetAttributeAsDword("cloth")!=0);
+            shipFire.restore(i,a->GetAttributeAsFloat("heat"),a->GetAttributeAsFloat("fuel",1.f),
+                a->GetAttributeAsFloat("charred"),a->GetAttributeAsFloat("burned"),int32_t(a->GetAttributeAsDword("owner",uint32_t(-1))));
+        }
+        shipFire.seconds=state->GetAttributeAsFloat("seconds");
+        fireVisualSeconds=state->GetAttributeAsFloat("visualSeconds",shipFire.seconds);
+        firePendingHull=state->GetAttributeAsFloat("pendingHull");
+        firePendingCrew=state->GetAttributeAsFloat("pendingCrew");
+        firePendingOwner=int32_t(state->GetAttributeAsDword("pendingOwner",uint32_t(-1)));
+        for (auto &link:fireSails) {
+            char path[40];snprintf(path,sizeof(path),"cells.p%zu",link.cell);
+            if (auto *a=state->FindAClass(state,path)) link.lastDamage=a->GetAttributeAsFloat("lastSailDamage");
+        }
+    } else {
+        // A historical binary fireplace is converted once. Its saved bytes and
+        // field order are unchanged; the attribute schema prevents reinjection.
+        for (auto &place:aFirePlaces) if (place.isActive()) {
+            const auto p=place.GetLocalPos(); const auto i=shipFire.nearest(p.x,p.y,p.z);
+            shipFire.ignite(i,.65f,place.GetBallCharacterIndex());
+        }
+    }
+    SaveShipFire();
+    auto *summary=GetACharacter()->FindAClass(GetACharacter(),"Ship.FireState");
+    uint32_t active=0;float intensity=0.f,heat=0.f;
+    for (std::size_t i=0;i<shipFire.count;++i) {
+        const auto &c=shipFire.cells[i];if (c.intensity()>.025f) ++active;
+        intensity=std::max(intensity,c.intensity());heat=std::max(heat,c.heat);
+    }
+    summary->SetAttributeUseDword("active",active);summary->SetAttributeUseFloat("duty",0.f);
+    summary->SetAttributeUseFloat("intensity",intensity);summary->SetAttributeUseFloat("heat",heat);
+}
