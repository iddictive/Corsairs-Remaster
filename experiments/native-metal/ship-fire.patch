+std::vector<StormMetalShipFirePoint> SHIP::ShipFirePoints() const
+{
+    std::vector<StormMetalShipFirePoint> points;points.reserve(shipFire.count);
+    for (std::size_t i=0;i<shipFire.count;++i) {
+        const auto &c=shipFire.cells[i];if (!c.available || (c.heat<=.01f && c.charred<=.001f)) continue;
+        points.push_back({{c.x,c.y,c.z},c.radius,c.intensity(),c.charred,c.heat,float(i)*17.31f+float(uniIDX)*.71f});
+    }
+    return points;
+}
