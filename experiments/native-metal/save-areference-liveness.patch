@@ -3,6 +3,27 @@
 #include "string_compare.hpp"
 #include "platform/platform.hpp"
 
+#include <mutex>
+#include <unordered_set>
+
+namespace
+{
+std::mutex liveAttributesMutex;
+std::unordered_set<const ATTRIBUTES *> liveAttributes;
+
+void RegisterLiveAttribute(const ATTRIBUTES *attributes)
+{
+    std::lock_guard lock(liveAttributesMutex);
+    liveAttributes.insert(attributes);
+}
+
+void UnregisterLiveAttribute(const ATTRIBUTES *attributes)
+{
+    std::lock_guard lock(liveAttributesMutex);
+    liveAttributes.erase(attributes);
+}
+}
+
 ATTRIBUTES::ATTRIBUTES(VSTRING_CODEC *p): ATTRIBUTES(*p)
 {
 }
