       attributes_(std::move(other.attributes_)), break_(other.break_)
 {
+    RegisterLiveAttribute(this);
 }
 
 ATTRIBUTES & ATTRIBUTES::operator=(ATTRIBUTES &&other) noexcept
@@ -28,9 +50,18 @@ ATTRIBUTES & ATTRIBUTES::operator=(ATTRIBUTES &&other) noexcept
 
 ATTRIBUTES::~ATTRIBUTES()
 {
+    UnregisterLiveAttribute(this);
     Release();
 }
 
+bool ATTRIBUTES::IsLive(const ATTRIBUTES *attributes) noexcept
+{
+    if (attributes == nullptr)
+        return false;
+    std::lock_guard lock(liveAttributesMutex);
+    return liveAttributes.contains(attributes);
+}
