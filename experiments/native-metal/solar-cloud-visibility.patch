+bool PrepareMetalAtmosphere(VDX9RENDER *renderer, WEATHER_BASE *weather, uint32_t deltaTime, bool skyDraw)
+{
+    if (!weather)
+        return false;
+    const auto rain = weather->GetVisualRainIntensity();
+    CVECTOR visualSun;
+    weather->GetVisualVector(whv_sun_pos, &visualSun);
+    const auto prepare = skyDraw ? StormMetalBeginDynamicSky : StormMetalPrepareDynamicSky;
+    return prepare(renderer->GetD3DDevice(), weather->GetVisualFloat(whf_time_counter),
+                                       static_cast<float>(deltaTime) * 0.001f, 0.32f + rain * 0.58f,
+                                       0.48f + rain * 0.45f,
