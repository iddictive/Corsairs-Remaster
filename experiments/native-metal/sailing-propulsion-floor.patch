+
+// Main-character sail controls are authoritative: its AI task is not a helm
+// command. NPC drift must block assistance immediately, before the delayed
+// speed-controller tick lowers its sails (including internal/group drift).
+bool IsShipSailingFloorBlocked(ATTRIBUTES *character)
+{
+    if (character->GetAttributeAsDword("MainCharacter", 0) != 0)
+        return false;
+    auto *ship = AIShip::FindShip(character);
+    return !ship || ship->GetTaskController()->GetCurrentTask()->dwTaskType == AITASK_DRIFT;
+}
