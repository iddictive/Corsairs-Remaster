+                qv[x + y * 32].u1 = qv[x + y * 32].u0;
+                qv[x + y * 32].v1 = qv[x + y * 32].v0;
+                qv[x + y * 32].u2 = qv[x + y * 32].u0;
+                qv[x + y * 32].v2 = qv[x + y * 32].v0;
+                qv[x + y * 32].u3 = qv[x + y * 32].u0;
+                qv[x + y * 32].v3 = qv[x + y * 32].v0;
             }
         }
