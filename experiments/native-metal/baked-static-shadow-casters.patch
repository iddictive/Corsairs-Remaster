+bool Location::HasBakedStaticEnvironment()
+{
+    // Any static model may provide an atlas whose silhouettes describe other
+    // static models, so this is a location-level producer decision.
+    for (int32_t i = 0; i < model.Models(); ++i) {
+        auto* entity = model[i];
+        if (entity && entity->HasBakedBaseShadow()) return true;
+    }
+    return false;
+}
 
