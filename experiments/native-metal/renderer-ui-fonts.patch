diff --git a/src/libs/renderer/src/font.cpp b/src/libs/renderer/src/font.cpp
--- a/src/libs/renderer/src/font.cpp
+++ b/src/libs/renderer/src/font.cpp
@@ -1,5 +1,6 @@
 #include "font.h"
 #include "core.h"
+#include "metal_renderer_consumers.h"
 #include "storm/config.hpp"
 #include "utf8.h"
 
@@ -373,8 +374,58 @@
     const bool drawShadows = overrides.shadow.value_or(drawShadows_);
     const float scale = overrides.scale.value_or(scale_);
     const uint32_t color = overrides.color.value_or(color_);
+#ifdef STORM_METAL_RENDERER_CONSUMERS
+    auto makeGlyphs = [&](int32_t originX, int32_t originY, uint32_t glyphColor,
+                          std::vector<StormMetalGlyphInstance> &glyphs) {
+        float xoffset = 0.f;
+        const int byteCount = strlen(data_PTR);
+        for (int i = 0; i < byteCount; i += utf8::u8_inc(data_PTR + i))
+        {
+            const int codepoint = utf8::Utf8ToCodepoint(data_PTR + i);
+            if (codepoint > USED_CODES)
+                continue;
+            FLOAT_RECT pos = charDescriptors_[codepoint].Pos;
+            if (scale != 1.f)
+            {
+                pos.x1 *= scale;
+                pos.x2 *= scale;
+                pos.y1 *= scale;
+                pos.y2 *= scale;
+            }
+            float kernLeft = bUseKerning ? charDescriptors_[codepoint].kern_l * scale : 0.f;
+            float kernRight = bUseKerning ? charDescriptors_[codepoint].kern_r * scale : 0.f;
+            OffsetFRect(pos, static_cast<float>(originX) + xoffset - kernLeft,
+                        static_cast<float>(originY));
+            xoffset += pos.x2 - pos.x1 - kernLeft - kernRight + symbolInterval_ * scale;
+            if (codepoint == ' ')
+            {
+                xoffset += spacebarWidth_ * scale;
+                continue;
+            }
+            const FLOAT_RECT uv = charDescriptors_[codepoint].Tuv;
+            glyphs.push_back({pos.x1, pos.y1, pos.x2, pos.y2, uv.x1, uv.y1, uv.x2, uv.y2, glyphColor});
+        }
+        return static_cast<int32_t>(xoffset);
+    };
+    std::vector<StormMetalGlyphInstance> glyphs;
+    glyphs.reserve(s_num);
     if (drawShadows)
     {
+        makeGlyphs(x + shadowOffsetX_, y + shadowOffsetY_, color, glyphs);
+        device_.SetRenderState(D3DRS_SRCBLEND, D3DBLEND_ZERO);
+        device_.SetRenderState(D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA);
+        StormMetalDrawGlyphInstances(renderService_.GetD3DDevice(), glyphs.data(),
+                                     static_cast<uint32_t>(glyphs.size()), 0.5f, scale);
+        glyphs.clear();
+    }
+    xoffset = makeGlyphs(x, y, color, glyphs);
+    device_.SetRenderState(D3DRS_SRCBLEND, D3DBLEND_SRCALPHA);
+    device_.SetRenderState(D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA);
+    StormMetalDrawGlyphInstances(renderService_.GetD3DDevice(), glyphs.data(),
+                                 static_cast<uint32_t>(glyphs.size()), 0.5f, scale);
+#else
+    if (drawShadows)
+    {
         UpdateVertexBuffer(x + shadowOffsetX_, y + shadowOffsetY_, data_PTR, s_num, scale, color);
 
         device_.SetRenderState(D3DRS_SRCBLEND, D3DBLEND_ZERO);
@@ -386,6 +435,7 @@
     device_.SetRenderState(D3DRS_SRCBLEND, D3DBLEND_SRCALPHA);
     device_.SetRenderState(D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA);
     device_.DrawPrimitive(D3DPT_TRIANGLELIST, 0, s_num * 2);
+#endif
     while (renderService_.TechniqueExecuteNext())
         ;
 

