+    }
+    float waterGap(const CVECTOR &p) const
+    { return p.y-(sea?sea->WaveXZ(p.x,p.z):0.f); }
+    AimHit trace(const CVECTOR &a,const CVECTOR &b,int onlySurface=-1) const
+    {
