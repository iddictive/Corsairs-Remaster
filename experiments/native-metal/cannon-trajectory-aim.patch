+    std::sort(triangles.begin(),triangles.end(),[](const Tri &a,const Tri &b){return a.depth>b.depth;});
+    vertices.clear();for(const auto &t:triangles)vertices.insert(vertices.end(),t.v.begin(),t.v.end());
+    CMatrix old;AIHelper::pRS->GetTransform(D3DTS_WORLD,old);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD,CMatrix());
+    AIHelper::pRS->DrawPrimitiveUP(D3DPT_TRIANGLELIST,D3DFVF_XYZ|D3DFVF_DIFFUSE,
+        uint32_t(vertices.size()/3),vertices.data(),sizeof(AimVertex),technique);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD,old);
+}
+} // namespace
+
+bool AIShipCannonController::ManualGunCanReach(const AICannon &gun,const AISHIP_BORT &bort,
+                                              const CVECTOR &target) const
+{
+    if(gun.isDamaged())return false;
+    const CVECTOR muzzle=gun.GetPos();
+    const float speed=GetSpeedV0();
+    if(!manual_aim::reachable(muzzle,target,speed,AIHelper::fGravity))return false;
+    const CVECTOR direction=!(target-muzzle);
+    if((direction|gun.GetDir())<.3f)return false; // identical traverse guard to AICannon::Fire
+    const float elevation=gun.CalcHeightFireAngle(speed,muzzle,target);
+    const float relative=elevation-GetBortHeightAngle(bort);
+    return std::isfinite(elevation) && relative>=bort.fFireAngMin-1e-4f && relative<=bort.fFireAngMax+1e-4f;
+}
+
+bool AIShipCannonController::BuildManualAimSolution(const CVECTOR &camera,const CVECTOR &direction,
+                                                   MANUAL_AIM_SOLUTION &solution)
+{
+    solution=MANUAL_AIM_SOLUTION{};
+    if(!manual_aim::finite(camera)||!manual_aim::finite(direction)||~direction<1e-8f||GetSpeedV0()<=0.f)return false;
+    CVECTOR flat(direction.x,0.f,direction.z);
+    if(~flat<1e-8f)return false;
+    flat=!flat;
+    CVECTOR selection=GetAIShip()->GetPos()+flat;selection.y=0.f;
+    auto bort=GetFirstFireBort(selection);
+    if(!IsValid(bort))return false;
+    solution.bort=&*bort;
+    const float speed=GetSpeedV0();
+    // Pick real geometry independently of camera pitch. Empty/far space is
+    // explicit far intent, never a short horizontal-muzzle-angle shot.
+    float range=0.f,commonFar=1e20f;int compatible=0;
+    std::vector<std::pair<CVECTOR,float>> legalRangeDisks;
+    const float roll=GetBortHeightAngle(*bort);
+    for(const auto &gun:bort->aCannons)
+    {
+        if(gun.isDamaged() || (flat|gun.GetDir())<.3f)continue;
+        const CVECTOR muzzle=gun.GetPos();
+        const float angle=manual_aim::maximumRangeElevation(muzzle.y,speed,
+            roll+bort->fFireAngMin,roll+bort->fFireAngMax,AIHelper::fGravity);
+        const float reach=AICannon::CalcMaxFireDistance(std::max(.01f,muzzle.y),speed,angle);
+        range=std::max(range,reach);
+        legalRangeDisks.push_back({muzzle,reach});
+        if(!manual_aim::farRayLimit(camera,muzzle,flat,reach,commonFar))return false;
+        ++compatible;
+    }
+    if(!compatible||!std::isfinite(range)||range<=0.f||commonFar<=0.f)return false;
+    // Float range construction can sit a few ulps outside the double-precision
+    // reach discriminant at the optimum. Move only the synthetic far boundary
+    // inward by a centimeter-scale margin; real surface targets are untouched.
+    commonFar-=std::max(.01f,commonFar*1e-5f);
+    if(commonFar<=0.f)return false;
+    AimWorld world(GetAIShip());
+    const float pickLength=range+(camera-GetAIShip()->GetPos()).GetLength()+world.waveBound;
+    const auto hit=world.trace(camera,camera+(!direction)*pickLength);
+    if(hit.valid)
+    {
+        // A real nearby unreachable hit remains unavailable; do not redirect
+        // its shot to a convenient distant target behind the first receiver.
+        solution.target=hit.point;
+    }
+    else
+    {
+        // Camera/muzzle parallax matters: intersect every compatible muzzle's
+        // legal range disk with the camera bearing, and use the common limit.
+        // This stays far through mast gaps and into sky without a sticky lock,
+        // fake ship collision or range loss when raising the camera.
+        solution.target=CVECTOR(camera.x,0.f,camera.z)+flat*commonFar;
+    }
+    solution.character=hit.character;
+    for(auto &gun:bort->aCannons)
+        if(ManualGunCanReach(gun,*bort,solution.target))solution.guns.push_back(&gun);
+    if(solution.guns.empty()&&hit.valid)
+    {
+        // A genuinely distant receiver inside the extended camera query is far
+        // intent too. A near hit outside depression/elevation limits is NOT.
+        const bool beyondEveryRange=std::all_of(legalRangeDisks.begin(),legalRangeDisks.end(),
+            [&](const auto &disk)
+            {const CVECTOR d(solution.target.x-disk.first.x,0.f,solution.target.z-disk.first.z);
+             return d.GetLength()>disk.second+.001f;});
+        if(beyondEveryRange)
+        {
+            solution.target=CVECTOR(camera.x,0.f,camera.z)+flat*commonFar;
+            solution.character=nullptr;
+            for(auto &gun:bort->aCannons)
+                if(ManualGunCanReach(gun,*bort,solution.target))solution.guns.push_back(&gun);
+        }
+    }
+    return !solution.guns.empty(); // near mechanically impossible shots stay unavailable
+}
+
+void AIShipCannonController::DrawManualAimOverlay(const CVECTOR &direction,const CVECTOR &camera)
+{
+    MANUAL_AIM_SOLUTION solution;
+    if(!BuildManualAimSolution(camera,direction,solution))return;
+    AimWorld world(GetAIShip());
+    const float speed=GetSpeedV0(),height=AimHeightScale(GetAIShip()->GetACharacter());
+    const auto spread=AimLiveSpread(GetAIShip()->GetACharacter());
+    std::vector<AimPath> paths;
+    std::vector<std::pair<const AICannon *,AimPath>> nominalPaths;
+    paths.reserve(solution.guns.size()+40);
+    // Every valid gun participates. Locator order is irrelevant.
+    for(const auto *gun:solution.guns)
+    {
+        const CVECTOR muzzle=gun->GetPos();
+        const float angle=gun->CalcHeightFireAngle(speed,muzzle,solution.target);
+        const auto path=AimMarch(manual_aim::trajectory(muzzle,solution.target,speed,angle,0.f,height,AIHelper::fGravity),world);
+        paths.push_back(path);nominalPaths.push_back({gun,path});
+    }
+    // Dispersion samples use the battery's spatial support guns, not first/last
+    // array indices. Model traces are bounded by this fixed support set; all
+    // remaining gun trajectories above still define the envelope's mouth.
+    std::vector<const AICannon *> supports;
+    CVECTOR axis=GetBortDirection(*solution.bort);
+    axis=!(CVECTOR(axis.x,0.f,axis.z));
+    const CVECTOR lateral(-axis.z,0.f,axis.x);
+    for(const CVECTOR &basis:{lateral,CVECTOR(0.f,1.f,0.f)})
+        for(float sign:{-1.f,1.f})
+        {
+            const AICannon *best=nullptr;float value=-1e20f;
+            for(const auto *gun:solution.guns)
+            {const float v=(gun->GetPos()|basis)*sign;if(v>value){value=v;best=gun;}}
+            if(best&&std::find(supports.begin(),supports.end(),best)==supports.end())supports.push_back(best);
+        }
+    for(const auto *gun:supports)
+    {
+        const CVECTOR muzzle=gun->GetPos();
+        const float angle=gun->CalcHeightFireAngle(speed,muzzle,solution.target);
+        for(int n=0;n<8;++n)
+        {
+            // Live jitter uses three independent random draws, not a correlated
+            // ellipse. Include all eight support corners without consuming RNG.
+            const float elevation=spread.elevation*((n&1)?1.f:-1.f);
+            const float yaw=spread.azimuth*((n&2)?1.f:-1.f);
+            const float v=speed+spread.speed*((n&4)?1.f:-1.f);
+            paths.push_back(AimMarch(manual_aim::trajectory(muzzle,solution.target,v,angle+elevation,yaw,height,AIHelper::fGravity),world));
+        }
+    }
+    paths.erase(std::remove_if(paths.begin(),paths.end(),[](const AimPath &p){return !p.hit.valid||p.end<=0.f;}),paths.end());
+    if(paths.empty())return;
+    const bool ready=solution.bort->isCharged();
+    // Contact field in LAUNCH space, not an ellipse on an XZ or hull-normal
+    // plane. Every vertex owns a real muzzle and a valid jittered trajectory.
+    // Through a hull/mast gap the same projectile continues until its first
+    // real receiver, including the animated sea behind the gap.
+    std::vector<AimVertex> footprint;
+    std::vector<const AICannon *> projectors=supports;
+    CVECTOR meanMuzzle(0.f);
+    for(const auto *gun:solution.guns)meanMuzzle+=gun->GetPos();
+    meanMuzzle*=1.f/solution.guns.size();
+    const AICannon *middle=solution.guns.front();
+    for(const auto *gun:solution.guns)
+        if(~(gun->GetPos()-meanMuzzle)<~(middle->GetPos()-meanMuzzle))middle=gun;
+    if(std::find(projectors.begin(),projectors.end(),middle)==projectors.end())projectors.push_back(middle);
+    // Retain a receiver found only by a non-support gun (for example the one
+    // muzzle aligned with a small opening). Add one local field per otherwise
+    // unrepresented receiver, rather than uniformly densifying every cannon.
+    std::vector<int> represented;
+    for(const auto &[gun,path]:nominalPaths)
+        if(path.hit.valid && std::find(projectors.begin(),projectors.end(),gun)!=projectors.end())
+            represented.push_back(path.hit.surface);
+    for(const auto &[gun,path]:nominalPaths)
+        if(path.hit.valid && std::find(represented.begin(),represented.end(),path.hit.surface)==represented.end())
+        {projectors.push_back(gun);represented.push_back(path.hit.surface);}
+    // Five regular projectors plus explicit receiver exceptions. Each uses a
+    // 3x3 angular grid, four cell centers and16 fan-validation centers (29
+    // required samples). Each of four cells then has16 detail +8 local-patch
+    // samples reserved independently: at most125 marches per projector.
+    // A difficult earlier cell cannot consume any later cell's coverage.
+    // Model broadphase and above-wave rejection remain active in each march.
+    constexpr int divisions=2;
+    auto relationColor=[&](const AimHit &hit)
+    {
+        if(!hit.character)return uint32_t(0xCDD4D6u);
+        const auto relation=Helper.GetRelation(GetAIShip()->GetACharacter(),hit.character);
+        if(relation==RELATION_ENEMY)return uint32_t(0xCCA29Cu);
+        if(relation==RELATION_FRIEND)return uint32_t(0xA8C4ADu);
+        if(relation==RELATION_NEUTRAL)return uint32_t(0xCFC398u);
+        return uint32_t(0xCDD4D6u);
+    };
+    struct ContactVertex {AimHit hit;float alpha=0.f,yaw=0.f,elevation=0.f;};
+    struct ContactSupport
+    {
+        int surface;
+        std::array<AimPath,6> paths{};
+        std::array<float,6> values{{-1e20f,-1e20f,-1e20f,-1e20f,-1e20f,-1e20f}};
+    };
+    std::vector<ContactSupport> contactSupports;
+    const CVECTOR vertical=!(axis^lateral);
+    auto retainContact=[&](const AimPath &path)
+    {
+        if(!path.hit.valid||path.end<=0.f)return;
+        auto it=std::find_if(contactSupports.begin(),contactSupports.end(),
+            [&](const ContactSupport &support){return support.surface==path.hit.surface;});
+        if(it==contactSupports.end()){contactSupports.push_back(ContactSupport{path.hit.surface});it=contactSupports.end()-1;}
+        const std::array<CVECTOR,3> bases{{axis,lateral,vertical}};
+        for(int coordinate=0;coordinate<3;++coordinate)
+            for(int side=0;side<2;++side)
+            {
+                const int slot=coordinate*2+side;
+                const float value=(path.hit.point|bases[coordinate])*(side?1.f:-1.f);
+                if(value>it->values[slot]){it->values[slot]=value;it->paths[slot]=path;}
+            }
+    };
+    const float layerScale=1.f/std::max(size_t(1),projectors.size());
+    for(const auto *gun:projectors)
+    {
+        const CVECTOR muzzle=gun->GetPos();
+        const float angle=gun->CalcHeightFireAngle(speed,muzzle,solution.target);
+        struct CachedContact {float yaw,elevation;ContactVertex vertex;};
+        std::vector<CachedContact> cache;
+        manual_aim::ContactBudget<divisions*divisions> budget;
+        int activeCell=-1;
+        bool rescuePhase=false;
+        auto sample=[&](float yaw,float elevation)
+        {
+            for(const auto &entry:cache)
+                if(entry.yaw==yaw&&entry.elevation==elevation)return entry.vertex;
+            // Mandatory shared samples are prefetched with activeCell=-1.
+            // Optional work has an independent16+8 budget for each cell.
+            if(!budget.take(activeCell,rescuePhase))return ContactVertex{};
+            const auto curve=manual_aim::trajectory(muzzle,solution.target,speed,
+                angle+spread.elevation*elevation,spread.azimuth*yaw,height,AIHelper::fGravity);
+            const auto path=AimMarch(curve,world);
+            retainContact(path);
+            // Color/coverage is sampled here. Final opacity is evaluated once
+            // against the unified corridor contour after its loft is complete;
+            // individual gun-field borders never receive their own bright rim.
+            const float alpha=.04f*layerScale*(ready?1.f:.65f);
+            const ContactVertex vertex{path.hit,alpha,yaw,elevation};
+            cache.push_back({yaw,elevation,vertex});
+            return vertex;
+        };
+        std::array<std::array<ContactVertex,divisions+1>,divisions+1> grid{};
+        for(int y=0;y<=divisions;++y)
+            for(int x=0;x<=divisions;++x)
+                grid[y][x]=sample(-1.f+2.f*x/divisions,-1.f+2.f*y/divisions);
+        // Reserve all base centers AND solid-fan validation centers before
+        // optional recursion. A difficult early hole cannot erase later cells.
+        for(int y=0;y<divisions;++y)
+            for(int x=0;x<divisions;++x)
+            {
+                const float x0=-1.f+2.f*x/divisions,x1=-1.f+2.f*(x+1)/divisions;
+                const float y0=-1.f+2.f*y/divisions,y1=-1.f+2.f*(y+1)/divisions;
+                const float xm=(x0+x1)*.5f,ym=(y0+y1)*.5f;
+                sample(xm,ym);
+                sample((x0+x1+xm)/3.f,(y0+y0+ym)/3.f);
+                sample((x1+x1+xm)/3.f,(y0+y1+ym)/3.f);
+                sample((x1+x0+xm)/3.f,(y1+y1+ym)/3.f);
+                sample((x0+x0+xm)/3.f,(y1+y0+ym)/3.f);
+            }
+        auto triangle=[&](auto &&self,const ContactVertex &a,const ContactVertex &b,const ContactVertex &c,int depth,bool boundary,bool waveOnly=false)->void
+        {
+            const auto &ha=a.hit,&hb=b.hit,&hc=c.hit;
+            if(!ha.valid||!hb.valid||!hc.valid)return;
+            if(ha.surface!=hb.surface||ha.surface!=hc.surface)
+            {
+                // A newly found gap receiver must grow into its own patch,
+                // not vanish because the parent triangle has ship/water corners.
+                if(depth<3 && budget.remaining(activeCell)>=7)
+                {
+                    const auto ab=sample((a.yaw+b.yaw)*.5f,(a.elevation+b.elevation)*.5f);
+                    const auto bc=sample((b.yaw+c.yaw)*.5f,(b.elevation+c.elevation)*.5f);
+                    const auto ca=sample((c.yaw+a.yaw)*.5f,(c.elevation+a.elevation)*.5f);
+                    // Reserve all children's validation samples before recursing.
+                    sample((a.yaw+ab.yaw+ca.yaw)/3.f,(a.elevation+ab.elevation+ca.elevation)/3.f);
+                    sample((ab.yaw+b.yaw+bc.yaw)/3.f,(ab.elevation+b.elevation+bc.elevation)/3.f);
+                    sample((ca.yaw+bc.yaw+c.yaw)/3.f,(ca.elevation+bc.elevation+c.elevation)/3.f);
+                    sample((ab.yaw+bc.yaw+ca.yaw)/3.f,(ab.elevation+bc.elevation+ca.elevation)/3.f);
+                    self(self,a,ab,ca,depth+1,true);self(self,ab,b,bc,depth+1,true);
+                    self(self,ca,bc,c,depth+1,true);self(self,ab,bc,ca,depth+1,true);
+                }
+                else if(depth<5)
+                {
+                    const bool old=rescuePhase;rescuePhase=true;
+                    const auto center=sample((a.yaw+b.yaw+c.yaw)/3.f,(a.elevation+b.elevation+c.elevation)/3.f);
+                    const float du=std::max({std::fabs(a.yaw-b.yaw),std::fabs(b.yaw-c.yaw),std::fabs(c.yaw-a.yaw)})*.125f;
+                    const float dv=std::max({std::fabs(a.elevation-b.elevation),std::fabs(b.elevation-c.elevation),std::fabs(c.elevation-a.elevation)})*.125f;
+                    manual_aim::contactPatch(center,du,dv,sample,[&](const auto &x,const auto &y,const auto &z)
+                    {self(self,x,y,z,depth+1,true);});
+                    rescuePhase=old;
+                }
+                return;
+            }
+            if(footprint.size()>=48000)return; // <=16k receiver triangles, independent of wave detail
+            const CVECTOR ab=hb.point-ha.point,ac=hc.point-ha.point,bc=hc.point-hb.point;
+            if(!waveOnly)
+            {
+                // Same receiver and endpoint normals do not prove a triangle
+                // lies on a recessed hull or a terrain valley. Its launch-space
+                // center must follow the original shot path to that surface too.
+                const auto middle=sample((a.yaw+b.yaw+c.yaw)/3.f,(a.elevation+b.elevation+c.elevation)/3.f);
+                if(!middle.hit.valid)return; // budget exhaustion never fabricates a floating patch
+                const CVECTOR n=!(ab^ac);
+                const float error=std::fabs((middle.hit.point-(ha.point+hb.point+hc.point)/3.f)|n);
+                const float tolerance=.04f+((ha.point+hb.point+hc.point)/3.f-camera).GetLength()*.0002f;
+                const bool different=middle.hit.surface!=ha.surface || (ha.surface!=0 && error>tolerance);
+                if(different)
+                {
+                    if(depth<2)
+                    {
+                        self(self,a,b,middle,depth+1,true);
+                        self(self,b,c,middle,depth+1,true);
+                        self(self,c,a,middle,depth+1,true);
+                    }
+                    return;
+                }
+            }
+            if(ha.surface==0 && world.sea)
+            {
+                auto midpoint=[&](const ContactVertex &x,const ContactVertex &y)
+                {
+                    ContactVertex m=x;m.hit.point=(x.hit.point+y.hit.point)*.5f;m.alpha=(x.alpha+y.alpha)*.5f;
+                    m.yaw=(x.yaw+y.yaw)*.5f;m.elevation=(x.elevation+y.elevation)*.5f;
+                    m.hit.point.y=world.sea->WaveXZ(m.hit.point.x,m.hit.point.z,&m.hit.normal);
+                    if(~m.hit.normal>1e-12f)m.hit.normal=!m.hit.normal;
+                    return m;
+                };
+                const auto ab=midpoint(a,b),bc=midpoint(b,c),ca=midpoint(c,a);
+                const float error=std::max({std::fabs(ab.hit.point.y-(ha.point.y+hb.point.y)*.5f),
+                    std::fabs(bc.hit.point.y-(hb.point.y+hc.point.y)*.5f),
+                    std::fabs(ca.hit.point.y-(hc.point.y+ha.point.y)*.5f)});
+                const float tolerance=.04f+((ha.point+hb.point+hc.point)/3.f-camera).GetLength()*.0002f;
+                const float longest=std::max({(ha.point-hb.point).GetLength(),(hb.point-hc.point).GetLength(),(hc.point-ha.point).GetLength()});
+                const int waveDepth=waveOnly?depth:0;
+                if(waveDepth<4 && (error>tolerance||longest>6.f))
+                {
+                    self(self,a,ab,ca,waveDepth+1,boundary,true);self(self,ab,b,bc,waveDepth+1,boundary,true);
+                    self(self,ca,bc,c,waveDepth+1,boundary,true);self(self,ab,bc,ca,waveDepth+1,boundary,true);return;
+                }
+                // Prefer a clipped footprint to a broad polygon floating across
+                // an unresolved storm crest/trough when the tessellation cap is met.
+                if(error>tolerance*2.f)return;
+            }
+            if((ha.normal|hb.normal)<.45f||(ha.normal|hc.normal)<.45f||(hb.normal|hc.normal)<.45f)return;
+            const float shortest=std::min({ab.GetLength(),ac.GetLength(),bc.GetLength()});
+            const float longest=std::max({ab.GetLength(),ac.GetLength(),bc.GetLength()});
+            if(longest>std::max(3.f,shortest*8.f))return;
+            if(std::fabs(ab|ha.normal)>std::max(.3f,ab.GetLength()*.4f) ||
+               std::fabs(ac|ha.normal)>std::max(.3f,ac.GetLength()*.4f))return;
+            if(~(ab^ac)<1e-10f)return;
+            const uint32_t rgb=relationColor(ha);
+            for(const auto *v:{&a,&b,&c})
+            {
+                // Alpha belongs to the continuous projected field, never to a
+                // tessellation cell/triangle. Shared vertices keep identical
+                // opacity, so internal mesh boundaries cannot become grid lines.
+                footprint.push_back({v->hit.point+v->hit.normal*kAimSurfaceLift,AimColor(v->alpha,rgb)});
+            }
+        };
+        auto cell=[&](auto &&self,float x0,float y0,float x1,float y1,
+                      const ContactVertex &a,const ContactVertex &b,const ContactVertex &c,const ContactVertex &d,
+                      int depth,bool boundary)->void
+        {
+            const float xm=(x0+x1)*.5f,ym=(y0+y1)*.5f;
+            const auto center=sample(xm,ym);
+            const int receiver=center.hit.valid?center.hit.surface:-1;
+            const bool mixed=!a.hit.valid||!b.hit.valid||!c.hit.valid||!d.hit.valid||
+                a.hit.surface!=receiver||b.hit.surface!=receiver||c.hit.surface!=receiver||d.hit.surface!=receiver;
+            if(mixed && depth<3 && budget.remaining(activeCell)>=8)
+            {
+                // Refine a detected hole/boundary in launch space. Each new
+                // sample marches through the gap, rather than raycasting down
+                // from a floating projector plane or connecting across it.
+                const auto ab=sample(xm,y0),bc=sample(x1,ym),cd=sample(xm,y1),da=sample(x0,ym);
+                // Reserve every child center before the first child can recurse
+                // and consume the remaining budget intended for its siblings.
+                sample((x0+xm)*.5f,(y0+ym)*.5f);
+                sample((xm+x1)*.5f,(y0+ym)*.5f);
+                sample((xm+x1)*.5f,(ym+y1)*.5f);
+                sample((x0+xm)*.5f,(ym+y1)*.5f);
+                self(self,x0,y0,xm,ym,a,ab,center,da,depth+1,true);
+                self(self,xm,y0,x1,ym,ab,b,bc,center,depth+1,true);
+                self(self,xm,ym,x1,y1,center,bc,c,cd,depth+1,true);
+                self(self,x0,ym,xm,y1,da,center,cd,d,depth+1,true);return;
+            }
+            if(mixed)
+            {
+                const bool old=rescuePhase;rescuePhase=true;
+                manual_aim::contactPatch(center,(x1-x0)*.125f,(y1-y0)*.125f,sample,
+                    [&](const auto &p,const auto &q,const auto &r){triangle(triangle,p,q,r,0,true);});
+                rescuePhase=old;
+            }
+            triangle(triangle,a,b,center,0,boundary||mixed);
+            triangle(triangle,b,c,center,0,boundary||mixed);
+            triangle(triangle,c,d,center,0,boundary||mixed);
+            triangle(triangle,d,a,center,0,boundary||mixed);
+        };
+        for(int y=0;y<divisions;++y)
+            for(int x=0;x<divisions;++x)
+            {
+                activeCell=y*divisions+x;
+                cell(cell,-1.f+2.f*x/divisions,-1.f+2.f*y/divisions,
+                    -1.f+2.f*(x+1)/divisions,-1.f+2.f*(y+1)/divisions,
+                    grid[y][x],grid[y][x+1],grid[y+1][x+1],grid[y+1][x],0,false);
+            }
+    }
+    // Include discovered gap-continuation supports BEFORE constructing the
+    // corridor. Otherwise a water footprint behind a hole could be detached
+    // from a volume that still stopped at the original sparse hull hits.
+    for(const auto &receiver:contactSupports)
+        for(const auto &path:receiver.paths)
+        {
+            const bool duplicate=std::any_of(paths.begin(),paths.end(),[&](const AimPath &old)
+            {return old.end==path.end && ~(old.curve.origin-path.curve.origin)<1e-10f &&
+                    ~(old.curve.velocity-path.curve.velocity)<1e-10f;});
+            if(path.hit.valid&&path.end>0.f&&!duplicate)paths.push_back(path);
+        }
+    const CVECTOR up=!(axis^lateral);
+    std::vector<float> stations;
+    float first=1e20f,last=-1e20f;
+    for(const auto &path:paths)
+    {
+        const float a=path.curve.origin|axis,b=path.hit.point|axis;
+        first=std::min({first,a,b});last=std::max({last,a,b});
+        stations.push_back(a);stations.push_back(b);
+        const float acceleration=path.curve.acceleration|axis;
+        if(std::fabs(acceleration)>1e-8f)
+        {
+            const float turn=-(path.curve.velocity|axis)/acceleration;
+            if(turn>0.f&&turn<path.end)
+            {
+                const float p=path.curve.at(turn)|axis;
+                stations.push_back(p);first=std::min(first,p);last=std::max(last,p);
+            }
+        }
+    }
+    for(int section=0;section<=kAimSections;++section)
+        stations.push_back(first+(last-first)*float(section)/kAimSections);
+    std::sort(stations.begin(),stations.end());
+    stations.erase(std::unique(stations.begin(),stations.end(),[](float a,float b){return std::fabs(a-b)<.005f;}),stations.end());
+    struct CorridorSection {float station;CVECTOR center;std::vector<manual_aim::Point> hull;};
+    std::vector<CorridorSection> sections;
+    for(float station:stations)
+    {
+        // Intersect all paths with the SAME downrange plane. Normalizing each
+        // gun by its own impact time would flatten distant and nearby hits into
+        // one fake end plane and reintroduce the crossed-sheet artifact.
+        CVECTOR center(0.f);std::vector<CVECTOR> points;
+        for(const auto &path:paths)
+        {
+            if(std::fabs(station-(path.curve.origin|axis))<.005f)
+            {points.push_back(path.curve.origin);center+=path.curve.origin;}
+            if(std::fabs(station-(path.hit.point|axis))<.005f)
+            {points.push_back(path.hit.point);center+=path.hit.point;}
+            for(float t:manual_aim::planeTimes(path.curve,axis,station,path.end))
+            {
+                const CVECTOR point=path.curve.at(t);
+                points.push_back(point);center+=point;
+            }
+        }
+        if(points.empty())continue;
+        center*=1.f/points.size();
+        // Keep the geometric center on the actual ordered station plane;
+        // endpoint epsilon merging must not perturb slab ordering.
+        center+=axis*(station-(center|axis));
+        const float u=std::clamp((station-first)/std::max(.01f,last-first),0.f,1.f);
+        std::vector<manual_aim::Point> plane;
+        for(const auto &p:points)
+        {
+            const CVECTOR d=p-center;const float x=d|lateral,y=d|up;
+            const float pad=.08f*(1.f-u);
+            for(int corner=0;corner<4;++corner)plane.push_back({x+((corner&1)?pad:-pad),y+((corner&2)?pad:-pad)});
+        }
+        const auto hull=manual_aim::hull(plane);
+        sections.push_back({station,center,hull});
+    }
+#ifdef STORM_METAL_AIM_VOLUME_BRIDGE
+    // These are analytic section boundaries, not renderable alpha walls.
+    // Preserve every true hull-edge normal in adjacent slabs, including the
+    // tilted thin broadside cases that fixed angular planes would inflate.
+    namespace gpu=storm::sea_ai::manual_aim;
+    std::vector<gpu::AimVolumeSection> densitySections;
+    std::vector<gpu::AimVolumePlane> densityPlanes;
+    bool densityValid=sections.size()>=2&&sections.size()<=gpu::maxVolumeSections;
+    for(size_t i=0;densityValid&&i<sections.size();++i)
+    {
+        const auto &section=sections[i];gpu::AimVolumeSection record{};
+        record.center[0]=section.center.x;record.center[1]=section.center.y;record.center[2]=section.center.z;
+        record.progress=std::clamp((section.station-first)/std::max(.01f,last-first),0.f,1.f);
+        record.firstPlane=uint32_t(densityPlanes.size());
+        for(const auto &point:section.hull)
+        {record.halfWidth=std::max(record.halfWidth,std::fabs(point.x)+.025f);record.halfHeight=std::max(record.halfHeight,std::fabs(point.y)+.025f);}
+        if(i+1<sections.size())
+        {
+            const float midpoint=(section.station+sections[i+1].station)*.5f;
+            const bool occupied=std::any_of(paths.begin(),paths.end(),[&](const AimPath &path)
+            {return !manual_aim::planeTimes(path.curve,axis,midpoint,path.end).empty();});
+            // Zero planes explicitly mean zero density, never an unbounded slab.
+            // Keep empty intervals empty even when no regular station fell in them.
+            if(!occupied){densitySections.push_back(record);continue;}
+            const auto planes=manual_aim::slabPlanes(section.hull,sections[i+1].hull);
+            if(planes.empty()||planes.size()>gpu::maxVolumePlanesPerSlab){densityValid=false;break;}
+            record.planeCount=uint32_t(planes.size());
+            for(const auto &plane:planes)
+                densityPlanes.push_back({plane.x,plane.y,plane.offset0,plane.offset1});
+        }
+        densitySections.push_back(record);
+    }
+    densityValid=densityValid&&densityPlanes.size()<=gpu::maxVolumePlanes;
+    if(densityValid)
+    {
+        const bool drawn=StormMetalDrawAimVolume(AIHelper::pRS->GetD3DDevice(),densitySections.data(),
+            uint32_t(densitySections.size()),densityPlanes.data(),uint32_t(densityPlanes.size()),
+            &axis.x,&lateral.x,&up.x,ready?1.f:.55f);
+        if(!drawn)
+        {
+            static bool reported=false;
+            if(!reported){core.Trace("Manual aim: soft-volume renderer unavailable; no polygon-wall fallback");reported=true;}
+        }
+    }
+    else
+    {
+        static bool reported=false;
+        if(!reported){core.Trace("Manual aim: density section/plane limits exceeded; no polygon-wall fallback");reported=true;}
+    }
+#endif
+
+    // One continuous weight field for the complete corridor, shared by every
+    // receiver and every projector. This is distance to the actual loft contour,
+    // not a grid-cell edge, a triangle edge or a separate gun's angular square.
+    auto contourDistance=[&](const CorridorSection &section,const CVECTOR &worldPoint)
+    {
+        const CVECTOR delta=worldPoint-section.center;
+        const manual_aim::Point p{delta|lateral,delta|up};
+        float best=1e20f;
+        for(size_t i=0;i<section.hull.size();++i)
+        {
+            const auto a=section.hull[i],b=section.hull[(i+1)%section.hull.size()];
+            const float x=b.x-a.x,y=b.y-a.y,length=x*x+y*y;
+            const float t=length>1e-12f?std::clamp(((p.x-a.x)*x+(p.y-a.y)*y)/length,0.f,1.f):0.f;
+            const float dx=p.x-a.x-t*x,dy=p.y-a.y-t*y;
+            best=std::min(best,std::sqrt(dx*dx+dy*dy));
+        }
+        return best;
+    };
+    for(auto &vertex:footprint)
+    {
+        if(sections.empty()){vertex.color&=0xFFFFFFu;continue;}
+        const float station=vertex.point|axis;
+        auto next=std::lower_bound(sections.begin(),sections.end(),station,
+            [](const CorridorSection &section,float value){return section.station<value;});
+        float distance;
+        if(next==sections.begin())distance=contourDistance(*next,vertex.point);
+        else if(next==sections.end())distance=contourDistance(sections.back(),vertex.point);
+        else
+        {
+            const auto &a=*(next-1),&b=*next;
+            const float t=std::clamp((station-a.station)/std::max(.001f,b.station-a.station),0.f,1.f);
+            distance=contourDistance(a,vertex.point)*(1.f-t)+contourDistance(b,vertex.point)*t;
+        }
+        const float width=.25f+(vertex.point-camera).GetLength()*.002f;
+        const float rim=std::exp(-distance*distance/(width*width));
+        const float alpha=(.04f+.14f*rim)*layerScale*(ready?1.f:.65f);
+        vertex.color=AimColor(alpha,vertex.color);
+    }
+    AimDraw(footprint,"ShipAimFootprint",camera);
+}
