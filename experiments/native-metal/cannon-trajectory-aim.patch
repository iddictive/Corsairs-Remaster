+
+namespace
+{
+// Manual sea-cannon aim overlay. Visualization only: no save, AI, damage,
+// reload or camera state changes.
+//
+// Ballistics replicate live fire exactly (same origin, same integration):
+// muzzle world pos (AICannon::GetPos, the same vPosTemp RealFire reports via
+// CANNON_FIRE), elevation from AICannon::CalcHeightFireAngle (the same call
+// RealFire makes), raw-angle tilt plus HeightMultiply applied exactly as
+// AIBalls::Execute integrates them, azimuth from the muzzle-to-target flat
+// direction (same atan2 convention as RealFire fFireDirection). Height
+// multiplier mirrors Ball_AddBall live (catalog 1.0 stock x 0.4 / 0.65
+// knippels by loaded charge). Preview impact matches the live impact of the
+// representative gun; the ellipse around it uses the same
+// SHIP_GET_BORT_FIRE_DELTA gunner model as Fire2Position.
+//
+// Projection: one soft powder-smoke ribbon along the representative arc
+// (middle intact gun of the firing broadside) plus a faint impact ellipse and
+// small brass aim accents. The ribbon is a stable horizontal band in the
+// firing plane, alpha-blended, depth-tested (ShipAimVolume), so hulls, masts,
+// sails and islands occlude it like any in-world object. Only the firing
+// broadside (GetFirstFireBort for the current camera ray) draws anything;
+// idle side and out-of-sector views emit zero geometry.
+//
+// Style: warm parchment smoke, muted aged brass, umber halo. Thin faint
+// layers, per-vertex alpha falloff. No neon, no hue-coded states: reloading
+// only dims the same palette.
+constexpr int32_t kAimArcSteps = 20;
+constexpr int32_t kAimRingSegments = 24;
+constexpr const char *kAimTechLine = "ShipAimArc";
+constexpr const char *kAimTechVolume = "ShipAimVolume";
+constexpr uint32_t kAimSmoke = 0xCBBFA8;
+constexpr uint32_t kAimBrass = 0xC8A96A;
+constexpr uint32_t kAimUmber = 0x2E2118;
+constexpr float kAimForwardDot = 0.5f;
+
+bool s_bAimFadeOwnShip = false;
+
+struct AimVolVertex
+{
+    CVECTOR vPos;
+    uint32_t dwColor;
+};
+
+inline uint32_t AimColor(uint32_t dwRgb, uint32_t dwAlpha)
+{
+    return (dwRgb & 0x00FFFFFFu) | ((dwAlpha & 0xFFu) << 24);
+}
+
+inline uint32_t AimFadeAlpha(int32_t dwA0, int32_t dwA1, int32_t i, int32_t n)
+{
+    const int32_t dwD = n > 0 ? n : 1;
+    return static_cast<uint32_t>(dwA0 + (dwA1 - dwA0) * i / dwD);
+}
+
+// One ballistic sample at time fTime. Mirrors AIBalls::Execute + RealFire.
+CVECTOR AimBallisticPoint(const CVECTOR &vMuzzle, float fSpeedV0, float fCosA, float fSinA, float fRawCos,
+                          float fRawSin, float fDirCos, float fDirSin, float fTime, float fHeightMultiply)
+{
+    const float fsX = fSpeedV0 * fTime * fCosA;
+    const float fsY = fSpeedV0 * fTime * fSinA - AIHelper::fGravity * fTime * fTime * 0.5f;
+    const float fProjX = fsX * fRawCos + fsY * fRawSin;
+    float fProjY = -fsX * fRawSin + fsY * fRawCos;
+    fProjY *= fHeightMultiply;
+    const float fX = fProjX * fRawCos - fProjY * fRawSin;
+    const float fY = fProjX * fRawSin + fProjY * fRawCos;
+    CVECTOR vPos(0.0f, fY, fX);
+    RotateAroundY(vPos.x, vPos.z, fDirCos, fDirSin);
+    vPos += vMuzzle;
+    return vPos;
+}
+
+// Raw elevation tilt, same computation as AICannon::RealFire.
+float AimRawAngle(const CVECTOR &vMuzzle, const CVECTOR &vTarget)
+{
+    const CVECTOR vEnemyDir = !(vTarget - vMuzzle);
+    const CVECTOR vFlatDir = !(CVECTOR(vTarget.x, vMuzzle.y, vTarget.z) - vMuzzle);
+    const float fDp = vFlatDir | vEnemyDir;
+    float fAngle;
+    if (fDp >= 1.0f)
+        fAngle = 0.0f;
+    else if (fDp <= -1.0f)
+        fAngle = PI;
+    else
+        fAngle = acosf(fDp);
+    if (vTarget.y < vMuzzle.y)
+        fAngle = -fAngle;
+    return fAngle;
+}
+
+void EmitAimRing(std::vector<RS_LINE> &lines, const CVECTOR &vCenter, float fRadius, uint32_t dwColor,
+                 int32_t dwSegments)
+{
+    CVECTOR vPrev(vCenter.x + fRadius, vCenter.y, vCenter.z);
+    for (int32_t i = 1; i <= dwSegments; ++i)
+    {
+        const float fAng = 6.2831853f * static_cast<float>(i) / static_cast<float>(dwSegments);
+        const CVECTOR vNext(vCenter.x + fRadius * cosf(fAng), vCenter.y, vCenter.z + fRadius * sinf(fAng));
+        lines.push_back(RS_LINE{vPrev, dwColor});
+        lines.push_back(RS_LINE{vNext, dwColor});
+        vPrev = vNext;
+    }
+}
+
+void EmitAimCross(std::vector<RS_LINE> &lines, const CVECTOR &vCenter, float fHalf, uint32_t dwColor)
+{
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x - fHalf, vCenter.y, vCenter.z), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x + fHalf, vCenter.y, vCenter.z), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x, vCenter.y, vCenter.z - fHalf), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x, vCenter.y, vCenter.z + fHalf), dwColor});
+}
+
+void FlushAimLines(std::vector<RS_LINE> &lines)
+{
+    if (lines.empty())
+        return;
+    CMatrix mWorld;
+    AIHelper::pRS->GetTransform(D3DTS_WORLD, mWorld);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, CMatrix());
+    AIHelper::pRS->DrawLines(lines.data(), static_cast<uint32_t>(lines.size() / 2), kAimTechLine);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, mWorld);
+}
+
+void FlushAimVolume(std::vector<AimVolVertex> &verts)
+{
+    if (verts.size() < 3)
+        return;
+    CMatrix mWorld;
+    AIHelper::pRS->GetTransform(D3DTS_WORLD, mWorld);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, CMatrix());
+    AIHelper::pRS->DrawPrimitiveUP(D3DPT_TRIANGLELIST, D3DFVF_XYZ | D3DFVF_DIFFUSE, verts.size() / 3, &verts[0],
+                                   sizeof(AimVolVertex), kAimTechVolume);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, mWorld);
+}
+
+bool AimBlocksOwnShip(const CVECTOR &vCamDir, const CVECTOR &vShipFwd)
+{
+    const CVECTOR vFlatC(vCamDir.x, 0.0f, vCamDir.z);
+    const CVECTOR vFlatF(vShipFwd.x, 0.0f, vShipFwd.z);
+    if (~vFlatC <= 1e-6f || ~vFlatF <= 1e-6f)
+        return false;
+    return ((!vFlatC) | (!vFlatF)) > kAimForwardDot;
+}
+} // namespace
+// Live height multiplier, mirroring AIBalls.c Ball_AddBall exactly: cannon
+// catalog HeightMultiply (1.0 for every stock cannon, cannons_init.c) times
+// 0.4 normal shot / 0.65 knippels, selected by the loaded charge. Charge.Type
+// is the numeric goods index (GOOD_KNIPPELS == 2, PROGRAM/store/goods.h), read
+// from the character exactly as the firing path does.
+constexpr uint32_t kAimKnippelsGoods = 2;
+
+float AimLiveHeightMultiply(ATTRIBUTES *pACharacter)
+{
+    if (pACharacter == nullptr)
+        return 0.4f;
+    auto *pACannons = pACharacter->FindAClass(pACharacter, "Ship.Cannons");
+    if (pACannons == nullptr)
+        return 0.4f;
+    const uint32_t dwCharge = pACannons->GetAttributeAsDword("Charge.Type", 0);
+    return dwCharge == kAimKnippelsGoods ? 0.65f : 0.4f;
+}
+
+void AIShipAimSetFadeOwnShip(bool bFade)
+{
+    s_bAimFadeOwnShip = bFade;
+}
+
+bool AIShipAimGetFadeOwnShip()
+{
+    return s_bAimFadeOwnShip;
+}
+void AIShipCannonController::DrawManualAimOverlay(const CVECTOR &vCamDir)
+{
+    // Own-ship fade gate, reported on every run (all early-outs below keep it).
+    // Player-only + first-person-only by construction: the sole caller runs for
+    // isMainCharacter() after the isCameraOutside() early return.
+    AIShipAimSetFadeOwnShip(AimBlocksOwnShip(vCamDir, !(GetAIShip()->GetMatrix()->Vz())));
+
+    // Idle side / out of sector: zero geometry.
+    if (!isCanFire(vCamDir))
+        return;
+
+    // Firing-solution target: max-range point along the camera ray, the same
+    // value manual Fire(vFireCamPos, vFireDir) converges to.
+    CVECTOR vTarget = GetFirePos(vCamDir);
+    auto bortIt = GetFirstFireBort(vTarget);
+    if (!IsValid(bortIt) || bortIt->aCannons.empty())
+        return;
+
+    const float fSpeedV0 = GetSpeedV0();
+    if (fSpeedV0 <= 0.0f)
+        return;
+
+    // Representative gun: middle intact cannon of the firing broadside only.
+    // One arc per broadside; per-gun lines are out by design (clutter).
+    const auto &cannons = bortIt->aCannons;
+    const AICannon *pMid = &cannons[cannons.size() / 2];
+    if (pMid->isDamaged())
+    {
+        pMid = nullptr;
+        for (const auto &cannon : cannons)
+            if (!cannon.isDamaged())
+            {
+                pMid = &cannon;
+                break;
+            }
+        if (pMid == nullptr)
+            return;
+    }
+    const CVECTOR vMuzzle = pMid->GetPos();
+
+    CVECTOR vAim = vTarget;
+    vAim.y = 0.0f;
+    const float fAngle = pMid->CalcHeightFireAngle(fSpeedV0, vMuzzle, vAim);
+    const float fRawAng = AimRawAngle(vMuzzle, vAim);
+    const CVECTOR vFlat(vAim.x - vMuzzle.x, 0.0f, vAim.z - vMuzzle.z);
+    if (~vFlat <= 0.0f)
+        return;
+    const float fFlatDist = sqrtf(~vFlat);
+    const float fDirAng = atan2f(vFlat.x, vFlat.z);
+    const float fDirCos = cosf(fDirAng);
+    const float fDirSin = sinf(fDirAng);
+    const float fCosA = cosf(fAngle);
+    const float fSinA = sinf(fAngle);
+    const float fRawCos = cosf(fRawAng);
+    const float fRawSin = sinf(fRawAng);
+    const float fHeightMultiply = AimLiveHeightMultiply(GetAIShip()->GetACharacter());
+
+    float fTimeHit = -1.0f;
+    {
+        const float fDenom = fSpeedV0 * fCosA;
+        if (fabsf(fDenom) > 1e-3f)
+            fTimeHit = fFlatDist / fDenom;
+    }
+    if (fTimeHit <= 0.0f)
+        return;
+
+    // Dispersion radius from the same gunner-accuracy script model as live fire.
+    float fDispRadius = 5.0f;
+    auto *pVDisp = core.Event(SHIP_GET_BORT_FIRE_DELTA, "afff", GetAIShip()->GetACharacter(), vAim.x, vAim.y, vAim.z);
+    fDispRadius = pVDisp->GetFloat();
+
+    // One palette, no hue-coded states: reloading only dims the same brass.
+    const bool bReady = bortIt->isCharged();
+    const float fDim = bReady ? 1.0f : 0.6f;
+
+    // March the live-fire integration until the water plane.
+    CVECTOR vArc[kAimArcSteps + 1];
+    vArc[0] = vMuzzle;
+    int32_t dwPoints = 1;
+    CVECTOR vImpact(vAim.x, 0.05f, vAim.z);
+    const float fDt = fTimeHit / static_cast<float>(kAimArcSteps);
+    for (int32_t i = 1; i <= kAimArcSteps; ++i)
+    {
+        CVECTOR vNext = AimBallisticPoint(vMuzzle, fSpeedV0, fCosA, fSinA, fRawCos, fRawSin, fDirCos, fDirSin,
+                                          fDt * static_cast<float>(i), fHeightMultiply);
+        if (vNext.y <= 0.0f)
+        {
+            vNext.y = 0.05f;
+            vArc[dwPoints++] = vNext;
+            vImpact = vNext;
+            break;
+        }
+        vArc[dwPoints++] = vNext;
+        if (i == kAimArcSteps)
+            vImpact = CVECTOR(vNext.x, 0.05f, vNext.z);
+    }
+    // Powder-smoke ribbon: one wide soft band in the firing plane, widening
+    // and thinning downrange like dispersing smoke. Two nested layers (wide
+    // faint shell + narrower denser core) for a soft volumetric read.
+    // Depth-tested: ships, masts, sails and islands occlude it correctly.
+    {
+        static std::vector<AimVolVertex> sVol;
+        sVol.clear();
+        const float fSideLen = fFlatDist > 1e-3f ? fFlatDist : 1.0f;
+        const CVECTOR vSide(-vFlat.z / fSideLen, 0.0f, vFlat.x / fSideLen);
+        for (int layer = 0; layer < 2; ++layer)
+        {
+            const float fWidthMul = layer == 0 ? 1.7f : 1.0f;
+            const int32_t dwBaseA = layer == 0 ? 0x10 : 0x20;
+            for (int32_t i = 0; i + 1 < dwPoints; ++i)
+            {
+                const float fT0 = static_cast<float>(i) / static_cast<float>(kAimArcSteps);
+                const float fT1 = static_cast<float>(i + 1) / static_cast<float>(kAimArcSteps);
+                const float fW0 = (0.5f + 2.4f * fT0) * fWidthMul;
+                const float fW1 = (0.5f + 2.4f * fT1) * fWidthMul;
+                const uint32_t dwA0 = AimFadeAlpha(dwBaseA, dwBaseA / 2, i, kAimArcSteps);
+                const uint32_t dwA1 = AimFadeAlpha(dwBaseA, dwBaseA / 2, i + 1, kAimArcSteps);
+                const uint32_t dwC0 = AimColor(kAimSmoke, static_cast<uint32_t>(fDim * dwA0));
+                const uint32_t dwC1 = AimColor(kAimSmoke, static_cast<uint32_t>(fDim * dwA1));
+                const CVECTOR vA0 = vArc[i] + fW0 * vSide;
+                const CVECTOR vB0 = vArc[i] + (0.0f - fW0) * vSide;
+                const CVECTOR vA1 = vArc[i + 1] + fW1 * vSide;
+                const CVECTOR vB1 = vArc[i + 1] + (0.0f - fW1) * vSide;
+                sVol.push_back(AimVolVertex{vA0, dwC0});
+                sVol.push_back(AimVolVertex{vB0, dwC0});
+                sVol.push_back(AimVolVertex{vA1, dwC1});
+                sVol.push_back(AimVolVertex{vB0, dwC0});
+                sVol.push_back(AimVolVertex{vB1, dwC1});
+                sVol.push_back(AimVolVertex{vA1, dwC1});
+            }
+        }
+        FlushAimVolume(sVol);
+    }
+    static std::vector<RS_LINE> sLines;
+    sLines.clear();
+
+    // Soft impact ellipse on the water: faint outer ring at the gunner
+    // dispersion radius plus a fainter inner echo. Calm on waves.
+    const uint32_t dwRingO = AimColor(kAimBrass, static_cast<uint32_t>(fDim * 0x30));
+    const uint32_t dwRingI = AimColor(kAimBrass, static_cast<uint32_t>(fDim * 0x22));
+    EmitAimRing(sLines, vImpact, fDispRadius, dwRingO, kAimRingSegments);
+    EmitAimRing(sLines, vImpact, fDispRadius * 0.55f, dwRingI, 16);
+
+    // Restrained aim accents: umber halo for bright-sky legibility, thin
+    // brass ring + center cross at the predicted landing point.
+    const uint32_t dwAcc = AimColor(kAimBrass, static_cast<uint32_t>(fDim * 0x66));
+    EmitAimRing(sLines, vImpact, 2.6f, AimColor(kAimUmber, 0x44), 20);
+    EmitAimRing(sLines, vImpact, 2.2f, dwAcc, 20);
+    EmitAimCross(sLines, vImpact, 1.1f, dwAcc);
+
+    FlushAimLines(sLines);
+}

