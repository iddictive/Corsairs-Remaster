+}
+// Clip is synchronous on the render thread. The callback has no userdata in the
+// engine API; this scoped pointer is cleared immediately after each query.
+struct AimRangeContext
+{
+    CVECTOR camera,forward;
+    std::vector<std::pair<float,CVECTOR>> candidates;
+    uint32_t polygons=0;
+};
+thread_local AimRangeContext *aimRangeOutput=nullptr;
+bool AimCollectRangePolygon(const CVECTOR *v,int32_t count)
+{
+    if(!aimRangeOutput||count<3)return true;
+    if(++aimRangeOutput->polygons>4096)return false;
+    // The clipped polygon is convex and lies inside the small view rectangle.
+    // Its centroid is a real interior surface point, avoiding edge-only misses.
+    CVECTOR point(0.f);
+    for(int32_t i=0;i<count;++i){if(!manual_aim::finite(v[i]))return true;point+=v[i];}
+    point*=1.f/count;
+    const float depth=(point-aimRangeOutput->camera)|aimRangeOutput->forward;
+    if(depth<=.01f)return true;
+    auto &candidates=aimRangeOutput->candidates;
+    const auto where=std::lower_bound(candidates.begin(),candidates.end(),depth,
+        [](const auto &a,float b){return a.first<b;});
+    candidates.insert(where,{depth,point});
+    if(candidates.size()>32)candidates.pop_back();
+    return true;
+}
+// The visible contact region is approximate dispersion density, independent of
+// changing first-hit receivers. Fixed axial stations avoid hull/mast hit-set jumps.
+std::vector<storm::sea_ai::manual_aim::AimContactSection> AimContactRegion(
+    const std::vector<Trajectory> &inputCurves,size_t nominalCount,const CVECTOR &axis,
+    const CVECTOR &lateral,const CVECTOR &up,float waveBound)
+{
+    using Section=storm::sea_ai::manual_aim::AimContactSection;
+    std::vector<Section> result;
+    if(inputCurves.empty())return result;
+    // Solve planes relative to the muzzle, avoiding large-world endpoint
+    // cancellation before converting the final centers back to absolute world.
+    const CVECTOR reference=inputCurves.front().origin;
+    auto curves=inputCurves;for(auto &curve:curves)curve.origin-=reference;
+    std::vector<float> limits;float first=1e20f,last=-1e20f;
+    for(const auto &curve:curves)
+    {
+        const float end=curve.timeToHeight(-waveBound-1.f-reference.y);limits.push_back(end);
+        if(!std::isfinite(end)||end<=0.f)continue;
+        const float a=curve.origin|axis,b=curve.at(end)|axis;
+        first=std::min({first,a,b});last=std::max({last,a,b});
+        const float acceleration=curve.acceleration|axis;
+        if(std::fabs(acceleration)>1e-8f)
+        {
+            const float turn=-(curve.velocity|axis)/acceleration;
+            if(turn>0.f&&turn<end)
+            {const float x=curve.at(turn)|axis;first=std::min(first,x);last=std::max(last,x);}
+        }
+    }
+    if(!std::isfinite(first)||!std::isfinite(last)||last-first<.01f)return result;
+    const size_t spreadCount=curves.size()-std::min(nominalCount,curves.size());
+    for(int station=0;station<=64;++station)
+    {
+        const float axial=first+(last-first)*float(station)/64.f;
+        std::vector<std::pair<CVECTOR,double>> points;CVECTOR center(0.f);double sum=0.;
+        for(size_t i=0;i<curves.size();++i)
+        {
+            if(!std::isfinite(limits[i])||limits[i]<=0.f)continue;
+            const double weight=i<nominalCount?1./std::max(size_t(1),nominalCount):1./std::max(size_t(1),spreadCount);
+            auto times=manual_aim::planeTimes(curves[i],axis,axial,limits[i]);
+            auto endpoint=[&](float t)
+            {
+                if(!std::isfinite(t)||t<0.f||t>limits[i]||std::fabs((curves[i].at(t)|axis)-axial)>.0005f)return;
+                for(float old:times)if(std::fabs(old-t)<1e-5f)return;
+                times.push_back(t);
+            };
+            endpoint(0.f);endpoint(limits[i]);
+            const float acceleration=curves[i].acceleration|axis;
+            if(std::fabs(acceleration)>1e-8f)endpoint(-(curves[i].velocity|axis)/acceleration);
+            for(float t:times)
+            {const CVECTOR point=curves[i].at(t);points.push_back({point,weight});center+=point*float(weight);sum+=weight;}
+        }
+        if(points.empty())continue;
+        center*=float(1./sum);center+=axis*(axial-(center|axis));
+        double xx=.0025,xy=0.,yy=.0025; // regularize before fitting the real support
+        std::vector<manual_aim::Point> supportPoints;
+        for(const auto &[point,weight]:points)
+        {
+            const CVECTOR d=point-center;const double x=d|lateral,y=d|up;
+            const double w=2.*weight/sum;xx+=w*x*x;xy+=w*x*y;yy+=w*y*y;
+            supportPoints.push_back({float(x),float(y)});
+        }
+        // A covariance ellipse can overhang a nonlinear spread hull at very
+        // short range. Inscribe it using every actual hull support plane rather
+        // than a range-specific shrink constant or an expanded collision mask.
+        const auto supportHull=manual_aim::hull(supportPoints);double scale=1.;
+        if(supportHull.size()>=3)for(size_t edge=0;edge<supportHull.size();++edge)
+        {
+            const auto a=supportHull[edge],b=supportHull[(edge+1)%supportHull.size()];
+            const double ex=b.x-a.x,ey=b.y-a.y,length=std::hypot(ex,ey);
+            if(length<1e-10)continue;
+            const double nx=ey/length,ny=-ex/length,support=nx*a.x+ny*a.y;
+            const double variance=nx*nx*xx+2.*nx*ny*xy+ny*ny*yy;
+            if(support>1e-8&&variance>0.)scale=std::min(scale,support*support/variance);
+        }
+        xx*=scale;xy*=scale;yy*=scale;
+        const double determinant=xx*yy-xy*xy;
+        const double largest=.5*(xx+yy+std::sqrt((xx-yy)*(xx-yy)+4.*xy*xy));
+        if(!(determinant>0.)||!std::isfinite(largest))return {};
+        center+=reference;
+        result.push_back({{center.x,center.y,center.z},0.f,float(yy/determinant),
+            float(-xy/determinant),float(xx/determinant),float(std::sqrt(largest))});
+    }
+    return result;
+}
+} // namespace
+
+void AIShipCannonController::RegisterManualAimReceivers()
+{
+#ifdef STORM_METAL_AIM_VOLUME_BRIDGE
+    namespace gpu=storm::sea_ai::manual_aim;
+    std::vector<gpu::AimRenderedReceiver> receivers;
+    manualAimReceiverTokens.clear();
+    if(auto *model=GetAIShip()->GetModel())
+        receivers.push_back({model->GetId(),gpu::excludedReceiverColor,0u});
+    auto add=[&](MODEL *model,ATTRIBUTES *character)
+    {
+        if(!model||!character||receivers.size()>=gpu::maxRenderedReceivers)return;
+        const uint64_t id=model->GetId();
+        for(const auto &receiver:receivers)if(receiver.modelId==id)return;
+        const uint32_t token=uint32_t(receivers.size()+1);
+        receivers.push_back({id,AimRelationColor(GetAIShip(),character),token});
+        manualAimReceiverTokens.push_back({id,token});
+    };
+    // Metadata only: no second world-BVH/model-bounds rebuild during Execute.
+    for(auto *ship:AIShip::AIShips)
+        if(ship&&ship!=GetAIShip()&&core.GetEntityPointer(ship->GetShipEID()))add(ship->GetModel(),ship->GetACharacter());
+    if(AIFort::pAIFort)
+        for(uint32_t i=0;i<AIFort::pAIFort->GetNumForts();++i)
+        {auto *fort=AIFort::pAIFort->GetFort(i);add(fort->GetModel(),fort->GetACharacter());}
+    StormMetalSetAimRenderedReceivers(AIHelper::pRS->GetD3DDevice(),receivers.data(),uint32_t(receivers.size()));
+#endif
+}
+
+bool AIShipCannonController::ManualGunCanReach(const AICannon &gun,const AISHIP_BORT &bort,
+                                              const CVECTOR &target) const
+{
+    if(gun.isDamaged())return false;
+    const CVECTOR muzzle=gun.GetPos();
+    const float speed=GetSpeedV0();
+    if(!manual_aim::reachable(muzzle,target,speed,AIHelper::fGravity))return false;
+    const CVECTOR direction=!(target-muzzle);
+    if((direction|gun.GetDir())<.3f)return false; // identical traverse guard to AICannon::Fire
+    const float elevation=gun.CalcHeightFireAngle(speed,muzzle,target);
+    const float relative=elevation-GetBortHeightAngle(bort);
+    return std::isfinite(elevation) && relative>=bort.fFireAngMin-1e-4f && relative<=bort.fFireAngMax+1e-4f;
+}
+
+bool AIShipCannonController::BuildManualAimSolution(const CVECTOR &camera,const CVECTOR &direction,
+                                                   MANUAL_AIM_SOLUTION &solution)
+{
+    solution=MANUAL_AIM_SOLUTION{};
+    manualAimColor=0xD9E2E4u;
+    if(!manual_aim::finite(camera)||!manual_aim::finite(direction)||~direction<1e-8f||GetSpeedV0()<=0.f)return false;
+    CVECTOR flat(direction.x,0.f,direction.z);
+    if(~flat<1e-8f)return false;
+    flat=!flat;
+    CVECTOR selection=GetAIShip()->GetPos()+flat;selection.y=0.f;
+    auto bort=GetFirstFireBort(selection);
+    if(!IsValid(bort))return false;
+    solution.bort=&*bort;
+    const float speed=GetSpeedV0();
+    // Pick real geometry independently of camera pitch. Empty/far space is
+    // explicit far intent, never a short horizontal-muzzle-angle shot.
+    float range=0.f,commonFar=1e20f;int compatible=0;
+    std::vector<std::pair<CVECTOR,float>> legalRangeDisks;
+    const float roll=GetBortHeightAngle(*bort);
+    for(const auto &gun:bort->aCannons)
+    {
+        if(gun.isDamaged() || (flat|gun.GetDir())<.3f)continue;
+        const CVECTOR muzzle=gun.GetPos();
+        const float angle=manual_aim::maximumRangeElevation(muzzle.y,speed,
+            roll+bort->fFireAngMin,roll+bort->fFireAngMax,AIHelper::fGravity);
+        const float reach=AICannon::CalcMaxFireDistance(std::max(.01f,muzzle.y),speed,angle);
+        range=std::max(range,reach);
+        legalRangeDisks.push_back({muzzle,reach});
+        if(!manual_aim::farRayLimit(camera,muzzle,flat,reach,commonFar))return false;
+        ++compatible;
+    }
+    if(!compatible||!std::isfinite(range)||range<=0.f||commonFar<=0.f)return false;
+    // Float range construction can sit a few ulps outside the double-precision
+    // reach discriminant at the optimum. Move only the synthetic far boundary
+    // inward by a centimeter-scale margin; real surface targets are untouched.
+    commonFar-=std::max(.01f,commonFar*1e-5f);
+    if(commonFar<=0.f)return false;
+    AimWorld world(GetAIShip());
+    const float pickLength=range+(camera-GetAIShip()->GetPos()).GetLength()+world.waveBound;
+    const CVECTOR forward=!direction;
+    const AimHit hit=world.trace(camera,camera+forward*pickLength);
+    float selectedDepth=hit.valid?((hit.point-camera)|forward):pickLength;
+    ATTRIBUTES *rangeCharacter=hit.character;
+    // The invisible range region keeps its unzoomed angular support and grows
+    // gently with zoom. It selects depth only: no retained target or aim snap.
+    CMatrix projection,view;
+    AIHelper::pRS->GetTransform(D3DTS_PROJECTION,projection);
+    AIHelper::pRS->GetTransform(D3DTS_VIEW,view);view.Transposition();
+    const CVECTOR right=!view.Vx(),up=!view.Vy();
+    const float magnification=AIHelper::pRS->GetCameraMagnification();
+    const float tx=manual_aim::rangeApertureSlope(60.f/2048.f,projection.m[0][0],magnification);
+    const float ty=manual_aim::rangeApertureSlope(34.f/1285.f,projection.m[1][1],magnification);
+    PLANE aperture[6]{};
+    const std::array<CVECTOR,6> normals{{right-forward*tx,-right-forward*tx,
+        up-forward*ty,-up-forward*ty,forward,-forward}};
+    for(int i=0;i<6;++i)
+    {
+        const CVECTOR n=!normals[i];
+        aperture[i].Nx=n.x;aperture[i].Ny=n.y;aperture[i].Nz=n.z;
+        aperture[i].D=n|camera;
+    }
+    aperture[4].D+=pickLength;aperture[5].D-=.01f;
+    AimRangeContext apertureGeometry{camera,forward,{},0};
+    aimRangeOutput=&apertureGeometry;
+    for(const auto &receiver:world.models)
+    {
+        if(!receiver.character||apertureGeometry.polygons>=4096)continue;
+        bool outside=false;
+        for(const auto &plane:aperture)
+        {
+            const CVECTOR nearest(plane.Nx>=0.f?receiver.lo.x:receiver.hi.x,
+                plane.Ny>=0.f?receiver.lo.y:receiver.hi.y,plane.Nz>=0.f?receiver.lo.z:receiver.hi.z);
+            if(plane.Nx*nearest.x+plane.Ny*nearest.y+plane.Nz*nearest.z>plane.D){outside=true;break;}
+        }
+        if(!outside)receiver.object->Clip(aperture,6,camera+forward*(pickLength*.5f),
+            pickLength*std::sqrt(.25f+tx*tx+ty*ty),AimCollectRangePolygon);
+    }
+    aimRangeOutput=nullptr;
+    bool rangePicked=hit.valid;
+    for(const auto &[depth,point]:apertureGeometry.candidates)
+    {
+        if(depth>=selectedDepth)break;
+        const float distance=(point-camera).GetLength();
+        const auto real=world.trace(camera,camera+(!(point-camera))*(distance+.05f));
+        if(!real.valid)continue;
+        const float actualDepth=(real.point-camera)|forward;
+        if(manual_aim::insideRangeAperture(real.point-camera,forward,right,up,tx*1.0001f,ty*1.0001f)&&actualDepth<selectedDepth)
+        {selectedDepth=actualDepth;rangeCharacter=real.character;rangePicked=true;}
+    }
+    // The selected receiver supplies only depth. Camera direction stays exactly
+    // centered, so a shot through rigging gaps continues to its physical contact.
+    if(rangePicked)solution.target=manual_aim::centerRangeTarget(camera,forward,selectedDepth);
+    else solution.target=CVECTOR(camera.x,0.f,camera.z)+flat*commonFar;
+    // A farther original center receiver must not inherit aggression when a
+    // nearer aperture surface supplied a different range.
+    solution.character=hit.valid&&((hit.point-camera)|forward)<=selectedDepth+.05f?hit.character:nullptr;
+    for(auto &gun:bort->aCannons)
+        if(ManualGunCanReach(gun,*bort,solution.target))solution.guns.push_back(&gun);
+    if(solution.guns.empty()&&rangePicked)
+    {
+        // A genuinely distant receiver inside the extended camera query is far
+        // intent too. A near hit outside depression/elevation limits is NOT.
+        const bool beyondEveryRange=std::all_of(legalRangeDisks.begin(),legalRangeDisks.end(),
+            [&](const auto &disk)
+            {const CVECTOR d(solution.target.x-disk.first.x,0.f,solution.target.z-disk.first.z);
+             return d.GetLength()>disk.second+.001f;});
+        if(beyondEveryRange)
+        {
+            solution.target=CVECTOR(camera.x,0.f,camera.z)+flat*commonFar;
+            solution.character=nullptr;rangeCharacter=nullptr;
+                    for(auto &gun:bort->aCannons)
+                if(ManualGunCanReach(gun,*bort,solution.target))solution.guns.push_back(&gun);
+        }
+    }
+    if(!solution.guns.empty())manualAimColor=AimRelationColor(GetAIShip(),rangeCharacter);
+    return !solution.guns.empty(); // near mechanically impossible shots stay unavailable
+}
+
+void AIShipCannonController::DrawManualAimOverlay(const CVECTOR &direction,const CVECTOR &camera)
+{
+    MANUAL_AIM_SOLUTION solution;
+    if(!BuildManualAimSolution(camera,direction,solution))return;
+    AimWorld world(GetAIShip());
+    const float speed=GetSpeedV0(),height=AimHeightScale(GetAIShip()->GetACharacter());
+    const auto spread=AimLiveSpread(GetAIShip()->GetACharacter());
+    std::vector<AimPath> paths;
+    std::vector<std::pair<const AICannon *,AimPath>> nominalPaths;
+    paths.reserve(solution.guns.size()+40);
+    // Every valid gun participates. Locator order is irrelevant.
+    for(const auto *gun:solution.guns)
+    {
+        const CVECTOR muzzle=gun->GetPos();
+        const float angle=gun->CalcHeightFireAngle(speed,muzzle,solution.target);
+        const auto path=AimMarch(manual_aim::trajectory(muzzle,solution.target,speed,angle,0.f,height,AIHelper::fGravity),world);
+        paths.push_back(path);nominalPaths.push_back({gun,path});
+    }
+    // Dispersion samples use the battery's spatial support guns, not first/last
+    // array indices. Model traces are bounded by this fixed support set; all
+    // remaining gun trajectories above still define the envelope's mouth.
+    std::vector<const AICannon *> supports;
+    CVECTOR axis=GetBortDirection(*solution.bort);
+    axis=!(CVECTOR(axis.x,0.f,axis.z));
+    const CVECTOR lateral(-axis.z,0.f,axis.x);
+    for(const CVECTOR &basis:{lateral,CVECTOR(0.f,1.f,0.f)})
+        for(float sign:{-1.f,1.f})
+        {
+            const AICannon *best=nullptr;float value=-1e20f;
+            for(const auto *gun:solution.guns)
+            {const float v=(gun->GetPos()|basis)*sign;if(v>value){value=v;best=gun;}}
+            if(best&&std::find(supports.begin(),supports.end(),best)==supports.end())supports.push_back(best);
+        }
+    for(const auto *gun:supports)
+    {
+        const CVECTOR muzzle=gun->GetPos();
+        const float angle=gun->CalcHeightFireAngle(speed,muzzle,solution.target);
+        for(int n=0;n<8;++n)
+        {
+            // Live jitter uses three independent random draws, not a correlated
+            // ellipse. Include all eight support corners without consuming RNG.
+            const float elevation=spread.elevation*((n&1)?1.f:-1.f);
+            const float yaw=spread.azimuth*((n&2)?1.f:-1.f);
+            const float v=speed+spread.speed*((n&4)?1.f:-1.f);
+            paths.push_back(AimMarch(manual_aim::trajectory(muzzle,solution.target,v,angle+elevation,yaw,height,AIHelper::fGravity),world));
+        }
+    }
+    paths.erase(std::remove_if(paths.begin(),paths.end(),[](const AimPath &p){return !p.hit.valid||p.end<=0.f;}),paths.end());
+    if(paths.empty())return;
+    const bool ready=solution.bort->isCharged();
+    // Contact discovery supplies physical continuation supports, not visible
+    // per-gun meshes. Actual surface coverage is evaluated once from scene depth.
+    // Use ship-local support directions for stable contact projectors. Rolling
+    // through level must not swap equal-height guns or change field count.
+    std::vector<const AICannon *> projectors;
+    const CMatrix &shipMatrix=*GetAIShip()->GetMatrix();
+    for(const CVECTOR &basis:{shipMatrix.Vz(),shipMatrix.Vy()})for(float sign:{-1.f,1.f})
+    {
+        const AICannon *best=nullptr;float value=-1e20f;
+        for(const auto *gun:solution.guns)
+        {
+            const float candidate=((gun->GetPos()-shipMatrix.Pos())|basis)*sign;
+            if(!best||candidate>value+.01f){best=gun;value=candidate;}
+        }
+        if(best&&std::find(projectors.begin(),projectors.end(),best)==projectors.end())projectors.push_back(best);
+    }
+    CVECTOR meanMuzzle(0.f);
+    for(const auto *gun:solution.guns)meanMuzzle+=gun->GetPos();
+    meanMuzzle*=1.f/solution.guns.size();
+    const AICannon *middle=solution.guns.front();
+    for(const auto *gun:solution.guns)
+        if(~(gun->GetPos()-meanMuzzle)<~(middle->GetPos()-meanMuzzle)-.001f)middle=gun;
+    if(std::find(projectors.begin(),projectors.end(),middle)==projectors.end())projectors.push_back(middle);
+    // Physical receiver discoveries may add mask support below, but cannot
+    // change the smooth density shape or its normalization.
+    const auto densityProjectors=projectors;
+    std::vector<storm::sea_ai::manual_aim::AimContactSection> contactSections;
+    for(const auto *gun:densityProjectors)
+    {
+        const CVECTOR muzzle=gun->GetPos();const float angle=gun->CalcHeightFireAngle(speed,muzzle,solution.target);
+        std::vector<Trajectory> curves{manual_aim::trajectory(muzzle,solution.target,speed,angle,0.f,height,AIHelper::fGravity)};
+        for(int n=0;n<8;++n)
+            curves.push_back(manual_aim::trajectory(muzzle,solution.target,speed+spread.speed*((n&4)?1.f:-1.f),
+                angle+spread.elevation*((n&1)?1.f:-1.f),spread.azimuth*((n&2)?1.f:-1.f),height,AIHelper::fGravity));
+        const auto field=AimContactRegion(curves,1,axis,lateral,!(axis^lateral),world.waveBound);
+        if(field.size()==storm::sea_ai::manual_aim::contactSectionsPerField)
+            contactSections.insert(contactSections.end(),field.begin(),field.end());
+    }
+    // Retain a receiver found only by a non-support gun (for example the one
+    // muzzle aligned with a small opening). Add one local field per otherwise
+    // unrepresented receiver, rather than uniformly densifying every cannon.
+    std::vector<int> represented;
+    for(const auto &[gun,path]:nominalPaths)
+        if(path.hit.valid && std::find(projectors.begin(),projectors.end(),gun)!=projectors.end())
+            represented.push_back(path.hit.surface);
+    for(const auto &[gun,path]:nominalPaths)
+        if(path.hit.valid && std::find(represented.begin(),represented.end(),path.hit.surface)==represented.end())
+        {projectors.push_back(gun);represented.push_back(path.hit.surface);}
+    struct ContactSupport
+    {
+        int surface;
+        std::array<AimPath,6> paths{};
+        std::array<float,6> values{{-1e20f,-1e20f,-1e20f,-1e20f,-1e20f,-1e20f}};
+    };
+    std::vector<ContactSupport> contactSupports;
+    const CVECTOR vertical=!(axis^lateral);
+    auto retainContact=[&](const AimPath &path)
+    {
+        if(!path.hit.valid||path.end<=0.f)return;
+        auto it=std::find_if(contactSupports.begin(),contactSupports.end(),
+            [&](const ContactSupport &support){return support.surface==path.hit.surface;});
+        if(it==contactSupports.end()){contactSupports.push_back(ContactSupport{path.hit.surface});it=contactSupports.end()-1;}
+        const std::array<CVECTOR,3> bases{{axis,lateral,vertical}};
+        for(int coordinate=0;coordinate<3;++coordinate)
+            for(int side=0;side<2;++side)
+            {
+                const int slot=coordinate*2+side;
+                const float value=(path.hit.point|bases[coordinate])*(side?1.f:-1.f);
+                if(value>it->values[slot]){it->values[slot]=value;it->paths[slot]=path;}
+            }
+    };
+    std::vector<storm::sea_ai::manual_aim::AimWaterContactVertex> waterVertices;
+    std::vector<storm::sea_ai::manual_aim::AimContactTriangle> contactTriangles;
+    for(const auto *gun:projectors)
+    {
+        const CVECTOR muzzle=gun->GetPos();
+        const float angle=gun->CalcHeightFireAngle(speed,muzzle,solution.target);
+        // Keep the nominal interior field plus both independent speed limits.
+        // Coarser2x2 speed-boundary grids bound extra trace cost; all faces still
+        // refine mixed first receivers independently rather than spanning them.
+        for(int speedLayer=-1;speedLayer<=1;++speedLayer)
+        {
+        const float sampleSpeed=speed+spread.speed*speedLayer;
+        struct WaterSample {AimHit hit;float yaw,elevation;};
+        struct Sample {float yaw,elevation;AimPath path;};
+        std::vector<Sample> cache;
+        int cellSamples=0;bool baseSamples=true;
+        auto sample=[&](float yaw,float elevation)->WaterSample
+        {
+            for(const auto &p:cache)if(p.yaw==yaw&&p.elevation==elevation)return {p.path.hit,yaw,elevation};
+            //41 mandatory points plus an independent12-sample allowance per cell.
+            // A difficult earlier receiver edge cannot erase a later cell.
+            if(!baseSamples&&cellSamples>=12)return {};
+            if(!baseSamples)++cellSamples;
+            const auto path=AimMarch(manual_aim::trajectory(muzzle,solution.target,sampleSpeed,
