+namespace
+{
+// Manual sea-cannon aim overlay. Visualization only: no save, AI, damage,
+// reload or camera state changes.
+//
+// Ballistics replicate live fire exactly (same origin, same integration):
+// Fire-path binding (verified against source, never approximated from camera):
+// manual fire is AIShipCameraController::Fire, which calls
+// AIShipCannonController::Fire(m.Pos(), vZ): ORIGIN IS THE CAMERA POS.
+// Fire(vFireCamPos, vFireDir) and the overlay share ONE target function,
+// ManualAimTarget: camera ray vs solid ship cylinders (hull + rigging
+// airspace), then the sea plane, then the max-range sea point for sky.
+// Preview == impact by construction: same inputs, same calls, same target.
+// Bort selection by the ship-pos flat ray like Fire, range from
+// AICannon::CalcMaxFireDistance(bort height + ship Y, speed, camera-ray
+// angle). Ship/rigging locks keep their height; the band ends ON the ship
+// and the ellipse floats at the aim height (hull-vs-masts readable).
+// Per gun, AICannon::Fire stores (vEnemyPos, fSpeedV0) and RealFire solves
+// azimuth atan2 plus CalcHeightFireAngle from that gun's muzzle world pos
+// (GetPos = ship matrix * locator, the vPosTemp reported via CANNON_FIRE) at
+// the same shared target. Speed matches by construction: UpdateParameters sets
+// bort.fSpeedV0 = GetSpeedV0() for every bort, and cannon.Fire receives
+// bort.fSpeedV0. Height multiplier mirrors Ball_AddBall live (catalog 1.0
+// stock, cannons_init.c, x 0.4 / 0.65 knippels by loaded charge). The march
+// replicates AIBalls::Execute (analytic, no drag, HeightMultiply warp,
+// RotateAroundY(Dir)); the time-scale multipliers only change playback speed,
+// not the arc shape. Dispersion is two-level and both levels are honored:
+// Fire2Position adds ONE random offset per bort inside the
+// SHIP_GET_BORT_FIRE_DELTA gunner radius (ellipse base radius), then
+// Ball_AddBall jitters EVERY ball: Dir += fK * 12deg * (frnd - 0.5) with
+// fK = Bring2Range(0.5, 1.2, 0.2, 1.2, 1.2 - Accuracy), plus SpdV0/Ang jitter
+// scaled by Accuracy. The volume widens downrange into this per-ball cone and
+// the landing ellipse adds its measured range spread.
+//
+// Projection: ONE unified ribbon along the firing broadside. A single flat
+// band in the spine plane spans the battery (outer-gun-arc to
+// outer-gun-arc, full gun line at the muzzles converging onto the landing
+// ellipse downrange) and adds the per-ball cone width; a solid box beam is
+// deliberately avoided because its stacked faces turn into an opaque wall on
+// the along-axis deck view. Single code path for port and starboard by
+// construction: the firing bort comes from GetFirstFireBort with no
+// side-specific branches anywhere below, and ShipAimVolume draws with
+// CullMode none. A filled landing ellipse with rings and center mark sits on
+// the water. All alpha-
+// blended, depth-tested (ShipAimVolume/ShipAimArc): hulls, masts, sails and
+// islands occlude it like any in-world object. Only the firing broadside draws
+// anything; idle side and out-of-sector views emit zero geometry.
+//
+// Style: warm parchment smoke, muted aged brass, umber halo. Soft layers with
+// per-vertex downrange and radial falloff. No neon, no hue-coded states:
+// reloading only dims the same palette.
+constexpr int32_t kAimArcSteps = 20;
+constexpr int32_t kAimRingSegments = 24;
+constexpr const char *kAimTechLine = "ShipAimArc";
+constexpr const char *kAimTechVolume = "ShipAimVolume";
+constexpr uint32_t kAimSmoke = 0xDCE6EC;
+constexpr uint32_t kAimFoe = 0xE06A5A;
+constexpr uint32_t kAimFriend = 0x6FD08A;
+constexpr uint32_t kAimBrass = 0xC8A96A;
+constexpr uint32_t kAimUmber = 0x2E2118;
+constexpr float kAimForwardDot = 0.5f;
+constexpr float kAimImpactY = 0.35f;
+constexpr int32_t kAimVolA = 0x30;
+constexpr int32_t kAimDiscSegments = 28;
+constexpr float kAimHeadFade = 15.0f;
+
+bool s_bAimFadeOwnShip = false;
+
+struct AimVolVertex
+{
+    CVECTOR vPos;
+    uint32_t dwColor;
+};
+
+inline uint32_t AimColor(uint32_t dwRgb, uint32_t dwAlpha)
+{
+    return (dwRgb & 0x00FFFFFFu) | ((dwAlpha & 0xFFu) << 24);
+}
+
+inline uint32_t AimFadeAlpha(int32_t dwA0, int32_t dwA1, int32_t i, int32_t n)
+{
+    const int32_t dwD = n > 0 ? n : 1;
+    return static_cast<uint32_t>(dwA0 + (dwA1 - dwA0) * i / dwD);
+}
+
+// One ballistic sample at time fTime. Mirrors AIBalls::Execute + RealFire.
+CVECTOR AimBallisticPoint(const CVECTOR &vMuzzle, float fSpeedV0, float fCosA, float fSinA, float fRawCos,
+                          float fRawSin, float fDirCos, float fDirSin, float fTime, float fHeightMultiply)
+{
+    const float fsX = fSpeedV0 * fTime * fCosA;
+    const float fsY = fSpeedV0 * fTime * fSinA - AIHelper::fGravity * fTime * fTime * 0.5f;
+    const float fProjX = fsX * fRawCos + fsY * fRawSin;
+    float fProjY = -fsX * fRawSin + fsY * fRawCos;
+    fProjY *= fHeightMultiply;
+    const float fX = fProjX * fRawCos - fProjY * fRawSin;
+    const float fY = fProjX * fRawSin + fProjY * fRawCos;
+    CVECTOR vPos(0.0f, fY, fX);
+    RotateAroundY(vPos.x, vPos.z, fDirCos, fDirSin);
+    vPos += vMuzzle;
+    return vPos;
+}
+
+// Raw elevation tilt, same computation as AICannon::RealFire.
+float AimRawAngle(const CVECTOR &vMuzzle, const CVECTOR &vTarget)
+{
+    const CVECTOR vEnemyDir = !(vTarget - vMuzzle);
+    const CVECTOR vFlatDir = !(CVECTOR(vTarget.x, vMuzzle.y, vTarget.z) - vMuzzle);
+    const float fDp = vFlatDir | vEnemyDir;
+    float fAngle;
+    if (fDp >= 1.0f)
+        fAngle = 0.0f;
+    else if (fDp <= -1.0f)
+        fAngle = PI;
+    else
+        fAngle = acosf(fDp);
+    if (vTarget.y < vMuzzle.y)
+        fAngle = -fAngle;
+    return fAngle;
+}
+
+// Oriented landing ellipse ring: vU runs downrange, vW across (both flat).
+void EmitAimEllipseRing(std::vector<RS_LINE> &lines, const CVECTOR &vCenter, const CVECTOR &vU, const CVECTOR &vW,
+                        float fAxisLon, float fAxisLat, uint32_t dwColor, int32_t dwSegments)
+{
+    CVECTOR vPrev(vCenter.x + vU.x * fAxisLon, vCenter.y, vCenter.z + vU.z * fAxisLon);
+    for (int32_t i = 1; i <= dwSegments; ++i)
+    {
+        const float fAng = 6.2831853f * static_cast<float>(i) / static_cast<float>(dwSegments);
+        const float fC = cosf(fAng);
+        const float fS = sinf(fAng);
+        const CVECTOR vNext(vCenter.x + vU.x * fAxisLon * fC + vW.x * fAxisLat * fS, vCenter.y,
+                            vCenter.z + vU.z * fAxisLon * fC + vW.z * fAxisLat * fS);
+        lines.push_back(RS_LINE{vPrev, dwColor});
+        lines.push_back(RS_LINE{vNext, dwColor});
+        vPrev = vNext;
+    }
+}
+
+// One gun's full march to the water plane. The elevation solution is the
+// per-gun RealFire solution (CalcHeightFireAngle from this muzzle at the shared
+// target, plus an optional delta); the march replicates the live AIBalls
+// integration. fSolveSpd selects the solution, fMarchSpd flies it: live balls
+// solve nominal and fly jittered, and the energy-corner replays use the same
+// split through this identical code path.
+void AimMarchArc(const AICannon *pGun, const CVECTOR &vMuzzle, const CVECTOR &vTarget, float fSolveSpd,
+                 float fMarchSpd, float fAngDelta, float fHeightMultiply, CVECTOR *vOut, int32_t &dwCount)
+{
+    dwCount = 1;
+    vOut[0] = vMuzzle;
+    const float fAngle = pGun->CalcHeightFireAngle(fSolveSpd, vMuzzle, vTarget) + fAngDelta;
+    const float fRawAng = AimRawAngle(vMuzzle, vTarget);
+    const CVECTOR vFlat(vTarget.x - vMuzzle.x, 0.0f, vTarget.z - vMuzzle.z);
+    if (~vFlat <= 0.0f)
+        return;
+    const float fFlatDist = sqrtf(~vFlat);
+    const float fDirAng = atan2f(vFlat.x, vFlat.z);
+    const float fDirCos = cosf(fDirAng);
+    const float fDirSin = sinf(fDirAng);
+    const float fCosA = cosf(fAngle);
+    const float fSinA = sinf(fAngle);
+    const float fRawCos = cosf(fRawAng);
+    const float fRawSin = sinf(fRawAng);
+    float fTimeHit = -1.0f;
+    {
+        const float fDenom = fMarchSpd * fCosA;
+        if (fabsf(fDenom) > 1e-3f)
+            fTimeHit = fFlatDist / fDenom;
+    }
+    if (fTimeHit <= 0.0f)
+        return;
+    const float fDt = fTimeHit / static_cast<float>(kAimArcSteps);
+    for (int32_t i = 1; i <= kAimArcSteps; ++i)
+    {
+        CVECTOR vNext = AimBallisticPoint(vMuzzle, fMarchSpd, fCosA, fSinA, fRawCos, fRawSin, fDirCos, fDirSin,
+                                          fDt * static_cast<float>(i), fHeightMultiply);
+        if (vNext.y <= 0.0f)
+        {
+            vNext.y = kAimImpactY;
+            vOut[dwCount++] = vNext;
+            break;
+        }
+        // Elevated lock (ship/rigging): the band ends ON the ship, so the
+        // ellipse reads hull-vs-masts instead of sliding to the water behind.
+        if (vTarget.y > 1.0f)
+        {
+            const CVECTOR vPrev = vOut[dwCount - 1];
+            const float fStep = sqrtf(~(vNext - vPrev)) + 1e-3f;
+            if (sqrtf(~(vNext - vTarget)) <= fStep * 0.75f)
+            {
+                vOut[dwCount++] = vTarget;
+                break;
+            }
+        }
+        vOut[dwCount++] = vNext;
+    }
+}
+
+// Per-ball dispersion cone, replicating PROGRAM/sea_ai/AIBalls.c Ball_AddBall:
+// fAccuracy = 1.2 - TmpSkill.Accuracy (same character attribute read),
+// fK = Bring2Range(0.5, 1.2, 0.2, 1.2, fAccuracy) (same engine mapping),
+// azimuth half-cone = 0.5 * fK * 12deg, elevation half-cone = 0.5 * fAccuracy
+// * 15deg, speed half-spread = 0.5 * fAccuracy * (10 * 12deg in radians),
+// because (frnd() - 0.5) spans [-0.5, +0.5] on every jittered channel.
+struct AimDispersion
+{
+    float fAccuracy;
+    float fK;
+    float fAzHalf;
+    float fElHalf;
+    float fSpeedHalf;
+};
+
+AimDispersion AimLiveDispersion(ATTRIBUTES *pACharacter)
+{
+    float fSkill = 0.6f;
+    if (pACharacter != nullptr)
+    {
+        auto *pTSkill = pACharacter->FindAClass(pACharacter, "TmpSkill");
+        if (pTSkill != nullptr)
+            fSkill = pTSkill->GetAttributeAsFloat("Accuracy", 0.6f);
+    }
+    AimDispersion d;
+    d.fAccuracy = 1.2f - fSkill;
+    d.fK = Bring2Range(0.5f, 1.2f, 0.2f, 1.2f, d.fAccuracy);
+    constexpr float fDeg = 3.14159265f / 180.0f;
+    d.fAzHalf = 0.5f * d.fK * 12.0f * fDeg;
+    d.fElHalf = 0.5f * d.fAccuracy * 15.0f * fDeg;
+    d.fSpeedHalf = 0.5f * d.fAccuracy * (10.0f * 12.0f * fDeg);
+    return d;
+}
+void EmitAimCross(std::vector<RS_LINE> &lines, const CVECTOR &vCenter, float fHalf, uint32_t dwColor)
+{
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x - fHalf, vCenter.y, vCenter.z), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x + fHalf, vCenter.y, vCenter.z), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x, vCenter.y, vCenter.z - fHalf), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x, vCenter.y, vCenter.z + fHalf), dwColor});
+}
+
+// Oriented landing ellipse fill, fading from a readable heart to a rim.
+void EmitAimEllipse(std::vector<AimVolVertex> &verts, const CVECTOR &vCenter, const CVECTOR &vU, const CVECTOR &vW,
+                    float fAxisLon, float fAxisLat, uint32_t dwRgb, int32_t dwAlpha, int32_t dwSegments)
+{
+    const uint32_t dwC = AimColor(dwRgb, static_cast<uint32_t>(dwAlpha));
+    const uint32_t dwR = AimColor(dwRgb, 0);
+    CVECTOR vPrev(vCenter.x + vU.x * fAxisLon, vCenter.y, vCenter.z + vU.z * fAxisLon);
+    for (int32_t i = 1; i <= dwSegments; ++i)
+    {
+        const float fAng = 6.2831853f * static_cast<float>(i) / static_cast<float>(dwSegments);
+        const float fC = cosf(fAng);
+        const float fS = sinf(fAng);
+        const CVECTOR vNext(vCenter.x + vU.x * fAxisLon * fC + vW.x * fAxisLat * fS, vCenter.y,
+                            vCenter.z + vU.z * fAxisLon * fC + vW.z * fAxisLat * fS);
+        verts.push_back(AimVolVertex{vCenter, dwC});
+        verts.push_back(AimVolVertex{vPrev, dwR});
+        verts.push_back(AimVolVertex{vNext, dwR});
+        vPrev = vNext;
+    }
+}
+
+void FlushAimLines(std::vector<RS_LINE> &lines)
+{
+    if (lines.empty())
+        return;
+    CMatrix mWorld;
+    AIHelper::pRS->GetTransform(D3DTS_WORLD, mWorld);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, CMatrix());
+    AIHelper::pRS->DrawLines(lines.data(), static_cast<uint32_t>(lines.size() / 2), kAimTechLine);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, mWorld);
+}
+
+void FlushAimVolume(std::vector<AimVolVertex> &verts)
+{
+    if (verts.size() < 3)
+        return;
+    CMatrix mWorld;
+    AIHelper::pRS->GetTransform(D3DTS_WORLD, mWorld);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, CMatrix());
+    AIHelper::pRS->DrawPrimitiveUP(D3DPT_TRIANGLELIST, D3DFVF_XYZ | D3DFVF_DIFFUSE, verts.size() / 3, &verts[0],
+                                   sizeof(AimVolVertex), kAimTechVolume);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, mWorld);
+}
+
+bool AimBlocksOwnShip(const CVECTOR &vCamDir, const CVECTOR &vShipFwd)
+{
+    const CVECTOR vFlatC(vCamDir.x, 0.0f, vCamDir.z);
+    const CVECTOR vFlatF(vShipFwd.x, 0.0f, vShipFwd.z);
+    if (~vFlatC <= 1e-6f || ~vFlatF <= 1e-6f)
+        return false;
+    return ((!vFlatC) | (!vFlatF)) > kAimForwardDot;
+}
+} // namespace
+// Live height multiplier, mirroring AIBalls.c Ball_AddBall exactly: cannon
+// catalog HeightMultiply (1.0 for every stock cannon, cannons_init.c) times
+// 0.4 normal shot / 0.65 knippels, selected by the loaded charge. Charge.Type
+// is the numeric goods index (GOOD_KNIPPELS == 2, PROGRAM/store/goods.h), read
+// from the character exactly as the firing path does.
+constexpr uint32_t kAimKnippelsGoods = 2;
+
+float AimLiveHeightMultiply(ATTRIBUTES *pACharacter)
+{
+    if (pACharacter == nullptr)
+        return 0.4f;
+    auto *pACannons = pACharacter->FindAClass(pACharacter, "Ship.Cannons");
+    if (pACannons == nullptr)
+        return 0.4f;
+    const uint32_t dwCharge = pACannons->GetAttributeAsDword("Charge.Type", 0);
+    return dwCharge == kAimKnippelsGoods ? 0.65f : 0.4f;
+}
+
+void AIShipAimSetFadeOwnShip(bool bFade)
+{
+    s_bAimFadeOwnShip = bFade;
+}
+
+bool AIShipAimGetFadeOwnShip()
+{
+    return s_bAimFadeOwnShip;
+}
+// Shared point-and-shoot target for Fire() and DrawManualAimOverlay: ONE
+// function, so preview == impact by construction. Camera ray vs solid ship
+// cylinders (hull + rigging airspace, own ship excluded), then the sea
+// plane, then the max-range sea point for sky. Cylinders are solid on
+// purpose: aiming through the masts never slips to infinity through a
+// micro-gap. pHitShip receives the locked ship (or nullptr for sea/sky).
+CVECTOR AIShipCannonController::ManualAimTarget(AIShip *pOwn, const CVECTOR &vCamPos,
+                                                const CVECTOR &vCamDir, float fMaxDist,
+                                                ATTRIBUTES *&pHitShip)
+{
+    const CVECTOR vDir = !vCamDir;
+    pHitShip = nullptr;
+    float fBest = fMaxDist;
+    const int32_t dwOwn = GetIndex(pOwn->GetACharacter());
+    auto &&entities = core.GetEntityIds("ship");
+    for (auto ent : entities)
+    {
+        auto *pS = static_cast<SHIP_BASE *>(core.GetEntityPointer(ent));
+        if (pS == nullptr)
+            continue;
+        if (GetIndex(pS->GetACharacter()) == dwOwn)
+            continue;
+        const CVECTOR vC = pS->State.vPos;
+        float fHalf = pS->State.vBoxSize.x;
+        if (pS->State.vBoxSize.z > fHalf)
+            fHalf = pS->State.vBoxSize.z;
+        const float fR = 0.5f * fHalf + 2.0f;
+        if (fR < 1.0f)
+            continue;
+        const float fY0 = -2.0f;
+        const float fY1 = vC.y + pS->State.vBoxSize.y + 30.0f;
+        const float fOx = vCamPos.x - vC.x;
+        const float fOz = vCamPos.z - vC.z;
+        const float fA = vDir.x * vDir.x + vDir.z * vDir.z;
+        if (fA > 1e-12f)
+        {
+            const float fB = fOx * vDir.x + fOz * vDir.z;
+            const float fC = fOx * fOx + fOz * fOz - fR * fR;
+            const float fD = fB * fB - fA * fC;
+            if (fD >= 0.0f)
+            {
+                float fT = (-fB - sqrtf(fD)) / fA;
+                if (fT < 0.0f)
+                    fT = (-fB + sqrtf(fD)) / fA;
+                if (fT > 0.0f && fT < fBest)
+                {
+                    const float fY = vCamPos.y + fT * vDir.y;
+                    if (fY >= fY0 && fY <= fY1)
+                    {
+                        fBest = fT;
+                        pHitShip = pS->GetACharacter();
+                    }
+                }
+            }
+        }
+        if (fabsf(vDir.y) > 1e-6f)
+        {
+            const float fT = (fY1 - vCamPos.y) / vDir.y;
+            if (fT > 0.0f && fT < fBest)
+            {
+                const float fDx = vCamPos.x + fT * vDir.x - vC.x;
+                const float fDz = vCamPos.z + fT * vDir.z - vC.z;
+                if (fDx * fDx + fDz * fDz <= fR * fR)
+                {
+                    fBest = fT;
+                    pHitShip = pS->GetACharacter();
+                }
+            }
+        }
+    }
+    if (pHitShip != nullptr)
+        return vCamPos + fBest * vDir;
+    if (vDir.y < -1e-6f)
+    {
+        const float fTSea = -vCamPos.y / vDir.y;
+        if (fTSea > 0.0f && fTSea < fBest)
+            return vCamPos + fTSea * vDir;
+    }
+    CVECTOR vFlat(vDir.x, 0.0f, vDir.z);
+    if (~vFlat <= 1e-8f)
+        vFlat = CVECTOR(0.0f, 0.0f, 1.0f);
+    else
+        vFlat = !vFlat;
+    return CVECTOR(vCamPos.x + fMaxDist * vFlat.x, 0.0f, vCamPos.z + fMaxDist * vFlat.z);
+}
+void AIShipCannonController::DrawManualAimOverlay(const CVECTOR &vCamDir, const CVECTOR &vCamPos)
+{
+    // Own-ship fade gate, reported on every run (all early-outs below keep it).
+    // Player-only + first-person-only by construction: the sole caller runs for
+    // isMainCharacter() after the isCameraOutside() early return.
+    AIShipAimSetFadeOwnShip(AimBlocksOwnShip(vCamDir, !(GetAIShip()->GetMatrix()->Vz())));
+
+    // Idle side / out of sector: zero geometry.
+    if (!isCanFire(vCamDir))
+        return;
+
+    // Firing-solution target, replaying AIShipCannonController::Fire exactly:
+    // bort selection by the ship-pos flat ray (like Fire's vTempFirePos),
+    // range from the same CalcMaxFireDistance call, but ORIGIN AT THE CAMERA
+    // POS (like Fire's vFireCamPos): a ship-pos origin shifts the volume by
+    // the camera-ship offset and live shells land left/right of it.
+    const float fSpeedV0 = GetSpeedV0();
+    if (fSpeedV0 <= 0.0f)
+        return;
+    const CVECTOR vOurPos = GetAIShip()->GetPos();
+    const CVECTOR vTempDir = !CVECTOR(vCamDir.x, 0.0f, vCamDir.z);
+    float fCamAngle = acosf(Clamp(vTempDir | vCamDir));
+    if (vCamDir.y < 0.0f)
+        fCamAngle = -fCamAngle;
+    CVECTOR vTempFirePos = vOurPos + !vTempDir;
+    vTempFirePos.y = 0.0f;
+    auto bortIt = GetFirstFireBort(vTempFirePos);
+    if (!IsValid(bortIt) || bortIt->aCannons.empty())
+        return;
+    const float fMaxDist =
+        AICannon::CalcMaxFireDistance(bortIt->fOurBortFireHeight + vOurPos.y, fSpeedV0, fCamAngle);
+    // Point-and-shoot target: the SAME helper Fire() uses, so preview is
+    // impact. pHitShip locks the aimed ship for the contact glow.
+    ATTRIBUTES *pHitShip = nullptr;
+    const CVECTOR vTarget = ManualAimTarget(GetAIShip(), vCamPos, vCamDir, fMaxDist, pHitShip);
+
+    // Firing battery: outer intact guns bound the volume, the middle gun
+    // carries the spine. One code path for port and starboard: the firing bort
+    // is whatever GetFirstFireBort returns for this ray, with no side-specific
+    // branches anywhere below.
+    const auto &cannons = bortIt->aCannons;
+    const AICannon *pFirst = nullptr;
+    const AICannon *pLast = nullptr;
+    for (const auto &cannon : cannons)
+        if (!cannon.isDamaged())
+        {
+            if (pFirst == nullptr)
+                pFirst = &cannon;
+            pLast = &cannon;
+        }
+    if (pFirst == nullptr)
+        return;
+    const AICannon *pMid = &cannons[cannons.size() / 2];
+    if (pMid->isDamaged())
+        pMid = pFirst;
+
+    const float fHeightMultiply = AimLiveHeightMultiply(GetAIShip()->GetACharacter());
+    const AimDispersion aimD = AimLiveDispersion(GetAIShip()->GetACharacter());
+
+    // Dispersion radius from the same gunner-accuracy script model as live fire.
+    // The query point is the same 3D target Fire2Position receives, not sea level.
+    float fDispRadius = 5.0f;
+    auto *pVDisp =
+        core.Event(SHIP_GET_BORT_FIRE_DELTA, "afff", GetAIShip()->GetACharacter(), vTarget.x, vTarget.y, vTarget.z);
+    fDispRadius = pVDisp->GetFloat();
+    const CVECTOR vMidMuz0 = pMid->GetPos();
+
+    // One palette, no hue-coded states: reloading only dims the same brass.
+    // The dimmed state stays readable (0.8, not 0.6).
+    const bool bReady = bortIt->isCharged();
+    const float fDim = bReady ? 1.0f : 0.8f;
+
+    // One march per plotted gun through the identical helper: per-gun RealFire
+    // solution at the shared Fire target, live AIBalls integration to water.
+    const AICannon *pGuns[3] = {pFirst, pMid, pLast};
+    CVECTOR vArc[3][kAimArcSteps + 1];
+    int32_t dwPoints[3] = {1, 1, 1};
+    for (int32_t g = 0; g < 3; ++g)
+        AimMarchArc(pGuns[g], pGuns[g]->GetPos(), vTarget, fSpeedV0, fSpeedV0, 0.0f, fHeightMultiply, vArc[g],
+                      dwPoints[g]);
+    if (dwPoints[1] < 2)
+        return;
+    CVECTOR vImpact = vArc[1][dwPoints[1] - 1];
+    // Sea/sky locks rest on the water; ship/rigging locks float at the aim
+    // height so the ellipse reads hull-vs-masts.
+    if (vTarget.y <= 1.0f)
+        vImpact.y = kAimImpactY;
+
+    // Shot basis and honest landing ellipse. vU runs downrange (flat mid-muzzle
+    // to impact), vW across. Lateral semi-axis: bort-level gunner radius plus
+    // the per-ball azimuth cone at range. Longitudinal semi-axis: gunner radius
+    // plus the energy spread, measured by marching the two Ball_AddBall energy
+    // corners (speed/elevation jitter extremes) through the identical march.
+    CVECTOR vU = CVECTOR(vImpact.x - vMidMuz0.x, 0.0f, vImpact.z - vMidMuz0.z);
+    if (~vU <= 1e-8f)
+        vU = CVECTOR(0.0f, 0.0f, 1.0f);
+    vU = !vU;
+    const CVECTOR vW(-vU.z, 0.0f, vU.x);
+    const float fFlatRange = sqrtf(~(CVECTOR(vImpact.x - vMidMuz0.x, 0.0f, vImpact.z - vMidMuz0.z)));
+    float fRangeSpread = 0.0f;
+    {
+        CVECTOR vVar[kAimArcSteps + 1];
+        const float fSpdV[2] = {fSpeedV0 - aimD.fSpeedHalf, fSpeedV0 + aimD.fSpeedHalf};
+        const float fAngV[2] = {-aimD.fElHalf, aimD.fElHalf};
+        for (int32_t v = 0; v < 2; ++v)
+        {
+            int32_t dwN = 0;
+            AimMarchArc(pMid, vMidMuz0, vTarget, fSpeedV0, fSpdV[v], fAngV[v], fHeightMultiply, vVar, dwN);
+            if (dwN >= 2)
+            {
+                const float fLon =
+                    (vVar[dwN - 1].x - vImpact.x) * vU.x + (vVar[dwN - 1].z - vImpact.z) * vU.z;
+                if (fabsf(fLon) > fRangeSpread)
+                    fRangeSpread = fabsf(fLon);
+            }
+        }
+    }
+    const float fAxisLat = fDispRadius + tanf(aimD.fAzHalf) * fFlatRange;
+    const float fAxisLon = fDispRadius + fRangeSpread;
+
+    static std::vector<AimVolVertex> sVol;
+    sVol.clear();
+    // Unified broadside ribbon: ONE flat band in the spine plane, following
+    // live ballistics. At each march fraction the band runs outer-gun-arc to
+    // outer-gun-arc (full gun line at the muzzles, converging onto the
+    // landing ellipse downrange); the half-width adds the per-ball azimuth
+    // cone grown with downrange distance. Single surface, no stacked box
+    // faces, so the along-axis deck view stays translucent. The head fades in
+    // over the first kAimHeadFade meters so the muzzle end never fills the
+    // screen. Single code path for port and starboard: no side branches,
+    // CullMode none. Depth-tested like any in-world object.
+    {
+        int32_t dwSeg = dwPoints[0];
+        if (dwPoints[1] < dwSeg)
+            dwSeg = dwPoints[1];
+        if (dwPoints[2] < dwSeg)
+            dwSeg = dwPoints[2];
+        if (dwSeg >= 2)
+        {
+            const float fTanAz = tanf(aimD.fAzHalf);
+            for (int32_t i = 0; i + 1 < dwSeg; ++i)
+            {
+                const CVECTOR &vC0 = vArc[1][i];
+                const CVECTOR &vC1 = vArc[1][i + 1];
+                CVECTOR vLat = CVECTOR(vArc[2][i].x - vArc[0][i].x, 0.0f, vArc[2][i].z - vArc[0][i].z);
+                if (~vLat <= 1e-8f)
+                {
+                    CVECTOR vTan = vC1 - vC0;
+                    vTan.y = 0.0f;
+                    if (~vTan <= 1e-12f)
+                        continue;
+                    vLat = CVECTOR(-vTan.z, 0.0f, vTan.x);
+                }
+                vLat = !vLat;
+                const float fBat0 = 0.5f * sqrtf(~(vArc[2][i] - vArc[0][i]));
+                const float fBat1 = 0.5f * sqrtf(~(vArc[2][i + 1] - vArc[0][i + 1]));
+                const float fD0 = sqrtf(~(CVECTOR(vC0.x - vMidMuz0.x, 0.0f, vC0.z - vMidMuz0.z)));
+                const float fD1 = sqrtf(~(CVECTOR(vC1.x - vMidMuz0.x, 0.0f, vC1.z - vMidMuz0.z)));
+                const float fW0 = fBat0 + fTanAz * fD0;
+                const float fW1 = fBat1 + fTanAz * fD1;
+                const float fHead0 = fD0 < kAimHeadFade ? fD0 / kAimHeadFade : 1.0f;
+                const float fHead1 = fD1 < kAimHeadFade ? fD1 / kAimHeadFade : 1.0f;
+                const uint32_t dwC0 = AimColor(
+                    kAimSmoke, static_cast<uint32_t>(fDim * fHead0 * AimFadeAlpha(kAimVolA, kAimVolA / 2, i, kAimArcSteps)));
+                const uint32_t dwC1 = AimColor(
+                    kAimSmoke,
+                    static_cast<uint32_t>(fDim * fHead1 * AimFadeAlpha(kAimVolA, kAimVolA / 2, i + 1, kAimArcSteps)));
+                const CVECTOR vL0 = vC0 - vLat * fW0;
+                const CVECTOR vR0 = vC0 + vLat * fW0;
+                const CVECTOR vL1 = vC1 - vLat * fW1;
+                const CVECTOR vR1 = vC1 + vLat * fW1;
+                sVol.push_back(AimVolVertex{vL0, dwC0});
+                sVol.push_back(AimVolVertex{vR0, dwC0});
+                sVol.push_back(AimVolVertex{vR1, dwC1});
+                sVol.push_back(AimVolVertex{vL0, dwC0});
+                sVol.push_back(AimVolVertex{vR1, dwC1});
+                sVol.push_back(AimVolVertex{vL1, dwC1});
+            }
+        }
+    }
+    // Landing zone: filled ellipse at the honest two-level dispersion
+    // (bort gunner radius plus per-ball cone), fading from a readable brass
+    // heart to a transparent rim. Sits above the wave tops so chop never
+    // swallows it.
+    EmitAimEllipse(sVol, vImpact, vU, vW, fAxisLon, fAxisLat, kAimBrass, static_cast<int32_t>(fDim * 0x62),
+                     kAimDiscSegments);
+    FlushAimVolume(sVol);
+
+    static std::vector<RS_LINE> sLines;
+    sLines.clear();
+
+    // Landing rings + center mark: outer ellipse at the honest dispersion,
+    // inner echo, umber halo for bright-sky legibility, thin brass ring and
+    // cross at the predicted point.
+    const uint32_t dwRingO = AimColor(kAimBrass, static_cast<uint32_t>(fDim * 0x9A));
+    const uint32_t dwRingI = AimColor(kAimBrass, static_cast<uint32_t>(fDim * 0x77));
+    EmitAimEllipseRing(sLines, vImpact, vU, vW, fAxisLon, fAxisLat, dwRingO, kAimRingSegments);
+    EmitAimEllipseRing(sLines, vImpact, vU, vW, fAxisLon * 0.55f, fAxisLat * 0.55f, dwRingI, 16);
+    const uint32_t dwAcc = AimColor(kAimBrass, static_cast<uint32_t>(fDim * 0xC0));
+    // Focus-peaking contact glow: on a ship lock the center mark tints by
+    // relation (soft red = enemy, soft green = else). Sea and sky keep
+    // neutral brass. Lightweight: two rings + cross only.
+    uint32_t dwContact = dwAcc;
+    if (pHitShip != nullptr)
+    {
+        const uint32_t dwRel = Helper.GetRelation(GetAIShip()->GetACharacter(), pHitShip);
+        const uint32_t dwTint = (dwRel == RELATION_ENEMY) ? kAimFoe : kAimFriend;
+        dwContact = AimColor(dwTint, static_cast<uint32_t>(fDim * 0xC0));
+    }
+    EmitAimEllipseRing(sLines, vImpact, vU, vW, 2.6f, 2.6f, AimColor(kAimUmber, 0x55), 20);
+    EmitAimEllipseRing(sLines, vImpact, vU, vW, 2.2f, 2.2f, dwContact, 20);
+    EmitAimCross(sLines, vImpact, 1.1f, dwContact);
+
+    FlushAimLines(sLines);
+}
