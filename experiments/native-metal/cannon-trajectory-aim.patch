@@ -131,6 +131,11 @@
     // execute/realize section
     void Execute(float fDeltaTime);
     void Realize(float fDeltaTime);
+    // Manual deck-aim trajectory overlay (visualization only, player ship).
+    void DrawManualAimOverlay(const CVECTOR &vCamDir, const CVECTOR &vCamPos);
+    // Shared point-and-shoot target for Fire() and the overlay (raycast).
+    static CVECTOR ManualAimTarget(AIShip *pOwn, const CVECTOR &vCamPos, const CVECTOR &vCamDir, float fMaxDist,
+                                   ATTRIBUTES *&pHitShip);
 
     // init section
