+AimPath AimMarch(const Trajectory &curve,const AimWorld &world)
+{
+    AimPath path;path.curve=curve;
+    // The real warped parabola determines lifetime, including overshooting
+    // dispersion. Nominal target time is not a collision or a stopping plane.
+    const float limit=curve.timeToHeight(-world.waveBound-1.f);
+    if(!std::isfinite(limit)||limit<=0.f)return path;
+    const int steps=std::clamp(int(std::ceil(limit*curve.velocity.GetLength()/12.f)),24,128);
+    const auto result=manual_aim::firstContact(curve,limit,steps,
+        [&](const CVECTOR &from,const CVECTOR &to){return world.trace(from,to);});
+    path.end=result.end;path.hit=result.hit;
+    return path;
+}
+float AimHeightScale(ATTRIBUTES *character)
+{
+    auto *cannons=character?character->FindAClass(character,"Ship.Cannons"):nullptr;
+    float catalogScale=1.f;
+    auto *catalog=static_cast<VDATA *>(core.GetScriptVariable("Cannon"));
+    const uint32_t type=cannons?cannons->GetAttributeAsDword("Type",0):0;
+    if(catalog && type<catalog->GetElementsNum())
+        if(auto *entry=catalog->GetAClass(type))catalogScale=entry->GetAttributeAsFloat("HeightMultiply",1.f);
+    // Match the currently shipped AIBalls.c, including its inherited comparison:
+    // Type is Goods[charge].Name, compared to integer GOOD_KNIPPELS (2).
+    // DATA converts a nonnumeric name to 0, so every loaded named shot uses .4.
+    // Using .65 for numeric Charge.Type==2 would silently disagree with live fire.
+    return catalogScale*.4f;
