+    {
+        if(cell<0)return true;
+        if(size_t(cell)>=Cells)return false;
+        auto &used=localPatch?patch[cell]:detail[cell];
+        const int limit=localPatch?8:16;
+        if(used>=limit)return false;
+        ++used;return true;
+    }
