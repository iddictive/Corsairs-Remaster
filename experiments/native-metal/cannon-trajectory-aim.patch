+namespace
+{
+// Manual sea-cannon aim overlay. Visualization only: no save, AI, damage,
+// reload or camera state changes.
+//
+// Ballistics replicate live fire exactly (same origin, same integration):
+// Fire-path binding (verified against source, never approximated from camera):
+// manual fire is AIShipCameraController::Fire, which calls
+// AIShipCannonController::Fire(m.Pos(), vZ): ORIGIN IS THE CAMERA POS.
+// Fire(vFireCamPos, vFireDir) and the overlay share ONE target function,
+// ManualAimTarget: camera ray vs all physics (solid ship cylinders, fort,
+// island, sea), then the firing bort's max-elevation range point for sky.
+// Preview == impact by construction: same inputs, same calls, same target.
+// Bort selection by the ship-pos flat ray like Fire, range from
+// AICannon::CalcMaxFireDistance(bort height + ship Y, speed, camera-ray
+// angle). GetFirePos (stock target detection) returns the same shared
+// target, so the reticle color agrees with the overlay and live shells.
+// Per gun, AICannon::Fire stores (vEnemyPos, fSpeedV0) and RealFire
+// solves azimuth atan2 plus CalcHeightFireAngle from that gun's muzzle world
+// pos (GetPos = ship matrix * locator, the vPosTemp reported via CANNON_FIRE)
+// at the same shared target. Speed matches by construction: UpdateParameters
+// sets bort.fSpeedV0 = GetSpeedV0() for every bort, and cannon.Fire receives
+// bort.fSpeedV0. Height multiplier mirrors Ball_AddBall live (catalog 1.0
+// stock, cannons_init.c, x 0.4 / 0.65 knippels by loaded charge). The march
+// replicates AIBalls::Execute (analytic, no drag, HeightMultiply warp,
+// RotateAroundY(Dir)); the time-scale multipliers only change playback speed,
+// not the arc shape. Every march segment clips at the nearest of water,
+// island and fort contact, mirroring the live kill order (hull, fort, island,
+// sea; sail/mast hits are side effects only, so rigging never clips the
+// march). Dispersion on manual fire is per-ball only: Fire passes
+// bApplyBortDelta=false, so the SHIP_GET_BORT_FIRE_DELTA gunner offset is
+// skipped (AI callers keep it) and the crosshair is the aim point. Live
+// Ball_AddBall still jitters EVERY ball: Dir += fK * 12deg * (frnd - 0.5) with
+// fK = Bring2Range(0.5, 1.2, 0.2, 1.2, 1.2 - Accuracy), plus SpdV0/Ang jitter
+// scaled by Accuracy. The fan widens downrange into this per-ball cone and
+// the landing ellipse adds its measured range spread over a 2m viz floor.
+//
+// Projection: three trajectory arcs along the firing broadside plus a drape
+// outline. The mid-gun march is the spine, the outer-gun marches are faint
+// edges, so the battery fan reads with zero fill sheets (a volumetric tube
+// rendered as a white highway at range and exploded into sheets and stray
+// lines at close range; rejected after player replay, October 1). The drape
+// outline is one flat ellipse ring at the lock point: lock height on
+// ship/fort/island, march impact on sea/sky, raised over the highest
+// surface under it (sea, island/fort terrain, locked-ship disc at aim
+// height; ships expose no pure model trace, so no true hull drape) so
+// slopes never slice it. Ring segments overlapping the locked ship
+// cylinder or fort point tint by relation (soft red = enemy, soft green =
+// else), like focus peaking; the rest stays neutral brass. Single code path
+// for port and starboard by construction: the firing bort comes from
+// GetFirstFireBort with no side-specific branches anywhere below. All
+// alpha-blended, depth-tested (ShipAimArc): hulls, masts, sails and islands
+// occlude it like any in-world object. Only the firing broadside draws
+// anything; idle side and out-of-sector views emit zero geometry. The stock
+// center reticle stays: it is the crosshair the guns aim at, and arcs +
+// drape show where its ray lands. No own-ship fading anywhere: sails, ropes
+// and vants render stock.
+//
+// Style: warm parchment smoke, muted aged brass. Soft layers with per-vertex
+// downrange falloff. No neon, no hue-coded states: reloading only dims the
+// same palette.
+constexpr int32_t kAimArcSteps = 20;
+constexpr int32_t kAimRingSegments = 24;
+constexpr const char *kAimTechLine = "ShipAimArc";
+constexpr uint32_t kAimSmoke = 0xDCE6EC;
+constexpr uint32_t kAimFoe = 0xE06A5A;
+constexpr uint32_t kAimFriend = 0x6FD08A;
+constexpr uint32_t kAimBrass = 0xC8A96A;
+// Sea impact marker height: normal-weather crests reach fMaxSeaHeight 2.0
+// (PROGRAM/weather/WhrSea.c; calm 0.5). 0.35 buried the ring, march end and
+// cross in chop at any range; 1.5 clears typical seas. Brief storm wash is
+// accepted. Terrain and ship locks use real heights, unaffected.
+constexpr float kAimImpactY = 1.5f;
+constexpr int32_t kAimSpineA0 = 0x55;
+constexpr int32_t kAimSpineA1 = 0x7A;
+constexpr int32_t kAimEdgeA0 = 0x2E;
+constexpr int32_t kAimEdgeA1 = 0x46;
+constexpr float kAimLockAirY = 12.0f;
+constexpr float kAimFortTintR = 10.0f;
+// ManualAimTarget lock kinds: sea, ship, fort, island, sky.
+constexpr int32_t kAimLockSea = 0;
+constexpr int32_t kAimLockShip = 1;
+constexpr int32_t kAimLockFort = 2;
+constexpr int32_t kAimLockIsland = 3;
+constexpr int32_t kAimLockSky = 4;
+
+inline uint32_t AimColor(uint32_t dwRgb, uint32_t dwAlpha)
+{
+    return (dwRgb & 0x00FFFFFFu) | ((dwAlpha & 0xFFu) << 24);
+}
+
+inline uint32_t AimFadeAlpha(int32_t dwA0, int32_t dwA1, int32_t i, int32_t n)
+{
+    const int32_t dwD = n > 0 ? n : 1;
+    return static_cast<uint32_t>(dwA0 + (dwA1 - dwA0) * i / dwD);
+}
+
+// One ballistic sample at time fTime. Mirrors AIBalls::Execute + RealFire.
+CVECTOR AimBallisticPoint(const CVECTOR &vMuzzle, float fSpeedV0, float fCosA, float fSinA, float fRawCos,
+                          float fRawSin, float fDirCos, float fDirSin, float fTime, float fHeightMultiply)
+{
+    const float fsX = fSpeedV0 * fTime * fCosA;
+    const float fsY = fSpeedV0 * fTime * fSinA - AIHelper::fGravity * fTime * fTime * 0.5f;
+    const float fProjX = fsX * fRawCos + fsY * fRawSin;
+    float fProjY = -fsX * fRawSin + fsY * fRawCos;
+    fProjY *= fHeightMultiply;
+    const float fX = fProjX * fRawCos - fProjY * fRawSin;
+    const float fY = fProjX * fRawSin + fProjY * fRawCos;
+    CVECTOR vPos(0.0f, fY, fX);
+    RotateAroundY(vPos.x, vPos.z, fDirCos, fDirSin);
+    vPos += vMuzzle;
+    return vPos;
+}
+
+// Raw elevation tilt, same computation as AICannon::RealFire.
+float AimRawAngle(const CVECTOR &vMuzzle, const CVECTOR &vTarget)
+{
+    const CVECTOR vEnemyDir = !(vTarget - vMuzzle);
+    const CVECTOR vFlatDir = !(CVECTOR(vTarget.x, vMuzzle.y, vTarget.z) - vMuzzle);
+    const float fDp = vFlatDir | vEnemyDir;
+    float fAngle;
+    if (fDp >= 1.0f)
+        fAngle = 0.0f;
+    else if (fDp <= -1.0f)
+        fAngle = PI;
+    else
+        fAngle = acosf(fDp);
+    if (vTarget.y < vMuzzle.y)
+        fAngle = -fAngle;
+    return fAngle;
+}
+
+// Drape height at one XZ: the surface the ring lies on. Sea floor, raised by
+// island/fort down-traces (pure Trace, no damage), and by the locked ship's
+// aim height inside its footprint disc. Ships expose no pure model trace
+// (Cannon_Trace would apply damage), so the disc rides at lock height: hull
+// aim hugs the waterline, mast aim the sails. fShipY < 0 disables the lift.
+float AimDrapeY(float fX, float fZ, CANNON_TRACE_BASE *pIsland, AIFort *pFort, const CVECTOR &vDiscC,
+                float fDiscR, float fShipY)
+{
+    float fY = kAimImpactY;
+    const CVECTOR vTop(fX, 400.0f, fZ);
+    const CVECTOR vBot(fX, -50.0f, fZ);
+    if (pIsland != nullptr)
+    {
+        const float fT = pIsland->Trace(vTop, vBot);
+        if (fT <= 1.0f)
+        {
+            const float fHit = 400.0f + fT * (-450.0f);
+            if (fHit > fY)
+                fY = fHit;
+        }
+    }
+    if (pFort != nullptr)
+    {
+        const float fT = pFort->Trace(vTop, vBot);
+        if (fT <= 1.0f)
+        {
+            const float fHit = 400.0f + fT * (-450.0f);
+            if (fHit > fY)
+                fY = fHit;
+        }
+    }
+    if (fShipY >= 0.0f && fDiscR > 0.0f)
+    {
+        const float fDx = fX - vDiscC.x;
+        const float fDz = fZ - vDiscC.z;
+        if (fDx * fDx + fDz * fDz <= fDiscR * fDiscR && fShipY > fY)
+            fY = fShipY;
+    }
+    return fY + 0.15f;
+}
+
+// Drape outline: one flat ellipse ring at the lock, vU downrange, vW
+// across. The ring rides at the HIGHEST surface under it (center plus ring
+// samples over sea, island, fort and the locked-ship disc) plus a small
+// lift, so one clean ellipse floats over slopes instead of slicing through
+// them (per-vertex drape cut chords through cliffs and read as stray
+// lines). XZ is the exact dispersion ellipse; Y is visibility lift only.
+// Segments whose midpoint falls inside the lock disc (locked ship
+// cylinder, fort point) tint by relation like focus peaking; the rest stays
+// neutral. fLockRadius <= 0 disables tinting (sea/sky/island). Returns the
+// ring plane height so the center cross sits on the same plane.
+float EmitAimDrapeRing(std::vector<RS_LINE> &lines, const CVECTOR &vCenter, const CVECTOR &vU, const CVECTOR &vW,
+                       float fAxisLon, float fAxisLat, uint32_t dwBase, uint32_t dwTint,
+                       const CVECTOR &vLockCenter, float fLockRadius, int32_t dwSegments,
+                       CANNON_TRACE_BASE *pIsland, AIFort *pFort, float fShipY)
+{
+    float fRingY = AimDrapeY(vCenter.x, vCenter.z, pIsland, pFort, vLockCenter, fLockRadius, fShipY);
+    for (int32_t i = 1; i <= dwSegments; ++i)
+    {
+        const float fAng = 6.2831853f * static_cast<float>(i) / static_cast<float>(dwSegments);
+        const float fC = cosf(fAng);
+        const float fS = sinf(fAng);
+        const float fX = vCenter.x + vU.x * fAxisLon * fC + vW.x * fAxisLat * fS;
+        const float fZ = vCenter.z + vU.z * fAxisLon * fC + vW.z * fAxisLat * fS;
+        const float fY = AimDrapeY(fX, fZ, pIsland, pFort, vLockCenter, fLockRadius, fShipY);
+        if (fY > fRingY)
+            fRingY = fY;
+    }
+    fRingY += 0.35f;
+    CVECTOR vPrev(vCenter.x + vU.x * fAxisLon, fRingY, vCenter.z + vU.z * fAxisLon);
+    for (int32_t i = 1; i <= dwSegments; ++i)
+    {
+        const float fAng = 6.2831853f * static_cast<float>(i) / static_cast<float>(dwSegments);
+        const float fC = cosf(fAng);
+        const float fS = sinf(fAng);
+        const float fX = vCenter.x + vU.x * fAxisLon * fC + vW.x * fAxisLat * fS;
+        const float fZ = vCenter.z + vU.z * fAxisLon * fC + vW.z * fAxisLat * fS;
+        const CVECTOR vNext(fX, fRingY, fZ);
+        uint32_t dwColor = dwBase;
+        if (fLockRadius > 0.0f)
+        {
+            const float fMx = 0.5f * (vPrev.x + vNext.x) - vLockCenter.x;
+            const float fMz = 0.5f * (vPrev.z + vNext.z) - vLockCenter.z;
+            if (fMx * fMx + fMz * fMz <= fLockRadius * fLockRadius)
+                dwColor = dwTint;
+        }
+        lines.push_back(RS_LINE{vPrev, dwColor});
+        lines.push_back(RS_LINE{vNext, dwColor});
+        vPrev = vNext;
+    }
+    return fRingY;
+}
+
+// One gun's full march, ending at water, terrain or the elevated lock. The
+// elevation solution is the per-gun RealFire solution (CalcHeightFireAngle
+// from this muzzle at the shared target, plus an optional delta); the march
+// replicates the live AIBalls integration. fSolveSpd selects the solution,
+// fMarchSpd flies it: live balls solve nominal and fly jittered, and the
+// energy-corner replays use the same split through this identical code path.
+// Every segment clips at the nearest of water/island/fort contact, mirroring
+// the live kill order (AIBalls::Execute: ships, fort, island, sea). Pure
+// Trace only: Cannon_Trace would apply damage and spawn hit effects.
+void AimMarchArc(const AICannon *pGun, const CVECTOR &vMuzzle, const CVECTOR &vTarget, float fSolveSpd,
+                 float fMarchSpd, float fAngDelta, float fHeightMultiply, CVECTOR *vOut, int32_t &dwCount)
+{
+    dwCount = 1;
+    vOut[0] = vMuzzle;
+    const float fAngle = pGun->CalcHeightFireAngle(fSolveSpd, vMuzzle, vTarget) + fAngDelta;
+    const float fRawAng = AimRawAngle(vMuzzle, vTarget);
+    const CVECTOR vFlat(vTarget.x - vMuzzle.x, 0.0f, vTarget.z - vMuzzle.z);
+    if (~vFlat <= 0.0f)
+        return;
+    const float fFlatDist = sqrtf(~vFlat);
+    const float fDirAng = atan2f(vFlat.x, vFlat.z);
+    const float fDirCos = cosf(fDirAng);
+    const float fDirSin = sinf(fDirAng);
+    const float fCosA = cosf(fAngle);
+    const float fSinA = sinf(fAngle);
+    const float fRawCos = cosf(fRawAng);
+    const float fRawSin = sinf(fRawAng);
+    float fTimeHit = -1.0f;
+    {
+        const float fDenom = fMarchSpd * fCosA;
+        if (fabsf(fDenom) > 1e-3f)
+            fTimeHit = fFlatDist / fDenom;
+    }
+    if (fTimeHit <= 0.0f)
+        return;
+    CANNON_TRACE_BASE *pAimIsland = nullptr;
+    {
+        auto *pEnt = core.GetEntityPointer(core.GetEntityId("island"));
+        if (pEnt != nullptr)
+            pAimIsland = static_cast<CANNON_TRACE_BASE *>(pEnt);
+    }
+    AIFort *pAimFort = AIFort::pAIFort;
+    const float fDt = fTimeHit / static_cast<float>(kAimArcSteps);
+    for (int32_t i = 1; i <= kAimArcSteps; ++i)
+    {
+        CVECTOR vNext = AimBallisticPoint(vMuzzle, fMarchSpd, fCosA, fSinA, fRawCos, fRawSin, fDirCos, fDirSin,
+                                          fDt * static_cast<float>(i), fHeightMultiply);
+        const CVECTOR vPrev = vOut[dwCount - 1];
+        float fWater = 2.0f;
+        if (vPrev.y > 0.0f && vNext.y <= 0.0f)
+            fWater = vPrev.y / (vPrev.y - vNext.y);
+        float fTerr = 2.0f;
+        if (pAimIsland != nullptr)
+        {
+            const float fT = pAimIsland->Trace(vPrev, vNext);
+            if (fT < fTerr)
+                fTerr = fT;
+        }
+        if (pAimFort != nullptr)
+        {
+            const float fT = pAimFort->Trace(vPrev, vNext);
+            if (fT < fTerr)
+                fTerr = fT;
+        }
+        if (fTerr <= 1.0f && fTerr <= fWater)
+        {
+            vNext = vPrev + fTerr * (vNext - vPrev);
+            vOut[dwCount++] = vNext;
+            break;
+        }
+        if (vNext.y <= 0.0f)
+        {
+            vNext.y = kAimImpactY;
+            vOut[dwCount++] = vNext;
+            break;
+        }
+        // Elevated lock (ship/rigging): the band ends ON the ship, so aim
+        // height reads hull-vs-masts instead of sliding to the water behind.
+        if (vTarget.y > 1.0f)
+        {
+            const float fStep = sqrtf(~(vNext - vPrev)) + 1e-3f;
+            if (sqrtf(~(vNext - vTarget)) <= fStep * 0.75f)
+            {
+                vOut[dwCount++] = vTarget;
+                break;
+            }
+        }
+        vOut[dwCount++] = vNext;
+    }
+}
+
+// Per-ball dispersion cone, replicating PROGRAM/sea_ai/AIBalls.c Ball_AddBall:
+// fAccuracy = 1.2 - TmpSkill.Accuracy (same character attribute read),
+// fK = Bring2Range(0.5, 1.2, 0.2, 1.2, fAccuracy) (same engine mapping),
+// azimuth half-cone = 0.5 * fK * 12deg, elevation half-cone = 0.5 * fAccuracy
+// * 15deg, speed half-spread = 0.5 * fAccuracy * (10 * 12deg in radians),
+// because (frnd() - 0.5) spans [-0.5, +0.5] on every jittered channel.
+struct AimDispersion
+{
+    float fAccuracy;
+    float fK;
+    float fAzHalf;
+    float fElHalf;
+    float fSpeedHalf;
+};
+
+AimDispersion AimLiveDispersion(ATTRIBUTES *pACharacter)
+{
+    float fSkill = 0.6f;
+    if (pACharacter != nullptr)
+    {
+        auto *pTSkill = pACharacter->FindAClass(pACharacter, "TmpSkill");
+        if (pTSkill != nullptr)
+            fSkill = pTSkill->GetAttributeAsFloat("Accuracy", 0.6f);
     }
+    AimDispersion d;
+    d.fAccuracy = 1.2f - fSkill;
+    d.fK = Bring2Range(0.5f, 1.2f, 0.2f, 1.2f, d.fAccuracy);
+    constexpr float fDeg = 3.14159265f / 180.0f;
+    d.fAzHalf = 0.5f * d.fK * 12.0f * fDeg;
+    d.fElHalf = 0.5f * d.fAccuracy * 15.0f * fDeg;
+    d.fSpeedHalf = 0.5f * d.fAccuracy * (10.0f * 12.0f * fDeg);
+    return d;
 }
+void EmitAimCross(std::vector<RS_LINE> &lines, const CVECTOR &vCenter, float fHalf, uint32_t dwColor)
+{
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x - fHalf, vCenter.y, vCenter.z), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x + fHalf, vCenter.y, vCenter.z), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x, vCenter.y, vCenter.z - fHalf), dwColor});
+    lines.push_back(RS_LINE{CVECTOR(vCenter.x, vCenter.y, vCenter.z + fHalf), dwColor});
+}
 
+void FlushAimLines(std::vector<RS_LINE> &lines)
+{
+    if (lines.empty())
+        return;
+    CMatrix mWorld;
+    AIHelper::pRS->GetTransform(D3DTS_WORLD, mWorld);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, CMatrix());
+    AIHelper::pRS->DrawLines(lines.data(), static_cast<uint32_t>(lines.size() / 2), kAimTechLine);
+    AIHelper::pRS->SetTransform(D3DTS_WORLD, mWorld);
+}
+
+} // namespace
+// Live height multiplier, mirroring AIBalls.c Ball_AddBall exactly: cannon
+// catalog HeightMultiply (1.0 for every stock cannon, cannons_init.c) times
+// 0.4 normal shot / 0.65 knippels, selected by the loaded charge. Charge.Type
+// is the numeric goods index (GOOD_KNIPPELS == 2, PROGRAM/store/goods.h), read
+// from the character exactly as the firing path does.
+constexpr uint32_t kAimKnippelsGoods = 2;
+
+float AimLiveHeightMultiply(ATTRIBUTES *pACharacter)
+{
+    if (pACharacter == nullptr)
+        return 0.4f;
+    auto *pACannons = pACharacter->FindAClass(pACharacter, "Ship.Cannons");
+    if (pACannons == nullptr)
+        return 0.4f;
+    const uint32_t dwCharge = pACannons->GetAttributeAsDword("Charge.Type", 0);
+    return dwCharge == kAimKnippelsGoods ? 0.65f : 0.4f;
+}
+
+// Shared point-and-shoot target for Fire() and DrawManualAimOverlay: ONE
+// function, so preview == impact by construction. Camera ray vs all physics:
+// solid ship cylinders (own ship excluded), fort, island, then the sea plane,
+// then the firing bort's max-elevation range point for sky. Ship cylinders
+// are solid on purpose:
+// aiming through the masts never slips to infinity through a micro-gap.
+// Hull/air rule: a cylinder contact above kAimLockAirY only locks for
+// knippels (AimLiveHeightMultiply > 0.5); round shot aimed at sails falls
+// through to whatever is behind, like live shells aimed at the waterline.
+// pHitShip receives the locked ship-or-fort character (nullptr for
+// sea/island/sky); dwLockKind reports sea/ship/fort/island/sky;
+// vLockCenter/fLockRadius bound the focus-peaking tint disc (radius 0 = none).
+CVECTOR AIShipCannonController::ManualAimTarget(const CVECTOR &vCamPos, const CVECTOR &vCamDir, float fMaxDist,
+                                                ATTRIBUTES *&pHitShip, int32_t &dwLockKind,
+                                                CVECTOR &vLockCenter, float &fLockRadius)
+{
+    const CVECTOR vDir = !vCamDir;
+    const bool bKnippels = AimLiveHeightMultiply(GetAIShip()->GetACharacter()) > 0.5f;
+    pHitShip = nullptr;
+    dwLockKind = kAimLockSky;
+    vLockCenter = CVECTOR(0.0f, 0.0f, 0.0f);
+    fLockRadius = 0.0f;
+    float fBest = fMaxDist;
+    const int32_t dwOwn = GetIndex(GetAIShip()->GetACharacter());
+    auto &&entities = core.GetEntityIds("ship");
+    for (auto ent : entities)
+    {
+        auto *pS = static_cast<SHIP_BASE *>(core.GetEntityPointer(ent));
+        if (pS == nullptr)
+            continue;
+        if (GetIndex(pS->GetACharacter()) == dwOwn)
+            continue;
+        const CVECTOR vC = pS->State.vPos;
+        float fHalf = pS->State.vBoxSize.x;
+        if (pS->State.vBoxSize.z > fHalf)
+            fHalf = pS->State.vBoxSize.z;
+        const float fR = 0.5f * fHalf + 2.0f;
+        if (fR < 1.0f)
+            continue;
+        const float fY0 = -2.0f;
+        const float fY1 = vC.y + pS->State.vBoxSize.y + 30.0f;
+        const float fOx = vCamPos.x - vC.x;
+        const float fOz = vCamPos.z - vC.z;
+        const float fA = vDir.x * vDir.x + vDir.z * vDir.z;
+        if (fA > 1e-12f)
+        {
+            const float fB = fOx * vDir.x + fOz * vDir.z;
+            const float fC = fOx * fOx + fOz * fOz - fR * fR;
+            const float fD = fB * fB - fA * fC;
+            if (fD >= 0.0f)
+            {
+                float fT = (-fB - sqrtf(fD)) / fA;
+                if (fT < 0.0f)
+                    fT = (-fB + sqrtf(fD)) / fA;
+                if (fT > 0.0f && fT < fBest)
+                {
+                    const float fY = vCamPos.y + fT * vDir.y;
+                    if (fY >= fY0 && fY <= fY1 && (fY <= kAimLockAirY || bKnippels))
+                    {
+                        fBest = fT;
+                        pHitShip = pS->GetACharacter();
+                        dwLockKind = kAimLockShip;
+                        vLockCenter = CVECTOR(vC.x, 0.0f, vC.z);
+                        fLockRadius = fR;
+                    }
+                }
+            }
+        }
+        if (fabsf(vDir.y) > 1e-6f)
+        {
+            const float fT = (fY1 - vCamPos.y) / vDir.y;
+            if (fT > 0.0f && fT < fBest)
+            {
+                const float fDx = vCamPos.x + fT * vDir.x - vC.x;
+                const float fDz = vCamPos.z + fT * vDir.z - vC.z;
+                if (fDx * fDx + fDz * fDz <= fR * fR && (fY1 <= kAimLockAirY || bKnippels))
+                {
+                    fBest = fT;
+                    pHitShip = pS->GetACharacter();
+                    dwLockKind = kAimLockShip;
+                    vLockCenter = CVECTOR(vC.x, 0.0f, vC.z);
+                    fLockRadius = fR;
+                }
+            }
+        }
+    }
+    // Forts: pure model trace (Cannon_Trace would spawn hit effects). The hit
+    // fort's character is captured immediately, before any later Trace call
+    // can move AIFort::pLastTraceFort.
+    if (AIFort::pAIFort != nullptr)
+    {
+        const float fF = AIFort::pAIFort->Trace(vCamPos, vCamPos + fMaxDist * vDir);
+        if (fF <= 1.0f && fF * fMaxDist < fBest)
+        {
+            fBest = fF * fMaxDist;
+            pHitShip = AIFort::pAIFort->GetACharacter();
+            dwLockKind = kAimLockFort;
+        }
+    }
+    // Island: pure heightfield trace.
+    {
+        auto *pEnt = core.GetEntityPointer(core.GetEntityId("island"));
+        if (pEnt != nullptr)
+        {
+            const float fI =
+                static_cast<CANNON_TRACE_BASE *>(pEnt)->Trace(vCamPos, vCamPos + fMaxDist * vDir);
+            if (fI <= 1.0f && fI * fMaxDist < fBest)
+            {
+                fBest = fI * fMaxDist;
+                pHitShip = nullptr;
+                dwLockKind = kAimLockIsland;
+            }
+        }
+    }
+    if (dwLockKind == kAimLockShip || dwLockKind == kAimLockFort || dwLockKind == kAimLockIsland)
+    {
+        const CVECTOR vLock = vCamPos + fBest * vDir;
+        if (dwLockKind == kAimLockFort)
+        {
+            vLockCenter = CVECTOR(vLock.x, 0.0f, vLock.z);
+            fLockRadius = (pHitShip != nullptr) ? kAimFortTintR : 0.0f;
+        }
+        else if (dwLockKind == kAimLockIsland)
+        {
+            vLockCenter = CVECTOR(vLock.x, 0.0f, vLock.z);
+            fLockRadius = 0.0f;
+        }
+        return vLock;
+    }
+    if (vDir.y < -1e-6f)
+    {
+        const float fTSea = -vCamPos.y / vDir.y;
+        if (fTSea > 0.0f && fTSea < fBest)
+        {
+            dwLockKind = kAimLockSea;
+            return vCamPos + fTSea * vDir;
+        }
+    }
+    dwLockKind = kAimLockSky;
+    // Sky / infinity: the guns elevate to the firing bort's max and the
+    // shells land at its max range in the flat look direction, so the tube
+    // always runs through where the crosshair points. Falls back to the
+    // passed range when no bort bears (should not happen: callers check
+    // isCanFire first).
+    CVECTOR vFlat(vDir.x, 0.0f, vDir.z);
+    if (~vFlat <= 1e-8f)
+        vFlat = CVECTOR(0.0f, 0.0f, 1.0f);
+    else
+        vFlat = !vFlat;
+    float fSkyDist = fMaxDist;
+    {
+        const CVECTOR vOwn = GetAIShip()->GetPos();
+        CVECTOR vTmpFire = vOwn + vFlat;
+        vTmpFire.y = 0.0f;
+        const auto bortSky = GetFirstFireBort(vTmpFire);
+        if (IsValid(bortSky))
+            fSkyDist = AICannon::CalcMaxFireDistance(bortSky->fOurBortFireHeight + vOwn.y, GetSpeedV0(),
+                                                     GetBortHeightAngle(*bortSky) + bortSky->fFireAngMax);
+    }
+    return CVECTOR(vCamPos.x + fSkyDist * vFlat.x, 0.0f, vCamPos.z + fSkyDist * vFlat.z);
+}
+void AIShipCannonController::DrawManualAimOverlay(const CVECTOR &vCamDir, const CVECTOR &vCamPos)
+{
+    // Idle side / out of sector: zero geometry.
+    if (!isCanFire(vCamDir))
+        return;
+
+    // Firing-solution target, replaying AIShipCannonController::Fire exactly:
+    // bort selection by the ship-pos flat ray (like Fire's vTempFirePos),
+    // range from the same CalcMaxFireDistance call, but ORIGIN AT THE CAMERA
+    // POS (like Fire's vFireCamPos): a ship-pos origin shifts the volume by
+    // the camera-ship offset and live shells land left/right of it.
+    const float fSpeedV0 = GetSpeedV0();
+    if (fSpeedV0 <= 0.0f)
+        return;
+    const CVECTOR vOurPos = GetAIShip()->GetPos();
+    const CVECTOR vTempDir = !CVECTOR(vCamDir.x, 0.0f, vCamDir.z);
+    float fCamAngle = acosf(Clamp(vTempDir | vCamDir));
+    if (vCamDir.y < 0.0f)
+        fCamAngle = -fCamAngle;
+    CVECTOR vTempFirePos = vOurPos + !vTempDir;
+    vTempFirePos.y = 0.0f;
+    auto bortIt = GetFirstFireBort(vTempFirePos);
+    if (!IsValid(bortIt) || bortIt->aCannons.empty())
+        return;
+    const float fMaxDist =
+        AICannon::CalcMaxFireDistance(bortIt->fOurBortFireHeight + vOurPos.y, fSpeedV0, fCamAngle);
+    // Point-and-shoot target: the SAME helper Fire() uses, so preview is
+    // impact. pHitShip/dwLockKind/vLockCenter/fLockRadius drive the drape.
+    ATTRIBUTES *pHitShip = nullptr;
+    int32_t dwLockKind = kAimLockSky;
+    CVECTOR vLockCenter(0.0f, 0.0f, 0.0f);
+    float fLockRadius = 0.0f;
+    const CVECTOR vTarget =
+        ManualAimTarget(vCamPos, vCamDir, fMaxDist, pHitShip, dwLockKind, vLockCenter, fLockRadius);
+
+    // Firing battery: outer intact guns bound the volume, the middle gun
+    // carries the spine. One code path for port and starboard: the firing bort
+    // is whatever GetFirstFireBort returns for this ray, with no side-specific
+    // branches anywhere below.
+    const auto &cannons = bortIt->aCannons;
+    const AICannon *pFirst = nullptr;
+    const AICannon *pLast = nullptr;
+    for (const auto &cannon : cannons)
+        if (!cannon.isDamaged())
+        {
+            if (pFirst == nullptr)
+                pFirst = &cannon;
+            pLast = &cannon;
+        }
+    if (pFirst == nullptr)
+        return;
+    // Spine gun: intact gun nearest the battery center, so a knocked-out
+    // middle gun does not skew the spine to the battery edge.
+    const AICannon *pMid = pFirst;
+    {
+        const size_t dwCount = cannons.size();
+        const size_t dwCenter = dwCount / 2;
+        size_t dwBest = dwCount;
+        for (size_t i = 0; i < dwCount; ++i)
+        {
+            if (cannons[i].isDamaged())
+                continue;
+            const size_t dwD = (i > dwCenter) ? (i - dwCenter) : (dwCenter - i);
+            const size_t dwB = (dwBest > dwCenter) ? (dwBest - dwCenter) : (dwCenter - dwBest);
+            if (dwBest == dwCount || dwD < dwB)
+                dwBest = i;
+        }
+        if (dwBest != dwCount)
+            pMid = &cannons[dwBest];
+    }
+
+    const float fHeightMultiply = AimLiveHeightMultiply(GetAIShip()->GetACharacter());
+    const AimDispersion aimD = AimLiveDispersion(GetAIShip()->GetACharacter());
+
+    // Manual fire applies NO bort-level gunner offset (Fire passes
+    // bApplyBortDelta=false), so the landing ellipse has no gunner-radius
+    // base: a 2m viz floor plus the live per-ball cone only. (AI keeps the
+    // scripted SHIP_GET_BORT_FIRE_DELTA scatter; the overlay is player-only.)
+    constexpr float fDispBase = 2.0f;
+    const CVECTOR vMidMuz0 = pMid->GetPos();
+
+    // One palette, no hue-coded states: reloading only dims the same brass.
+    // The dimmed state stays readable (0.8, not 0.6).
+    const bool bReady = bortIt->isCharged();
+    const float fDim = bReady ? 1.0f : 0.8f;
+
+    // One march per plotted gun through the identical helper: per-gun RealFire
+    // solution at the shared Fire target, live AIBalls integration to water.
+    const AICannon *pGuns[3] = {pFirst, pMid, pLast};
+    CVECTOR vArc[3][kAimArcSteps + 1];
+    int32_t dwPoints[3] = {1, 1, 1};
+    for (int32_t g = 0; g < 3; ++g)
+        AimMarchArc(pGuns[g], pGuns[g]->GetPos(), vTarget, fSpeedV0, fSpeedV0, 0.0f, fHeightMultiply, vArc[g],
+                      dwPoints[g]);
+    if (dwPoints[1] < 2)
+        return;
+    // Drape center: the lock point itself on ship/fort/island (hull aim reads
+    // at the waterline, mast aim at the sails), march impact on sea/sky.
+    // Ring vertices then drape onto their own surface (sea, terrain, ship
+    // disc), so the outline hugs the world instead of floating flat.
+    CVECTOR vImpact = vArc[1][dwPoints[1] - 1];
+    if (dwLockKind == kAimLockShip || dwLockKind == kAimLockFort || dwLockKind == kAimLockIsland)
+        vImpact = vTarget;
+    else
+        vImpact.y = kAimImpactY;
+
+    // Shot basis and honest landing ellipse. vU runs downrange (flat mid-muzzle
+    // to impact), vW across. Lateral semi-axis: viz floor plus the live
+    // per-ball azimuth cone at range. Longitudinal semi-axis: viz floor plus
+    // the energy spread, measured by marching the two Ball_AddBall energy
+    // corners (speed/elevation jitter extremes) through the identical march.
+    CVECTOR vU = CVECTOR(vImpact.x - vMidMuz0.x, 0.0f, vImpact.z - vMidMuz0.z);
+    if (~vU <= 1e-8f)
+        vU = CVECTOR(0.0f, 0.0f, 1.0f);
+    vU = !vU;
+    const CVECTOR vW(-vU.z, 0.0f, vU.x);
+    const float fFlatRange = sqrtf(~(CVECTOR(vImpact.x - vMidMuz0.x, 0.0f, vImpact.z - vMidMuz0.z)));
+    float fRangeSpread = 0.0f;
+    {
+        CVECTOR vVar[kAimArcSteps + 1];
+        const float fSpdV[2] = {fSpeedV0 - aimD.fSpeedHalf, fSpeedV0 + aimD.fSpeedHalf};
+        const float fAngV[2] = {-aimD.fElHalf, aimD.fElHalf};
+        for (int32_t v = 0; v < 2; ++v)
+        {
+            int32_t dwN = 0;
+            AimMarchArc(pMid, vMidMuz0, vTarget, fSpeedV0, fSpdV[v], fAngV[v], fHeightMultiply, vVar, dwN);
+            if (dwN >= 2)
+            {
+                const float fLon =
+                    (vVar[dwN - 1].x - vImpact.x) * vU.x + (vVar[dwN - 1].z - vImpact.z) * vU.z;
+                if (fabsf(fLon) > fRangeSpread)
+                    fRangeSpread = fabsf(fLon);
+            }
+        }
+    }
+    const float fAxisLat = fDispBase + tanf(aimD.fAzHalf) * fFlatRange;
+    const float fAxisLon = fDispBase + fRangeSpread;
+
+    static std::vector<RS_LINE> sLines;
+    sLines.clear();
+
+    // Battery fan: the outer-gun marches as faint arcs, so the spread reads
+    // with zero fill sheets (a volumetric tube rendered as a white highway
+    // at range and exploded into sheets and stray lines at close range;
+    // rejected after player replay). Single code path for port and
+    // starboard: no side branches. Depth-tested like any in-world object.
+    for (int32_t g = 0; g < 3; g += 2)
+        for (int32_t i = 0; i + 1 < dwPoints[g]; ++i)
+        {
+            const uint32_t dwE = AimColor(
+                kAimSmoke, static_cast<uint32_t>(fDim * AimFadeAlpha(kAimEdgeA0, kAimEdgeA1, i, kAimArcSteps)));
+            sLines.push_back(RS_LINE{vArc[g][i], dwE});
+            sLines.push_back(RS_LINE{vArc[g][i + 1], dwE});
+        }
+
+    // Spine: the mid-gun march as a brightening polyline, so the trajectory
+    // reads at long range where the fan converges thin.
+    for (int32_t i = 0; i + 1 < dwPoints[1]; ++i)
+    {
+        const uint32_t dwS =
+            AimColor(kAimSmoke, static_cast<uint32_t>(fDim * AimFadeAlpha(kAimSpineA0, kAimSpineA1, i, kAimArcSteps)));
+        sLines.push_back(RS_LINE{vArc[1][i], dwS});
+        sLines.push_back(RS_LINE{vArc[1][i + 1], dwS});
+    }
+
+    // Drape outline + center mark: thin ring at the honest dispersion, ring
+    // segments over the locked ship/fort tint by relation (soft red = enemy,
+    // soft green = else), sea and sky keep neutral brass. One flat ellipse
+    // over the highest surface under it; the cross sits on the same plane.
+    const uint32_t dwRing = AimColor(kAimBrass, static_cast<uint32_t>(fDim * 0xAA));
+    uint32_t dwContact = AimColor(kAimBrass, static_cast<uint32_t>(fDim * 0xCC));
+    uint32_t dwTint = dwRing;
+    if (pHitShip != nullptr)
+    {
+        const uint32_t dwRel = Helper.GetRelation(GetAIShip()->GetACharacter(), pHitShip);
+        const uint32_t dwTintRgb = (dwRel == RELATION_ENEMY) ? kAimFoe : kAimFriend;
+        dwContact = AimColor(dwTintRgb, static_cast<uint32_t>(fDim * 0xCC));
+        dwTint = AimColor(dwTintRgb, static_cast<uint32_t>(fDim * 0xCC));
+    }
+    CANNON_TRACE_BASE *pDrapeIsland = nullptr;
+    {
+        auto *pEnt = core.GetEntityPointer(core.GetEntityId("island"));
+        if (pEnt != nullptr)
+            pDrapeIsland = static_cast<CANNON_TRACE_BASE *>(pEnt);
+    }
+    AIFort *pDrapeFort = AIFort::pAIFort;
+    const float fShipY = (dwLockKind == kAimLockShip) ? vTarget.y : -1.0f;
+    const float fRingY =
+        EmitAimDrapeRing(sLines, vImpact, vU, vW, fAxisLon, fAxisLat, dwRing, dwTint, vLockCenter, fLockRadius,
+                         kAimRingSegments, pDrapeIsland, pDrapeFort, fShipY);
+    EmitAimCross(sLines, CVECTOR(vImpact.x, fRingY, vImpact.z), 1.1f, dwContact);
+
+    FlushAimLines(sLines);
+}
