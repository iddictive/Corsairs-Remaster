diff --git a/src/libs/sea/src/sea.cpp b/src/libs/sea/src/sea.cpp
index b6c30c3..589aacc 100644
--- a/src/libs/sea/src/sea.cpp
+++ b/src/libs/sea/src/sea.cpp
@@ -1359,13 +1359,29 @@ void SEA::Realize(uint32_t dwDeltaTime)
     if (!bUnderSea)
         bUnderSeaStarted = false;
 
+    // The negative-Y face is intentionally omitted above water. A waterline
+    // transition changes that face set, so reprime the persistent sun-road cube.
+    if (reflectionUnderSea != bUnderSea)
+    {
+        reflectionUnderSea = bUnderSea;
+        sunRoadPrimed = false;
+    }
+
+    // Dynamic ship/island reflections redraw every visible ship once per cube
+    // face. Refresh the whole coherent cube every second frame instead of every
+    // frame: faces within one refresh share a single timestamp, so the cube
+    // never mixes frames the way a rolling per-face cadence would.
+    const bool refreshDynamicReflection = (dynamicReflectionTick++ % 2) == 0;
+
     if (bSimpleSea)
     {
+        if (refreshDynamicReflection)
+            EnvMap_Render2();
-        EnvMap_Render2();
         SunRoad_Render2();
     }
     else
     {
+        if (refreshDynamicReflection)
+            EnvMap_Render();
-        EnvMap_Render();
         SunRoad_Render();
     }
@@ -2001,6 +2009,8 @@ uint32_t SEA::AttributeChanged(ATTRIBUTES *pAttribute)
 
 void SEA::LostRender()
 {
+    sunRoadPrimed = false;
+    dynamicReflectionTick = 0;
     rs->Release(pReflection);
     rs->Release(pReflectionSunroad);
     rs->Release(pEnvMap);
