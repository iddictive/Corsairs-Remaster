+// Squared distance from point p to triangle (a, b, c), sail-local coords.
+// Volumetric cannon balls: a ball whose center passes within its rigging radius
+// of the cloth counts as a sail hit even when the zero-radius ray misses it.
+static float BallClothDistSq(const CVECTOR &p, const CVECTOR &a, const CVECTOR &b, const CVECTOR &c)
+{
+    const CVECTOR ab = b - a;
+    const CVECTOR ac = c - a;
+    const CVECTOR n = ab ^ ac;
+    const float fN2 = ~n;
+    if (fN2 > 1e-12f)
+    {
+        const float fT = (n | (p - a)) / fN2;
+        const CVECTOR q = p - n * fT;
+        const CVECTOR aq = q - a;
+        const float fD00 = ab | ab;
+        const float fD01 = ab | ac;
+        const float fD11 = ac | ac;
+        const float fD20 = aq | ab;
+        const float fD21 = aq | ac;
+        const float fDen = fD00 * fD11 - fD01 * fD01;
+        if (fabsf(fDen) > 1e-12f)
+        {
+            const float fV = (fD11 * fD20 - fD01 * fD21) / fDen;
+            const float fW = (fD00 * fD21 - fD01 * fD20) / fDen;
+            if (fV >= 0.0f && fW >= 0.0f && fV + fW <= 1.0f)
+                return ~(p - q);
+        }
+    }
+    float fBest = 1e30f;
+    for (int k = 0; k < 3; k++)
+    {
+        const CVECTOR &e0 = (k == 0) ? a : ((k == 1) ? b : c);
+        const CVECTOR &e1 = (k == 0) ? b : ((k == 1) ? c : a);
+        const CVECTOR d = e1 - e0;
+        const float fL2 = ~d;
+        float fT = (fL2 > 1e-12f) ? ((p - e0) | d) / fL2 : 0.0f;
+        fT = (fT < 0.0f) ? 0.0f : ((fT > 1.0f) ? 1.0f : fT);
+        const float fD2 = ~(p - (e0 + d * fT));
+        if (fD2 < fBest)
+            fBest = fD2;
+    }
+    return fBest;
+}
