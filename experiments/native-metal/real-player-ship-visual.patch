+std::unique_ptr<storm_map_player::StaticSails> SAIL::BuildWorldMapVisual(MODEL *model, ATTRIBUTES *character)
+{
+    if (!model || !character) return nullptr;
+    SAIL builder;
+    builder.worldMapVisualOnly = true; builder.Init();
+    builder.groupQuantity = 1; builder.gdata = new GROUPDATA[1]{};
+    builder.gdata[0].modelEI = model->GetId();
+    builder.gdata[0].dwSailsColor = 0xffffffff;
+    for (int i = 0; auto *node = model->GetNode(i); ++i)
+    {
+        if (!storm_map_player::visible(node) || !node->geo) continue;
+        GEOS::INFO info{}; node->geo->GetInfo(info);
+        for (int j = 0; j < info.nlabels; ++j)
+        {
+            GEOS::LABEL label{}; node->geo->GetLabel(j, label);
+            if (!strncmp(label.name, "sail", 4)) builder.AddSailLabel(label, node, true);
+        }
+    }
+    if (builder.sailQuantity)
+    {
+        // The visual builder uses the same SAILONE geometry functions but
+        // deliberately never enters SetAllSails' gameplay/ship state branch.
+        builder.gdata[0].sailIdx = new int[builder.sailQuantity];
+        for (int i = 0; i < builder.sailQuantity; ++i)
+        {
+            builder.slist[i]->RenderService = builder.RenderService;
+            // Stock SetAllSails excludes zero-size authored sails. Keep that
+            // admission without mutating gameplay data or deleting array slots.
+            if (builder.slist[i]->SetSail())
+                builder.gdata[0].sailIdx[builder.gdata[0].sailQuantity++] = i;
+        }
+        builder.SetSailTextures(0, core.Event("GetSailTextureData", "l", character->GetAttributeAsDword("index", -1)));
+        auto *state = character->FindAClass(character, "Ship.Sails");
+        for (int i = 0; i < builder.sailQuantity; ++i)
+        {
+            auto *sail = builder.slist[i]; char group[24]; snprintf(group, sizeof(group), "%d", sail->groupNum);
+            if (!sail->ss.nVert) continue;
+            auto *node = state ? state->GetAttributeClass(sail->hostNode->GetName()) : nullptr;
+            auto *record = node ? node->GetAttributeClass(group) : nullptr;
+            if (record) sail->SetAllHole(record->GetAttributeAsDword("hd"));
+            sail->SetGeometry();
+        }
+        builder.texl = builder.RenderService->TextureCreate("ships\\parus_hole.tga");
+        builder.m_nEmptyGerbTex = builder.RenderService->TextureCreate("ships\\emptygerald.tga");
+        return builder.CaptureWorldMapVisual(model, false);
+    }
+    // A hull with no authored cloth still has a valid empty visual owner.
+    return std::make_unique<storm_map_player::OwnedStaticSails>();
+}
