+std::unique_ptr<storm_map_player::StaticSails> SAIL::CaptureWorldMapVisual(MODEL *model, bool fromLiveBuffer)
+{
+    if (!model || !RenderService) return nullptr;
+    const SAILVERTEX *liveVertices = nullptr;
+    if (fromLiveBuffer && sg.vertBuf >= 0)
+        liveVertices = static_cast<SAILVERTEX *>(RenderService->LockVertexBuffer(sg.vertBuf));
+    struct VertexLock {
+        VDX9RENDER *rs; int id; const SAILVERTEX *vertices;
+        ~VertexLock() { if (vertices) rs->UnLockVertexBuffer(id); }
+    } lock{RenderService, sg.vertBuf, liveVertices};
+    if (fromLiveBuffer && !liveVertices) return nullptr;
+
+    auto result = std::make_unique<storm_map_player::OwnedStaticSails>();
+    result->material = mat;
+    int group = -1;
+    for (int i = 0; i < groupQuantity; ++i)
+        if (!gdata[i].bDeleted && static_cast<MODEL *>(core.GetEntityPointer(gdata[i].modelEI)) == model) { group = i; break; }
+    if (group < 0) return nullptr;
+    for (int i = 0; i < gdata[group].sailQuantity; ++i)
+    {
+        auto *sail = slist[gdata[group].sailIdx[i]];
+        if (!sail || sail->bDeleted || !storm_map_player::visible(sail->hostNode)) continue;
+        auto mesh = std::make_unique<storm_map_player::OwnedStaticSails::Mesh>();
+        mesh->rs = RenderService; mesh->color = gdata[group].dwSailsColor;
+        // Each texture id obtains its own renderer reference. Direct heraldry
+        // textures obtain AddRef; no sea-owned texture/node/buffer is borrowed.
+        auto retain = [&](int texture, int &destination) {
+            if (texture >= 0 && RenderService->TextureIncReference(texture)) destination = texture;
+        };
+        retain(sail->surfaceTex, mesh->surface);
+        retain(sail->m_bIsGerald ? sail->m_nGeraldTex : m_nEmptyGerbTex, mesh->heraldry);
+        retain(texl, mesh->holes);
+        if (sail->m_bIsGerald && sail->m_pGeraldTex)
+        { mesh->heraldryPointer = sail->m_pGeraldTex; mesh->heraldryPointer->AddRef(); }
+        mesh->vertices.resize(sail->ss.nVert);
+        if (liveVertices)
+            std::copy_n(liveVertices + sail->ss.sVert, sail->ss.nVert, mesh->vertices.begin());
+        else
+        { sail->FillVertex(mesh->vertices.data()); sail->SetTexGrid(mesh->vertices.data()); }
+        for (auto &vertex : mesh->vertices)
+        {
+            CVECTOR point, normal;
+            model->mtx.MulToInv(sail->hostNode->glob_mtx * vertex.pos, point);
+            const auto &m = sail->hostNode->glob_mtx;
+            const CVECTOR worldNormal = m.Vx() * vertex.norm.x + m.Vy() * vertex.norm.y + m.Vz() * vertex.norm.z;
+            model->mtx.MulToInvNorm(worldNormal, normal);
+            vertex.pos = point; vertex.norm = !normal;
+        }
+        // Reuse authored hole triangulation without writing to the shared IB
+        // or leaving changed offsets/counts on the live SAILONE.
+        const SAILSTATE saved = sail->ss;
+        sail->ss.sIndx = 0; mesh->indices.resize(sail->ss.nIndx);
+        sail->FillIndex(mesh->indices.data());
+        mesh->normalTriangles = sail->ss.nnormIndx;
+        mesh->holeStart = sail->ss.sholeIndx; mesh->holeTriangles = sail->ss.nholeIndx;
+        sail->ss = saved;
+        if (!mesh->upload()) return nullptr;
+        result->meshes.push_back(std::move(mesh));
+    }
+    return result;
+}
