+bool SAIL::AddWorldMapBounds(MODEL *model, storm_map_player::VisualBounds &bounds)
+{
+    if (!model || sg.vertBuf < 0) return false;
+    const auto *vertices = static_cast<SAILVERTEX *>(RenderService->LockVertexBuffer(sg.vertBuf));
+    if (!vertices) return false;
+    bool found = false;
+    for (int group = 0; group < groupQuantity; ++group)
+    {
+        if (gdata[group].bDeleted || static_cast<MODEL *>(core.GetEntityPointer(gdata[group].modelEI)) != model) continue;
+        found = true;
+        for (int i = 0; i < gdata[group].sailQuantity; ++i)
+        {
+            auto *sail = slist[gdata[group].sailIdx[i]];
+            if (!sail || sail->bDeleted || !storm_map_player::visible(sail->hostNode)) continue;
+            for (unsigned j = 0; j < sail->ss.nVert; ++j)
+            {
+                CVECTOR point; model->mtx.MulToInv(sail->hostNode->glob_mtx * vertices[sail->ss.sVert + j].pos, point);
+                bounds.add(point);
+            }
+        }
+    }
+    RenderService->UnLockVertexBuffer(sg.vertBuf);
+    return found;
+}
