@@ -494,2 +494,23 @@
 #ifdef STORM_METAL_DYNAMIC_LIGHTING_BRIDGE
+bool Lights::GetShadowLightAt(unsigned ordinal, uint64_t& id, D3DLIGHT9& light)
+{
+    // Stable authored source order, not camera/player proximity. Ignore types
+    // that never emit light, but do not change identity during flame flicker.
+    for (int32_t index=0; index<numLights; ++index) {
+        const auto& source=lights[index];
+        const auto& type=types[source.type];
+        if(type.dxLight.Type!=D3DLIGHT_POINT || type.dxLight.Range<=.1f)continue;
+        if(type.color.r<=0 && type.color.g<=0 && type.color.b<=0)continue;
+        if(ordinal){--ordinal;continue;}
+        light=type.dxLight;
+        light.Position=source.pos;
+        const float intensity=source.intensity/255.f;
+        light.Diffuse.r=source.color.r*intensity;
+        light.Diffuse.g=source.color.g*intensity;
+        light.Diffuse.b=source.color.b*intensity;
+        id=uint64_t(index)+1;
+        return true;
+    }
+    id=0;return false;
+}
 void Lights::PublishMetalSceneLights()
