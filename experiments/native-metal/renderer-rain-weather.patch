@@ -557,4 +568,13 @@ void RAIN::Realize(uint32_t Delta_Time)
 
         rs->TextureSet(0, iRainbowTex);
+#ifdef STORM_METAL_RENDERER_CONSUMERS
+        if (rs->TechniqueExecuteStart("rainbow"))
