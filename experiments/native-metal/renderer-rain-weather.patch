diff --git a/src/libs/weather/src/lightning.cpp b/src/libs/weather/src/lightning.cpp
--- a/src/libs/weather/src/lightning.cpp
+++ b/src/libs/weather/src/lightning.cpp
@@ -3,1 +3,7 @@
+#ifdef STORM_METAL_RENDERER_CONSUMERS
+extern "C" void StormMetalDrawBillboards(void *device, const RS_RECT *rects, uint32_t count,
+                                           const char *technique, uint32_t atlasX, uint32_t atlasY,
+                                           float scaleX, float scaleY);
+#endif
+
 #include "core.h"
@@ -93,5 +99,14 @@ void LIGHTNING::Realize(uint32_t Delta_Time)
             pR->vPos = pL->vPos;
             pR->fSize = pL->fSize;
             pR->fAngle = 0.0f;
+#ifdef STORM_METAL_RENDERER_CONSUMERS
+            if (pRS->TechniqueExecuteStart(pL->sTechnique.c_str()))
+                do
+                {
+                    StormMetalDrawBillboards(pRS->GetD3DDevice(), pR, 1, pL->sTechnique.c_str(), dwSubTexX,
+                                             dwSubTexY, pL->fScaleX, pL->fScaleY * pRS->GetHeightDeformator());
+                } while (pRS->TechniqueExecuteNext());
+#else
             pRS->DrawRects(pR, 1, pL->sTechnique.c_str(), dwSubTexX, dwSubTexY, pL->fScaleX, pL->fScaleY);
+#endif
         }
@@ -110,5 +121,14 @@ void LIGHTNING::Realize(uint32_t Delta_Time)
             pR->vPos = pL->vPos;
             pR->fSize = pL->Flash.fSize;
             pR->fAngle = 0.0f;
+#ifdef STORM_METAL_RENDERER_CONSUMERS
+            if (pRS->TechniqueExecuteStart(pL->Flash.sTechnique.c_str()))
+                do
+                {
+                    StormMetalDrawBillboards(pRS->GetD3DDevice(), pR, 1, pL->Flash.sTechnique.c_str(), 1, 1,
+                                             1.0f, pRS->GetHeightDeformator());
+                } while (pRS->TechniqueExecuteNext());
+#else
             pRS->DrawRects(pR, 1, pL->Flash.sTechnique.c_str());
+#endif
         }
diff --git a/src/libs/weather/src/rain.cpp b/src/libs/weather/src/rain.cpp
