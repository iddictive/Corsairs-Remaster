+                           uint32_t subTexturesX = 1, uint32_t subTexturesY = 1,
+                           float scaleX = 1.0f, float scaleY = 1.0f)
+{
+    renderer->DrawRects(rects, count, technique, subTexturesX, subTexturesY, scaleX, scaleY);
+}
+#endif
