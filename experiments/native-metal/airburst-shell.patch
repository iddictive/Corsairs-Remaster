+bool AIBalls::TryAirburst(BALL_PARAMS &ball, const CVECTOR &src, const CVECTOR &dst)
+{
+    if (AirburstGood(ball) < 0)
+        return false;
+    float nearest = 2.0f;
+    const auto ships = core.GetEntityIds(SHIP_CANNON_TRACE);
+    for (const auto id : ships)
+    {
+        auto *ship = static_cast<SHIP_BASE *>(core.GetEntityPointer(id));
+        if (!ship || ship->isDead() || !ship->GetACharacter() || !ship->GetModel() ||
+            static_cast<int32_t>(ship->GetACharacter()->GetAttributeAsDword("index")) == ball.iBallOwner)
+            continue;
+        CVECTOR localSrc, localDst;
+        if (!ship->GetMatrix() || ship->GetBoxsize().x <= 0.0f || ship->GetBoxsize().z <= 0.0f) continue;
+        ship->GetMatrix()->MulToInv(src, localSrc);
+        ship->GetMatrix()->MulToInv(dst, localDst);
+        float entry = 0.0f;
+        if (AirburstEntry(localSrc, localDst, ship->GetBoxsize(), entry) &&
+            ~(src + (dst-src)*entry - ball.vFirstPos) >= 35.0f*35.0f)
+            nearest = std::min(nearest, entry);
+    }
+    if (nearest > 1.0f) return false;
+    const CVECTOR burst = src + (dst-src) * nearest;
+    // Land and masonry remain real blockers; never detonate through an island.
+    if ((pIsland && pIsland->Trace(src, burst) < 1.0f) ||
+        (AIFort::pAIFort && AIFort::pAIFort->Trace(src, burst) < 1.0f))
+        return false;
+    ball.vPos = burst;
+    if (ball.pParticle) ball.pParticle->SetEmitter(burst, !(src-dst));
+    AttributesPointer->SetAttributeUseDword("CurrentBallType", static_cast<uint32_t>(AirburstGood(ball)));
+    // A bounded downward fan uses the existing cloth collision/damage owner.
+    // Hull/crew blast remains one radial hit per ship, not one hit per fragment.
+    if (pSail)
+    {
+        for (int fragment = 0; fragment < 8; ++fragment)
+        {
+            const float angle = fragment * 2.399963f;
+            const float radius = 8.0f + fragment * 2.5f;
+            const CVECTOR end = burst + CVECTOR(cosf(angle)*radius, -45.0f, sinf(angle)*radius);
+            if (pIsland && pIsland->Trace(burst, end) < 1.0f) continue;
+            pSail->SetCannonTraceRadius(0.35f);
+            pSail->Cannon_Trace(ball.iBallOwner, burst, end);
+            pSail->SetCannonTraceRadius(0.0f);
+        }
+    }
+    core.Event("Ball_AirburstExplosion", "lfff", ball.iBallOwner, burst.x, burst.y, burst.z);
+    for (const auto id : ships)
+    {
+        // A preceding lethal hit may delete a ship: resolve every id again.
+        auto *ship = static_cast<SHIP_BASE *>(core.GetEntityPointer(id));
+        if (!ship || ship->isDead() || !ship->GetACharacter() || !ship->GetModel()) continue;
+        const int32_t target = ship->GetACharacter()->GetAttributeAsDword("index");
+        if (target == ball.iBallOwner) continue;
+        if (!ship->GetMatrix() || ship->GetBoxsize().x <= 0.0f || ship->GetBoxsize().z <= 0.0f) continue;
+        CVECTOR local;
+        ship->GetMatrix()->MulToInv(burst, local);
+        const auto box = ship->GetBoxsize();
+        const CVECTOR deckPoint(std::clamp(local.x, -box.x*.5f, box.x*.5f),
+                                std::clamp(box.y*.15f, 3.0f, 9.0f),
+                                std::clamp(local.z, -box.z*.5f, box.z*.5f));
+        const float power = std::max(0.0f, 1.0f - ~(local-deckPoint)/(32.0f*32.0f));
+        if (power <= 0.0f) continue;
+        const CVECTOR hit = *ship->GetMatrix() * deckPoint;
+        if ((pIsland && pIsland->Trace(burst, hit) < 1.0f) ||
+            (AIFort::pAIFort && AIFort::pAIFort->Trace(burst, hit) < 1.0f)) continue;
+        AttributesPointer->SetAttributeUseFloat("CurrentAirburstPower", power);
+        AttributesPointer->SetAttributeUseDword("CurrentAirburstDetonated", 1);
+        core.Event(SHIP_HULL_HIT, "illffflf", id, ball.iBallOwner, target,
+                   hit.x, hit.y, hit.z, -1, 1e8f);
+    }
+    AttributesPointer->SetAttributeUseFloat("CurrentAirburstPower", 1.0f);
+    return true;
+}
