+// Identity rides the existing saved event string: the four native ball lanes and
+// BALL_PARAMS codec remain byte-for-byte compatible with previous sea saves.
+int AirburstGood(const BALL_PARAMS &ball)
+{
+    constexpr char prefix[] = "@airburst:";
+    if (ball.sBallEvent.compare(0, sizeof(prefix) - 1, prefix) != 0)
+        return -1;
+    const auto number = ball.sBallEvent.substr(sizeof(prefix) - 1);
+    if (number.empty() || number.size() > 3)
+        return -1;
+    int good = 0;
+    for (const char digit : number)
+    {
+        if (digit < '0' || digit > '9') return -1;
+        good = good * 10 + digit - '0';
+    }
+    return good;
+}
+
+// Sweep a descending shell through the target's oriented overhead volume.
+// Slab entry, rather than endpoint proximity, also catches long frame steps.
+bool AirburstEntry(const CVECTOR &src, const CVECTOR &dst, const CVECTOR &box, float &entry)
+{
+    if (dst.y >= src.y) return false;
+    const float deck = std::clamp(box.y * 0.15f, 3.0f, 9.0f);
+    const float lo[] = {-box.x * 0.5f - 3.0f, deck + 4.0f, -box.z * 0.5f - 3.0f};
+    const float hi[] = { box.x * 0.5f + 3.0f, deck + 14.0f, box.z * 0.5f + 3.0f};
+    const float origin[] = {src.x, src.y, src.z};
+    const float delta[] = {dst.x-src.x, dst.y-src.y, dst.z-src.z};
+    float enter = 0.0f, leave = 1.0f;
+    for (int axis = 0; axis < 3; ++axis)
+    {
+        if (fabsf(delta[axis]) < 1e-6f)
+        {
+            if (origin[axis] < lo[axis] || origin[axis] > hi[axis]) return false;
+            continue;
+        }
+        float a = (lo[axis] - origin[axis]) / delta[axis];
+        float b = (hi[axis] - origin[axis]) / delta[axis];
+        if (a > b) std::swap(a, b);
+        enter = std::max(enter, a);
+        leave = std::min(leave, b);
+        if (enter > leave) return false;
+    }
+    entry = enter;
+    return true;
+}
+}
