+    {
+        // Compose gradients with the existing normal, then renormalize once.
+        // This also handles the ordinary flat-water distance cutoff.
+        normal->x -= sample.slopeX * normal->y;
+        normal->z -= sample.slopeZ * normal->y;
+        *normal = !(*normal);
+    }
 }
 
