+bool VerticalOverlap(float firstY, float firstHeight, float secondY, float secondHeight)
+{
+    return firstY <= secondY + secondHeight && secondY <= firstY + firstHeight;
+}
+
+bool SweptCircleHit(const CVECTOR &from, const CVECTOR &to, const CVECTOR &center, float radius, float &hit)
+{
+    const float moveX = to.x - from.x;
+    const float moveZ = to.z - from.z;
+    const float a = moveX * moveX + moveZ * moveZ;
+    if (a < 0.000001f)
+        return false;
+
+    const float offsetX = from.x - center.x;
+    const float offsetZ = from.z - center.z;
+    const float startDistanceSq = offsetX * offsetX + offsetZ * offsetZ;
+    const float c = startDistanceSq - radius * radius;
+    if (c <= 0.f)
+    {
+        // Only a non-negative initial radial velocity is a continuous escape.
+        // Comparing endpoints would permit crossing through the center and out.
+        if (offsetX * moveX + offsetZ * moveZ >= 0.f)
+            return false;
+        hit = 0.f;
+        return true;
+    }
+
+    const float b = 2.f * (offsetX * moveX + offsetZ * moveZ);
+    const float discriminant = b * b - 4.f * a * c;
+    if (discriminant < 0.f)
+        return false;
+    hit = (-b - sqrtf(discriminant)) / (2.f * a);
+    return hit >= 0.f && hit <= 1.f;
+}
 
