+void ShipMan::CommitPendingAction(uint32_t &dltTime, SailorsPoints &sailorsPoints, ShipState &shipState)
+{
+    if (!pendingNewAction)
+        return;
+    pendingNewAction = false;
+    if (!Dest(pos, ptTo, .001f))
+        return;
+    NewAction(sailorsPoints, shipState, dltTime);
+    SetAnimation(dltTime, shipState);
