+
+bool ShipWalk::IsCollisionMan(const ShipMan &man) const
+{
+    return !man.inWater && man.mode != MAN_OFF && man.mode != MAN_JUMP && man.mode != MAN_SWIM &&
+           man.mode != MAN_CLIMB_UP && man.mode != MAN_CLIMB_DOWN;
+}
+
+bool ShipWalk::IsClearOfDeckCharacter(const CVECTOR &position) const
+{
+    if (!deckCharacter_.active ||
+        !VerticalOverlap(position.y, CREW_HEIGHT, deckCharacter_.resolved.y,
+                         std::max(0.f, deckCharacter_.height)))
+        return true;
+    const float dx = position.x - deckCharacter_.resolved.x;
+    const float dz = position.z - deckCharacter_.resolved.z;
+    const float minDistance = CREW_RADIUS + std::max(0.f, deckCharacter_.radius);
+    return dx * dx + dz * dz + .000001f >= minDistance * minDistance;
+}
+
+bool ShipWalk::CanPlaceMan(const ShipMan &man, const CVECTOR &offset) const
+{
+    return CanPlaceAt(man.pos + man.spos, man.pos + offset);
+}
+
+bool ShipWalk::TrySteerAroundStatic(ShipMan &man, const CVECTOR &current, const CVECTOR &desired)
+{
+    const CVECTOR movement = desired - current;
+    const float lengthSq = SQR(movement.x) + SQR(movement.z);
+    if (lengthSq < .000001f)
+        return false;
+    constexpr float angles[] = {.436332313f, -.436332313f, .785398163f, -.785398163f,
+                                1.221730476f, -1.221730476f};
+    const int parity = man.newWayPoint & 1;
+    for (size_t index = 0; index < std::size(angles); ++index)
+    {
+        const float angle = angles[index ^ parity];
+        const float sine = sinf(angle), cosine = cosf(angle);
+        const CVECTOR steered(current.x + movement.x * cosine + movement.z * sine, desired.y,
+                              current.z + movement.z * cosine - movement.x * sine);
+        if (!IsClearOfDeckCharacter(steered) || !CanPlaceAt(current, steered))
+            continue;
+        man.pos = steered;
+        man.spos = 0.f;
+        man.RefreshWalkDirection();
+        return true;
+    }
+    return false;
+}
+
+bool ShipWalk::CanPlaceAt(const CVECTOR &current, const CVECTOR &candidate) const
+{
+    if (!ship || !shipModel)
+        return true;
+
+    auto &matrix = *ship->GetMatrix();
+    const CVECTOR bottom = matrix * (current + CVECTOR(0.f, 0.02f, 0.f));
+    const CVECTOR top = matrix * (current + CVECTOR(0.f, CREW_HEIGHT, 0.f));
+    const CVECTOR delta = matrix * candidate - matrix * current;
+    if (!deck_collision::canSweep(*shipModel, bottom, top, delta, CREW_RADIUS))
+        return false;
+
+    // Accept a correction only when a short vertical probe finds its intended
+    // support level, not a lower deck or hull surface.
+    const float supportTop = std::max(current.y, candidate.y) + .45f;
+    const float supportBottom = candidate.y - .65f;
+    const CVECTOR supportFrom(candidate.x, supportTop, candidate.z);
+    const CVECTOR supportTo(candidate.x, supportBottom, candidate.z);
+    const float floor = shipModel->Trace(matrix * supportFrom, matrix * supportTo);
+    if (floor > 1.f)
+        return false;
+    const float floorY = supportTop + (supportBottom - supportTop) * floor;
+    return fabsf(floorY - candidate.y) <= .18f;
+}
+
+bool ShipWalk::TryAcceptPosition(ShipMan &man, const CVECTOR &candidate)
+{
+    if (!IsClearOfDeckCharacter(candidate) || !CanPlaceAt(man.pos + man.spos, candidate))
+        return false;
+    man.pos = candidate;
+    man.spos = 0.f;
+    man.RefreshWalkDirection();
+    return true;
+}
+
+bool ShipWalk::TryMoveAside(ShipMan &man, const CVECTOR &delta)
+{
+    return TrySetAside(man, man.spos + delta);
+}
+
+bool ShipWalk::TrySetAside(ShipMan &man, CVECTOR candidate)
+{
+    const float lengthSq = candidate.x * candidate.x + candidate.z * candidate.z;
+    if (lengthSq > MAX_AVOID_OFFSET * MAX_AVOID_OFFSET)
+        return false;
+    if (!IsClearOfDeckCharacter(man.pos + candidate) || !CanPlaceMan(man, candidate))
+        return false;
+    man.spos = candidate;
+    return true;
+}
+
+bool ShipWalk::ResolveDeckCharacter(SeaDeckCharacterCollisionQuery &query)
+{
+    query.resolved = query.desired;
+    query.blocked = 0;
+    deckCharacter_.active = 0;
+    if (!query.active || bHide)
+        return true;
+
+    const CVECTOR movement = query.desired - query.from;
+    const float a = movement.x * movement.x + movement.z * movement.z;
+    float accepted = 1.f;
+    for (const auto &man : shipMan)
+    {
+        if (!IsCollisionMan(man))
+            continue;
+        const CVECTOR center = man.pos + man.spos;
+        const float queryLow = std::min(query.from.y, query.desired.y);
+        const float queryHigh = std::max(query.from.y, query.desired.y) + std::max(0.f, query.height);
+        if (center.y > queryHigh || center.y + CREW_HEIGHT < queryLow)
+            continue;
+
+        const float radius = std::max(0.f, query.radius) + CREW_RADIUS;
+        float hit;
+        if (SweptCircleHit(query.from, query.desired, center, radius, hit) && hit <= accepted)
+            accepted = a > 0.f ? std::max(0.f, hit - .01f / sqrtf(a)) : 0.f;
+    }
+
+    if (accepted < 1.f)
+    {
+        // Stop just before the first capsule, then preserve the remaining
+        // tangential component. Crowded decks must remain walkable along a
+        // sailor or cannon instead of turning every contact into a full stop.
+        const CVECTOR contact = query.from + movement * accepted;
+        CVECTOR slide = query.desired - contact;
+        float nearestDistance = 1e30f;
+        CVECTOR nearestCenter;
+        for (const auto &man : shipMan)
+        {
+            if (!IsCollisionMan(man))
+                continue;
+            const CVECTOR center = man.pos + man.spos;
+            if (!VerticalOverlap(contact.y, std::max(0.f, query.height), center.y, CREW_HEIGHT))
+                continue;
+            const float dx = contact.x - center.x, dz = contact.z - center.z;
+            const float distance = dx * dx + dz * dz;
+            if (distance < nearestDistance)
+            {
+                nearestDistance = distance;
+                nearestCenter = center;
+            }
+        }
+        const float nx = contact.x - nearestCenter.x, nz = contact.z - nearestCenter.z;
+        const float normalLengthSq = nx * nx + nz * nz;
+        if (normalLengthSq > .000001f)
+        {
+            const float inward = std::min(0.f, (slide.x * nx + slide.z * nz) / normalLengthSq);
+            slide.x -= nx * inward;
+            slide.z -= nz * inward;
+        }
+        float slideAccepted = 1.f;
+        const CVECTOR slideTarget = contact + slide;
+        const float slideLengthSq = slide.x * slide.x + slide.z * slide.z;
+        for (const auto &man : shipMan)
+        {
+            if (!IsCollisionMan(man))
+                continue;
+            const CVECTOR center = man.pos + man.spos;
+            if (!VerticalOverlap(contact.y, std::max(0.f, query.height), center.y, CREW_HEIGHT))
+                continue;
+            float hit;
+            const float radius = std::max(0.f, query.radius) + CREW_RADIUS;
+            if (SweptCircleHit(contact, slideTarget, center, radius, hit) && hit <= slideAccepted)
+                slideAccepted = slideLengthSq > 0.f
+                    ? std::max(0.f, hit - .01f / sqrtf(slideLengthSq)) : 0.f;
+        }
+        query.resolved = contact + slide * slideAccepted;
+        query.blocked = 1;
+    }
+    deckCharacter_ = query;
+    deckCharacter_.resolved = query.resolved;
+    deckCharacter_.active = 1;
+    return true;
 }
 
