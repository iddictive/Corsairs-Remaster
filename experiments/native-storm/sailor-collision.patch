+void ShipMan::RefreshWalkDirection()
+{
+    if ((mode != MAN_WALK && mode != MAN_RUN) || Dest(pos, ptTo, .001f))
+        return;
+    dir = !(ptTo - pos);
+    angTo.y = Vector2Angle(dir);
+}
+
+void ShipMan::ObserveRouteProgress(uint32_t dltTime, SailorsPoints &sailorsPoints, ShipState &shipState)
+{
+    if (mode != MAN_WALK && mode != MAN_RUN)
+    {
+        blockedRouteTime = 0;
+        return;
+    }
+    const CVECTOR accepted = pos + spos;
+    const float requestedSq = SQR(requestedVisualPos.x - previousVisualPos.x) +
+                              SQR(requestedVisualPos.z - previousVisualPos.z);
+    const float acceptedSq = SQR(accepted.x - previousVisualPos.x) +
+                             SQR(accepted.z - previousVisualPos.z);
+    if (requestedSq < .000001f || acceptedSq >= .000001f)
+    {
+        blockedRouteTime = 0;
+        return;
+    }
+    blockedRouteTime = std::min<uint32_t>(blockedRouteTime + dltTime, 2000u);
+    if (blockedRouteTime < 900u || sailorsPoints.points.count <= 1)
+        return;
+
+    // A visual capsule that made no accepted progress for almost a second is
+    // blocked, regardless of whether the blocker was hull geometry, crew, or
+    // the protagonist. Replan from the last authored node and exclude the
+    // failed first edge so animation cannot run forever against one obstacle.
+    blockedRouteTime = 0;
+    const int failedPoint = newWayPoint;
+    const int anchor = lastWayPoint >= 0 && lastWayPoint < sailorsPoints.points.count
+        ? lastWayPoint : newWayPoint;
+    Path replacement;
+    int replacementTarget = -1;
+    int replacementNext = -1;
+    for (int candidate = 0; candidate < sailorsPoints.points.count; ++candidate)
+    {
+        const auto &point = sailorsPoints.points.point[candidate];
+        if (candidate == targetWayPoint || point.disabled || point.buisy || point.pointType != PT_TYPE_NORMAL)
+            continue;
+        Path proposed;
+        proposed = sailorsPoints.findPath(proposed, anchor, candidate);
+        if (proposed.min == -1 || !proposed.length)
+            continue;
+        const int next = proposed.length > 1 ? proposed.point[1] : proposed.point[0];
+        if (next == failedPoint)
+            continue;
+        replacement = proposed;
+        replacementTarget = candidate;
+        replacementNext = next;
+        break;
+    }
+    if (replacementTarget < 0)
+        return;
+
+    if (moveTo != MOVE_TO_POINT && targetWayPoint >= 0 && targetWayPoint < sailorsPoints.points.count)
+        sailorsPoints.points.point[targetWayPoint].buisy = false;
+    moveTo = MOVE_TO_POINT;
+    targetWayPoint = replacementTarget;
+    path = replacement;
+    path.currentPointPosition = 0;
+    lastWayPoint = anchor;
+    newWayPoint = replacementNext;
+    ApplyTargetPoint(CVECTOR(sailorsPoints.points.point[newWayPoint].x,
+                             sailorsPoints.points.point[newWayPoint].y,
+                             sailorsPoints.points.point[newWayPoint].z), true);
+    pendingNewAction = false;
+    SetAnimation(dltTime, shipState);
+}
